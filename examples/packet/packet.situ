// project.md example 5.3: a sealed packet.
//
// The security position in one file. Three properties are load-bearing:
//
// 1. THE DOOM PRINCIPLE AS A STAGE GATE. The interior of a sealed region is
//    stage = VerifyGated, and the generated API provides no way to obtain a
//    view into it before the tag verifies. "Parse attacker-controlled plaintext
//    before authenticating it" is not discouraged here; it is unrepresentable.
//
// 2. IN-PLACE MUTATION AND AUTHENTICATION ARE IN CONFLICT. Touch one byte
//    covered by a tag and the tag is stale. Fields outside coverage stay freely
//    mutable, which is exactly why real protocols put routing headers and hop
//    counters outside coverage -- and situ makes that design pressure visible.
//
// 3. CTR-MODE SEEKABILITY BUYS INTERIOR ADDRESSING. Because the codec is
//    length-preserving, byte-granular and linearly seekable, the sealed
//    interior keeps fixed offsets and single-field in-place mutation. A
//    CBC-with-padding codec would not, and the capability map would say so.

target buffer;
endian big;

codec aes_gcm_128 {
	tag_bytes   = 16;         // NIST SP 800-38D
	nonce_bytes = 12;         // the 96-bit IV GCM is specified around
	granularity = byte;
	length_preserving;          // ciphertext core; tag declared separately
	seekable;                   // CTR-mode core
	authenticated;
	invertible;
	deterministic;
}

impl aes_gcm_128 extern "my_aes_gcm_128";

enum msg_type : u8 {
	hello = 0x01,
	data  = 0x02,
	close = 0x03,
}

struct header {
	u8       version  [must_eq = 1];
	msg_type  type;
	// Sizes the sealed payload. The `max` is what makes the whole packet
	// statically allocatable: without it the sealed region is Unbounded and no
	// caller can size a buffer for one.
	u16      length   [max = 1024];
	u32      seq;
}

struct packet {
	// Outside every covered region, and deliberately so: a hop counter is
	// rewritten at every forwarder, and putting it under the tag would mean
	// re-authenticating the packet at each one. The capability map is where
	// that design pressure becomes visible rather than folklore.
	//
	// The padding is the other half of the same decision. A one-byte field in
	// front of the header would push every multi-byte field off its natural
	// boundary, so the schema pays three bytes to keep them there -- and the
	// map is where that trade shows up, as `align` rather than as a comment.
	u8       hop;
	reserved u8[3];

	authenticated {
		header  hdr;
		u8      nonce[12];
	}

	sealed(aes_gcm_128, nonce = nonce) {
		u16  inner_kind;
		u32  inner_seq;

		// Encrypted on the wire and secret once it is not. `[secret]` buys
		// three things: no debug accessor is generated for it at all, a
		// zeroization function is, and it may not be used in any expression
		// that decides a length -- a secret-dependent extent would be visible
		// to anyone counting bytes (section 14.6).
		u8   session_key[16]  [secret];

		// Sized from the header rather than `[remaining]`, and it has to be:
		// `remaining` runs to the end of the frame, so it would swallow the
		// tag that follows. A region with something after it needs a length
		// that says where it stops.
		//
		// `hdr.length` is a plaintext field parsed before the region, so
		// reading it here is not a reference to transform output and does not
		// touch the decidability boundary of section 13.3.
		u8   body[hdr.length];
	}

	tag u8[16];                 // coverage inferred: all authenticated
	                            // and sealed regions in this struct
}

// Positional layout means exactly one encoding of a given value, which is what
// makes this format signable at all. Protobuf cannot do this for five
// independent reasons (project.md section 9.7).
require canonical(packet);

// No parse before verify.
require verify_gated(packet.sealed);

// CTR-mode seekability survives the seal: writing an interior field
// re-encrypts that byte range and moves nothing. Coverage still applies, so it
// is `in_place_dirty` rather than `in_place` -- which is the point. Every byte
// under the tag costs a recomputation, and the compiler will not let that be
// forgotten.
require in_place_dirty(packet.sealed.inner_seq);

// `hdr` is inside `authenticated { }`, so mutating `hdr.seq` is possible but
// invalidates the tag. `in_place` asks for both -- writable where it sits, and
// no tag left stale -- so it fails here, naming the two fixes: move the field
// out of coverage, or accept the recomputation.
//
// Stated as an `assert` so this file still builds while demonstrating the
// conflict as a warning (section 16). The `require` form and the exact text of
// its diagnostic are pinned in tests/unit/test_crypto.py.
assert in_place(packet.hdr.seq);

// The second fix, spelled out. This one passes: in-place mutation is possible,
// with the tag going dirty and finalize putting it right.
require in_place_dirty(packet.hdr.seq);

// The first fix, spelled out. `hop` sits outside every covered region, which is
// exactly why real protocols put mutable routing fields there.
require no_tag_invalidation(packet.hop);
require in_place(packet.hop);
