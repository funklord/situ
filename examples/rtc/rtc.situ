// A real-time clock's register image, and a sensor reading beside it.
//
// This is what fixed point and BCD are for, and the two live together here
// because real devices put them together. An RTC chip holds the wall clock as
// packed decimal, because the part was designed to drive a display and BCD is
// what a seven-segment decoder wants. The calibration beside it is fixed point,
// because the correction is fractional and the part has no floating-point unit
// to spare.
//
// Both types cost the same axis and for different reasons, which is the point
// worth reading the capability map for:
//
//   repr=ValueConverted on `seconds`  -- each nibble is a digit, so the value
//                                        is decoded rather than read
//   repr=ValueConverted on `trim_ppm` -- the stored integer is the value
//                                        scaled by 2^-8
//
// Neither generates floating point. The scale is a header constant and the
// caller does the arithmetic in whatever type it has, which on a part like
// this is usually a long.

target buffer;
endian big;
bit_order msb_first;

// The DS1307's register file, registers 0x00 to 0x06, as U-Boot's
// drivers/rtc/ds1307.c addresses them. Not an encoding that resembles it: this
// is the seven bytes the part hands back, control bits included.
//
// Those control bits are why `[bits]` exists (decision 0027). The seconds
// register spends its top bit on Clock Halt and the hours register two on
// 12/24 and AM/PM, leaving seven and six bits of packed decimal underneath --
// three bits of tens over four of units. Every driver masks them off before
// decoding, `bcd2bin(sec & 0x7F)` and `bcd2bin(hour & 0x3F)`, which is exactly
// the work a description is supposed to remove.
//
// `weekday` is carried because the part carries it: nothing derives it, and a
// schema that skipped it would put every register after it one byte early --
// which is what the earlier version of this file did (26.35).
struct wall_clock {
	u1    clock_halt;                    // CH: 1 stops the oscillator
	bcd2  seconds  [bits = 7, max = 59];

	reserved u1  [must_be_zero];
	bcd2  minutes  [bits = 7, max = 59];

	// 12/24 selects what the bit below it means, so this schema describes the
	// 24-hour form and says so: in 12-hour mode bit 5 is AM/PM rather than the
	// high bit of the tens digit, and `hours` would be 1..12 beside it. A
	// `variant` on `twelve_hour` is the honest shape and needs a discriminant
	// situ can read *before* the field it selects, which this is.
	reserved u1  [must_be_zero];
	u1    twelve_hour  [must_eq = 0];
	bcd2  hours    [bits = 6, max = 23];

	reserved u5  [must_be_zero];
	bcd1  weekday  [bits = 3, min = 1, max = 7];

	reserved u2  [must_be_zero];
	bcd2  day      [bits = 6, min = 1, max = 31];

	reserved u3  [must_be_zero];
	bcd2  month    [bits = 5, min = 1, max = 12];

	bcd2  year;                          // 00 to 99, which is the whole range
}

// Calibration and a reading. `q8_8` spends one bit on the sign, so the trim
// runs from -128 to just under +128 parts per million in steps of 1/256.
struct calibration {
	q8_8    trim_ppm;
	uq16_16 reference_hz;
}

struct rtc_frame {
	u8           version  [must_eq = 1];
	wall_clock   clock;
	calibration  cal;
	u16          checksum;
}

require size(wall_clock) == 7;
require size(calibration) == 6;
require size(rtc_frame) == 16;

// A bit-packed field is still writable in place: it shares a byte with the
// control bit above it, and a read-modify-write of that byte is one access.
require in_place(wall_clock.seconds);

// Not aligned, and that is the register rather than the schema: `seconds`
// starts one bit into byte 0, under Clock Halt. `aligned` is about where a
// field begins, so a field sharing a byte cannot claim it -- which is the
// cost of describing the part instead of the encoding, recorded rather than
// hidden.
assert aligned(wall_clock.seconds, 1);

// And so does fixed point: it is an integer in memory, and only the meaning of
// that integer differs.
require in_place(calibration.trim_ppm);
require absolute_static(rtc_frame.cal);

// Recorded rather than required: both types convert on every access, and that
// is the cost of describing the wire honestly rather than pretending the bytes
// are the numbers.
assert memory_identical(wall_clock.seconds);
assert memory_identical(calibration.trim_ppm);
