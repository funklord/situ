# Golden vectors for the BCD and fixed-point worked example.
#
# Registers 0x00 to 0x06 of a DS1307, encoded by U-Boot's `bin2bcd` -- a
# description that agrees only with its own compiler has demonstrated nothing:
#
#   static inline unsigned int bin2bcd(unsigned int val)
#   {
#           return (((val / 10) << 4) | (val % 10));
#   }
#
# and addressed by drivers/rtc/ds1307.c:
#
#   RTC_SEC_REG_ADDR 0x00   RTC_MIN_REG_ADDR  0x01   RTC_HR_REG_ADDR  0x02
#   RTC_DAY_REG_ADDR 0x03   RTC_DATE_REG_ADDR 0x04   RTC_MON_REG_ADDR 0x05
#   RTC_YR_REG_ADDR  0x06
#
# `RTC_DAY_REG_ADDR` is the *weekday*, which is the register an earlier version
# of this schema left out -- putting every register after it one byte early
# (26.35).
#
# The control bits are the point of these vectors as much as the digits are.
# The driver reads `bcd2bin(sec & 0x7F)` and `bcd2bin(hour & 0x3F)`, so the
# masks are what the schema has to reproduce: `seconds` is seven bits under
# Clock Halt, `hours` six under 12/24 and AM/PM (decision 0027). A vector with
# Clock Halt set reads the same time as one without, which is the whole claim.
#
# `rtc_frame` is this project's own composition rather than any part's, so it
# has no vector: a version byte, a clock, a calibration block and a checksum is
# a frame nobody transmits.

# 2025-08-02 12:34:56, a Saturday. Every control bit clear, which is what
# `bin2bcd` alone produces.
wall_clock running 56 34 12 06 02 08 25
	clock_halt  = 0
	seconds     = 56
	minutes     = 34
	twelve_hour = 0
	hours       = 12
	weekday     = 6
	day         = 2
	month       = 8
	year        = 25

# The same instant with the oscillator stopped: 0x56 | 0x80. The time reads
# identically, which is what separates a control bit from a digit -- and what
# a `bcd2` over the whole byte could not have said.
wall_clock halted D6 34 12 06 02 08 25
	clock_halt = 1
	seconds    = 56
	minutes    = 34
	hours      = 12

# Midnight on the first, where BCD is most likely to be read as hexadecimal:
# every field is zero or one, and `0x10` in the year is ten rather than
# sixteen.
wall_clock new_year 00 00 00 04 01 01 10
	seconds = 0
	minutes = 0
	hours   = 0
	weekday = 4
	day     = 1
	month   = 1
	year    = 10

# The last second of a leap day, and the one case where every digit pair is in
# the upper half of its range: 0x59 is fifty-nine, not eighty-nine.
wall_clock leap_second 59 59 23 05 29 02 24
	seconds = 59
	minutes = 59
	hours   = 23
	weekday = 5
	day     = 29
	month   = 2
	year    = 24
