// UDP header (RFC 768).
//
// Four fields, eight bytes, no bit packing. Included because it is the
// smallest schema that still has a length field pointing at a payload the
// schema does not describe, which is the commonest shape in real protocols.

target buffer;
endian big;

struct udp_header {
	u16  source_port;
	u16  destination_port;
	u16  length  [min = 8];
	u16  checksum;

	// The payload the length points at. UDP's own header does not describe
	// it -- the port does -- so it is bytes, and the length counts the eight
	// header bytes as well as the payload, which is why `[min = 8]` above is
	// what makes this expression legal rather than decoration.
	u8   payload[length - 8];
}

// `size(udp_header)` was `== 8` here until the payload was written, and a
// struct with a payload has no single size -- which the diagnostic now says
// rather than claiming the struct is not declared. What is still eight is
// where the payload starts, and that is the claim worth making: every field a
// receiver reads is at a constant offset, and the variable part is last.
require offset(udp_header.payload) == 8;
require absolute_static(udp_header);
require canonical(udp_header);
require aligned(udp_header.length, 2);

// Every field is freely mutable: nothing here is covered by a tag, and the
// checksum is a plain `u16` -- which is the one thing in this header situ
// cannot say, and it is not the reason `examples/icmp` gives.
//
// ICMP's checksum covers its own message and nothing else, so `[self_as = 0]`
// describes it exactly (14.2). UDP's covers a *pseudo-header* as well: the
// source and destination addresses, the protocol number and the UDP length,
// none of which are in this struct and two of which belong to the IP layer.
// The kernel builds it in `csum_tcpudp_nofold` (lib/checksum.c:149), which
// takes `saddr` and `daddr` as arguments precisely because they are not in
// the datagram it is summing.
//
// Coverage in situ is over regions of *this* message. There is no way to name
// bytes another schema owns, and inventing one would mean a schema that
// cannot be checked against the bytes in front of it. `examples/tcp` carries
// the same limitation for the same reason: two askers, and no design.
require in_place(udp_header.checksum);

// The payload makes nothing after it static -- and there is nothing after it,
// so UDP pays no price at all for being variable length. That is not an
// accident of the design: every field a receiver has to read to demultiplex
// the datagram sits ahead of the only member whose length the data decides.
