// Windows BMP file header (BITMAPFILEHEADER + BITMAPINFOHEADER).
//
// Here for two reasons the network protocols cannot show:
//
// 1. It is little endian, so on a little-endian host every field is
//    repr = MemoryIdentical and a caller may take a pointer to any of them.
//    Compare with ntp, where the same field types are ValueConverted.
//
// 2. It is the canonical example of a misaligned layout. The file header is
//    14 bytes, so `file_size` sits at offset 2 and every 32-bit field in the
//    info header sits at an odd multiple of 2. Unaligned access faults on some
//    targets and is slow on others, which is why situ tracks alignment on its
//    own axis rather than assuming it.

target buffer;
endian little;

struct bitmap_file_header {
	// "BM". A byte array rather than a u16, because it is a marker, not a
	// number, and giving it a numeric type would make its value depend on
	// endianness for no reason.
	u8        signature[2];
	u32       file_size;
	reserved  u16  [must_be_zero];
	reserved  u16  [must_be_zero];
	u32       pixel_offset;
}

enum compression : u32 {
	rgb              = 0,
	rle8             = 1,
	rle4             = 2,
	bitfields        = 3,
}

struct bitmap_info_header {
	u32          header_size  [must_eq = 40];
	i32          width;
	i32          height;
	u16          planes  [must_eq = 1];
	u16          bits_per_pixel;
	compression  compression;
	u32          image_size;
	i32          x_pixels_per_meter;
	i32          y_pixels_per_meter;
	u32          colours_used;
	u32          important_colours;
}

// The file, which is what makes the two headers above a format rather than
// two structs. `pixels` is `at file.pixel_offset` -- placed where the data
// says, measured from the start of the message rather than from a running sum
// of what precedes it (section 9.8). That is the one construct BMP needs and
// the network protocols in this directory do not: a header that points at its
// payload instead of preceding it.
//
// The arithmetic this makes checkable was in `tests/generated/test_bmp.c` and
// nowhere else: that the pixels begin where the two headers end, and that the
// declared file size is that plus the pixel bytes.
struct bitmap_file {
	bitmap_file_header  file;
	bitmap_info_header  info;
	u8  pixels[info.image_size] at file.pixel_offset;
}

require size(bitmap_file_header) == 14;
require size(bitmap_info_header) == 40;
require absolute_static(bitmap_file_header);
require absolute_static(bitmap_info_header);

// The signature is two plain bytes, so it is aligned and addressable.
require aligned(bitmap_file_header.signature, 1);

// `file_size` is at offset 2. Asserted rather than required, so the schema
// records the misalignment as a known property of the format instead of
// failing a build over something the format's authors decided in 1990.
assert aligned(bitmap_file_header.file_size, 4);

// A field that genuinely must be aligned would carry [require_aligned], which
// turns the misalignment into an error instead of a note.

// On a little-endian host these are the bytes, so pointer access is safe.
require in_place(bitmap_info_header.width);
require stable_address(bitmap_info_header.width);

// What a located member costs, and it is the whole of the offset axis:
// `pixels` is `DataPlaced`, which is weaker than `Dynamic` -- a dynamically
// placed member is at least *after* the things before it, and this one is
// wherever a four-byte field says. Its own accessor bounds-checks against the
// message on every call, because there is no frame it can be inside by
// construction.
assert absolute_static(bitmap_file.pixels);
