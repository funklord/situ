// ARP packet for IPv4 over Ethernet (RFC 826).
//
// ARP is generic over address sizes -- `hardware_length` and `protocol_length`
// declare how long the four address fields are -- but in practice it is only
// ever used with 6-byte MAC and 4-byte IPv4 addresses.
//
// This schema pins those two fields with [must_eq], which turns the generic
// format into a fully static one. That is the compact-versus-mutable tradeoff
// of project.md section 27.8 resolved in favour of static: an expression whose
// interval is a single point is a compile-time constant even though it
// textually references a field (section 10).

target buffer;
endian big;

enum hardware_type : u16 {
	ethernet = 1,
}

enum operation : u16 {
	request = 1,
	reply   = 2,
}

struct arp_packet {
	hardware_type  hardware_type    [must_eq = hardware_type.ethernet];
	u16           protocol_type    [must_eq = 0x0800];
	u8            hardware_length  [must_eq = 6];
	u8            protocol_length  [must_eq = 4];
	operation     operation;

	u8            sender_hardware[6];
	u8            sender_protocol[4];
	u8            target_hardware[6];
	u8            target_protocol[4];
}

require size(arp_packet) == 28;
require absolute_static(arp_packet);
require canonical(arp_packet);

// The addresses land at 8, 14, 18 and 24. Only two of the four are 4-byte
// aligned, which is a property of the wire format: the 6-byte hardware
// addresses push everything after them off alignment.
require aligned(arp_packet.sender_hardware, 2);
assert aligned(arp_packet.target_protocol, 4);

// And the same packet without the pins, which is the comparison this example
// exists for. Nothing here is different except that the two length fields are
// what RFC 826 says they are -- numbers the sender chooses -- and the four
// address fields are sized by them rather than by the schema.
//
// Read the two maps side by side. Every member of `arp_packet` is
// AbsoluteStatic and Fixed; in `arp_generic` the first address field is still
// static and everything after it is Dynamic, its size a range, and its mutate
// Shifting. That is the whole cost of a length the data decides, and it is
// four bytes of pinning that buys it.
struct arp_generic {
	hardware_type  hardware_type    [must_eq = hardware_type.ethernet];
	u16           protocol_type    [must_eq = 0x0800];
	u8            hardware_length  [min = 1, max = 8];
	u8            protocol_length  [min = 1, max = 16];
	operation     operation;

	u8            sender_hardware[hardware_length];
	u8            sender_protocol[protocol_length];
	u8            target_hardware[hardware_length];
	u8            target_protocol[protocol_length];
}

// The claim above, as requirements rather than as prose: the pinned packet
// keeps everything, and the generic one keeps only what precedes its first
// data-sized member.
require absolute_static(arp_generic.operation);
assert absolute_static(arp_generic.target_protocol);
assert in_place(arp_generic.target_protocol);
