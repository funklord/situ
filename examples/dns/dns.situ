// DNS message header (RFC 1035).
//
// Twelve bytes of header, in front of a body this file does not describe.
//
// It used to say situ "cannot describe [DNS names] statically at all", which
// was too strong and is now demonstrably so: `examples/dnsname` describes one
// completely -- every label, both forms of the first byte, the two
// terminators, and the pointer's value. What situ does not do is *follow* the
// pointer, which is a much smaller claim and a different one.
//
// A gap declared larger than it is sends a reader designing around a limit
// that is not there (invariant 12), and this one stood for as long as nobody
// tried. See `examples/dnsname` for what the boundary actually is.

target buffer;
endian big;
bit_order msb_first;

enum opcode : u4 {
	query  = 0,
	iquery = 1,
	status = 2,
	notify = 4,
	update = 5,
}

enum response_code : u4 {
	no_error        = 0,
	format_error    = 1,
	server_failure  = 2,
	name_error      = 3,
	not_implemented = 4,
	refused         = 5,
}

struct dns_header {
	u16           id;

	// One byte: response flag, opcode, three one-bit flags.
	bit           is_response;
	opcode        opcode;
	bit           authoritative;
	bit           truncated;
	bit           recursion_desired;

	// One byte: the recursion flag, three unused bits, the response code.
	bit           recursion_available;
	reserved      u3    [must_be_zero];
	response_code  response_code;

	u16           question_count;
	u16           answer_count;
	u16           authority_count;
	u16           additional_count;
}

require size(dns_header) == 12;
require absolute_static(dns_header);

// Both packed bytes are exactly eight bits wide, so nothing straddles and no
// [allow_straddle] is needed. The 4-bit enums sit inside one byte each.
require in_place(dns_header.response_code);
require in_place(dns_header.answer_count);

// The reserved bits are rejected on parse rather than preserved. Section 14.5
// is deliberate about this: every ignored bit is a malleability surface, and
// DNS responses are a well-known covert channel.
require canonical(dns_header);

// OUT OF SCOPE HERE, and described next door. A DNS name is a chain of
// length-prefixed labels which may terminate in a two-byte pointer to an
// earlier offset in the same message. `examples/dnsname` writes that chain out
// and walks it: the labels are a run ending at the root, and the pointer is a
// variant arm. What it does not do is *follow* the pointer, because resolving
// one means following a pointer graph and section 2 rules out object graphs
// and cyclic references at any phase. The boundary is the view model rather
// than a gap, which is the sentence that example exists to earn.
