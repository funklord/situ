// TCP header (RFC 793 and RFC 3168), fixed portion.
//
// The instructive contrast with ipv4: TCP packs just as many flags into bits,
// but every group lands on a byte boundary, so this schema needs no
// [allow_straddle] and every flag write is a single-byte read-modify-write
// rather than a two-byte one.
//
// That is a real property of the wire format, not of the schema. Reading the
// two examples side by side is the point.

target buffer;
endian big;
bit_order msb_first;

struct tcp_header {
	u16       source_port;
	u16       destination_port;
	u32       sequence;
	u32       acknowledgement;

	// One byte: header length in 32-bit words, then four unused bits.
	u4        data_offset  [min = 5];
	reserved  u4           [must_be_zero];

	// One byte, one bit per flag.
	bit       cwr;
	bit       ece;
	bit       urgent;
	bit       ack;
	bit       push;
	bit       reset;
	bit       syn;
	bit       fin;

	u16       window        @ 0x0E;
	u16       checksum;
	u16       urgent_pointer;

	// `data_offset` counts 32-bit words including the twenty fixed bytes, so
	// the options are `(data_offset - 5) * 4` bytes -- the same shape as an
	// IPv6 extension header's, and the reason `[min = 5]` above is what makes
	// the subtraction legal rather than a note about sensible values.
	u8        options[(data_offset - 5) * 4];
}

require offset(tcp_header.options) == 20;
require absolute_static(tcp_header);
require in_place(tcp_header.syn);
require aligned(tcp_header.sequence, 4);

// THE CHECKSUM, and why it is a plain `u16` where ICMP's is not.
//
// TCP's covers the segment *and* a pseudo-header: the source and destination
// addresses, the protocol number and the segment length, none of which are in
// this struct and two of which belong to the IP layer. The kernel builds that
// in `csum_tcpudp_nofold` (lib/checksum.c:149), which takes `saddr` and
// `daddr` as arguments precisely because they are not in the segment.
//
// Half of that is expressible now and half is not, and the half that is not
// is a different gap from the one `prefix(...)` closed.
//
// `prefix(...)` (14.2a) says the pseudo-header, and `examples/udp` uses it:
// the layout is a struct of its own, the caller fills it in, and the
// generated header says how many bytes. `[self_as = 0]` says the checksum's
// own bytes, and `examples/icmp` uses that.
//
// What TCP still cannot say is where its coverage *ends*. The sum runs over
// the header, the options and the payload -- and the payload is not in this
// struct, because its length is not in this header. UDP has a `length` field
// and so describes its own payload; TCP's segment length comes from the IP
// layer, so a `tcp_header` genuinely does not know how far the checksum
// reaches. Naming a prefix would describe the start correctly and leave the
// end wrong, which is worse than describing neither, so this schema still
// declares a plain `u16` and says why.
//
// The remaining shape, stated for whoever designs it: coverage that runs to
// an extent a *different* layer knows. That is not the pseudo-header problem
// wearing another hat -- a prefix is bytes the caller can hand over whole,
// and this is a length the caller would have to be asked for.

// A bit field is never atomic: setting one flag is a read-modify-write of the
// containing byte, so two threads setting different flags can lose one of
// them. Stated here so the schema records it.
assert atomic(tcp_header.syn);

// Where TCP stops being randomly addressable, and it is the options that do
// it rather than the bit packing above them. Each option is a kind, a length
// and a value, so their interior is a `tlv` region -- described here as bytes
// because the one thing a `tlv` needs is a rule for the tags it does not know,
// and TCP's is "skip it by its length", which two of the four defined options
// (End of Option List and No-Operation) do not follow: they are one byte with
// no length at all. A region whose skip rule has two exceptions is a region
// situ would describe by lying about it.
assert absolute_static(tcp_header.options);
