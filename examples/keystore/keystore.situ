// A small private record, which is the shape most applications actually have.
//
// WHY THIS ONE EXISTS. Every other directory here is a public format somebody
// else specified -- ARP, DNS, SQLite, MQTT, protobuf -- or an exercise named
// for the capability it demonstrates. Three projects evaluated situ and
// independently said the same thing: none of those is the shape *they* have,
// which is a layout the program invented for itself, of the order of five
// fields, with a version byte and an encrypted tail. Reading only public
// formats, a project with a 33-byte header does not recognise itself and
// never runs the trial.
//
// So this is that shape, written at the floor rather than above it.
//
// HONEST ABOUT THE FLOOR. Hand-written, this format is about twenty-five
// lines of `memcpy` and `offset += N` in one file, and it works. A project
// with exactly this and nothing else should probably write those lines. What
// changes the answer is in section 26.66 and in the notes below: a second
// implementation reading the same bytes, or the first version bump. Both are
// visible in this file -- and neither is visible in twenty-five lines of
// offset arithmetic until it is too late to choose.
//
// NOT ANY PROJECT'S FORMAT. The shape is common enough that three evaluations
// described it in nearly the same words; the field names here are this file's
// own, so that nothing depends on somebody else's revision history.

target buffer;
endian little;                   // an application's own record, on a host

// The AEAD is the caller's. situ decides layout, coverage and the verify
// gate; the library the application already audited does the arithmetic.
// That composition is what makes situ adoptable by a project that has
// already chosen its crypto (section 14.1).
codec aes_gcm_256 {
	granularity = byte;
	length_preserving;           // the tag is declared separately, below
	seekable;
	authenticated;
	invertible;
	deterministic;
}

impl aes_gcm_256 extern "app_aead_open";

// The revision, and the reason the whole file is worth writing down. A
// planned move from PBKDF2 to Argon2id is meant to be a version bump rather
// than a rewrite, so the parameters that follow are a different shape in each
// revision. Written as an enum with `default = error` because a record from a
// future version is not a record this build can open, and guessing is worse
// than refusing.
enum revision : u8 {
	pbkdf2_sha256 = 1,
	argon2id      = 2,
	default       = error,
}

// 4.2 iterations, and nothing else to say.
struct pbkdf2_params {
	u32  iterations  [min = 1];
}

// Argon2id takes three, which is exactly why this is a `variant` and not two
// fields with one ignored. The bytes are a different length in each revision,
// so a reader that assumed one layout would read the nonce as a parameter.
struct argon2_params {
	u32  memory_kib  [min = 8];
	u32  passes      [min = 1];
	u8   lanes       [min = 1];
}

struct keystore {
	// Written as bytes rather than as a number in the file's own byte order:
	// a magic is read the same way on every machine, which is what `[endian =
	// big]` says here. "KSTR".
	u32  magic  [endian = big, must_eq = 0x4b535452];

	revision  version;

	// Salt and nonce are outside the sealed region and inside no tag
	// coverage, because both are inputs to opening it. A field the reader
	// needs *before* it can verify cannot be under the verification.
	u8   salt[16];
	u8   nonce[12]  [nonce];

	// The parameters the revision decides. `default: error` above means a
	// version this build does not know refuses here rather than reading the
	// next twelve bytes as an iteration count.
	variant params switch (version) {
		case revision.pbkdf2_sha256:  pbkdf2_params  pbkdf2;
		case revision.argon2id:       argon2_params  argon2;
		default: error;
	}

	// How many bytes of plaintext are inside, which the sealed region needs
	// because something follows it: `[remaining]` would swallow the tag.
	//
	// It counts the plaintext and not the key beside it. Writing it the other
	// way -- one length over both, and `plaintext[length - 32]` -- is what
	// this file said first, and the compiler refused it: `length` admits
	// zero, so the subtraction admits -32. A hand-written reader makes that
	// subtraction without being asked whether the field can be small.
	u16  length  [max = 4064];

	// The half that a hand-written reader leaves undescribed. Everything in
	// here is `stage = VerifyGated`: the generated API offers no way to reach
	// it before the tag verifies, in any of the four languages.
	sealed(aes_gcm_256, nonce = nonce) {
		// A record's own body. Where an application keeps JSON or CBOR in
		// here -- which is common, and is what makes the layout uninteresting
		// -- the honest spelling is one `u8 plaintext[length]` and no more;
		// situ describes where the bytes are, not what a serialiser meant.
		u8   secret_key[32]  [secret];
		u8   plaintext[length];
	}

	tag u8[16];                  // coverage inferred: everything authenticated
}

// What the format costs, stated rather than assumed. The first four fields
// are at constant offsets in every revision; everything after the variant
// moves, because the parameter block is a different size in each. That is the
// price of the version bump and it is worth naming: a reader of the v1 layout
// finds `length` three bytes earlier than a reader of v2.
assert absolute_static(keystore.magic);
assert absolute_static(keystore.version);
assert absolute_static(keystore.salt);
assert absolute_static(keystore.nonce);

require size(pbkdf2_params) == 4;
require size(argon2_params) == 9;
