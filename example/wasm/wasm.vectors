# Golden vectors for the WebAssembly worked example.
#
# `object` is what Debian clang 19.1.7 writes for
#     int g = -3000; long long h(int x) { return x * -3000LL; }
# under `clang --target=wasm32 -O1 -c`. llvm-objdump -d reads its body as
#     local.get 0; i64.extend_i32_s; i64.const -3000; i64.mul; end

