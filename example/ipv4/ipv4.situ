// IPv4 header (RFC 791), fixed portion.
//
// The bit-packing example. Two things here are worth the reader's attention:
//
// 1. `fragment_offset` is 13 bits and therefore cannot fit inside one byte at
//    any starting position, so the struct must declare [allow_straddle].
//    Straddling forces a multi-byte read-modify-write, which is why situ makes
//    the author say so rather than discovering it in generated code.
//
// 2. Options are what make the real header variable length, and `ihl` is what
//    drives them. What they cost is nothing at all above them and everything
//    below them -- of which there is nothing, which is a fact about where IPv4
//    put its variable part rather than about situ.

target buffer;
endian big;
bit_order msb_first;

enum protocol : u8 {
	icmp = 1,
	igmp = 2,
	tcp  = 6,
	udp  = 17,
	gre  = 47,
	esp  = 50,
	ah   = 51,
}

struct ipv4_address {
	u8  octets[4];
}

struct ipv4_header [allow_straddle] {
	authenticated header {
		u4        version  [must_eq = 4];
		u4        ihl      [min = 5];
		u6        dscp;
		u2        ecn;
		u16       total_length;
		u16       identification;

		// The flags byte and the fragment offset share two bytes: 1 + 1 + 1 + 13.
		reserved  bit      [must_be_zero];
		bit       dont_fragment;
		bit       more_fragments;
		u13       fragment_offset;

		u8        time_to_live;
		protocol  protocol;

		// RFC 791, and RFC 1071 for how it is computed: the one's-complement sum
		// of the header *including these two bytes*, taken as zero while it runs.
		// `[self_as = 0]` is that sentence, and it is what lets a checksum sit
		// inside the region it covers.
		//
		// The coverage runs to the end of the options, which is a length the data
		// decides -- so this is a tag over a variable span, which is the reason
		// the note that used to sit at the bottom of this file said a checksum
		// belongs in the tag machinery rather than in a plain field.
		checksum u8 header_checksum[2] covers(header) [self_as = 0];

		ipv4_address  source       @ 0x0C;
		ipv4_address  destination  @ 0x10;

		// `ihl` counts 32-bit words including the twenty fixed bytes, so the
		// options are `(ihl - 5) * 4` bytes and `[min = 5]` above is what makes
		// that subtraction legal. Every field before them keeps AbsoluteStatic;
		// nothing after them would, and there is nothing after them, which is the
		// same shape UDP has and for the same reason.
		u8        options[(ihl - 5) * 4];
	}
}

require offset(ipv4_header.options) == 20;
require absolute_static(ipv4_header);

// The addresses are byte arrays at byte-aligned offsets, so they keep the
// strongest representation despite the bit packing above them.
require aligned(ipv4_header.source, 4);

// `fragment_offset` straddles, so writing it is a read-modify-write of two
// bytes and it can never be atomic. Asserted rather than required so the
// schema documents the cost without failing the build.
assert atomic(ipv4_header.fragment_offset);

// THE CHECKSUM, and what covering a variable span costs.
//
// Every field above is inside the coverage, so writing any of them marks the
// checksum stale -- which is what a router doing its job does to
// `time_to_live` on every hop. `assert` rather than `require`, so the schema
// records the cost without failing its own build:
assert in_place(ipv4_header.header_checksum);
assert no_tag_invalidation(ipv4_header.time_to_live);

// The generated support is the two things only the compiler knows: the span
// the sum runs over -- which reaches to the end of the options and so is a
// length the data decides -- and where inside it the checksum's own bytes are.
// The algorithm stays the caller's (13.1).
require in_place_dirty(ipv4_header.time_to_live);
