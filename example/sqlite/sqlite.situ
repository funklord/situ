// A SQLite b-tree leaf page: the offset table, and where the language stops.
//
// This is the worked example for `indexed` (project.md section 9.3), and it
// arrived late for a reason worth recording. Every other construct in this
// directory is demonstrated by a real format; `indexed` had none for a long
// time, because bare offset tables are rare in the wild. The common shape is a
// table of *records* -- an offset and a length side by side -- and that is an
// array of structs, not this construct.
//
// SQLite's cell pointer array is the real thing: `cell_count` two-byte offsets,
// measured from the start of the page, pointing at cells that fill the page
// from the back. The pointers are in key order and the cells are not, which is
// exactly what an offset table is for and what an array could not express.
//
// The vectors in vectors.txt come from sqlite3 itself, never from situ.

target buffer;
endian big;                     // SQLite is big-endian throughout

// A SQLite varint: base-128, high group first, one to nine bytes. The ninth is
// what makes it its own encoding rather than leb128 read backwards -- eight
// bits and no continuation flag, because with `max_bytes = 9` there is no
// spare bit left for one. Sixty-four bits in nine bytes where seven-bit groups
// would need ten.
//
// Not `minimal`: SQLite's format does not require the shortest encoding, and
// declaring it here would be a claim about the wire that sqlite3 does not make.
varint_type sqlite_varint {
	encoding  = be128;
	max_bits  = 64;
	max_bytes = 9;
}

// The first hundred bytes of page 1, which every SQLite database begins with
// (fileformat.html section 1.3). It is here for the sixteen-byte magic: the
// header string is the longest pinned byte run in this directory, and until
// `[must_eq]` took a literal there was no way to say it that generated a
// check rather than a comment (0052).
//
// The rest earns its place by being unusually strict for a header: three
// fractions the format fixes outright, a twenty-byte reserved run, and two
// small vocabularies. Every value below was read out of a database sqlite3
// wrote, not recalled.
enum sqlite_format_version : u8 {
	legacy      = 1,        // rollback journal
	wal         = 2,        // write-ahead log
}

enum sqlite_text_encoding : u32 {
	utf8        = 1,
	utf16le     = 2,
	utf16be     = 3,
}

struct sqlite_file_header {
	// "SQLite format 3\x00" -- sixteen bytes including the terminator, which
	// is part of the string the format specifies rather than a convention of
	// C's. One span comparison; the alternative was sixteen fields.
	u8  magic[16]  [must_eq = "SQLite format 3\x00"];

	// A power of two from 512 to 32768, or 1 meaning 65536 -- so the bound
	// is what the language can state and the rest is the format's own rule.
	// `[max]` is not 32768 because of that 1.
	u16 page_size;

	sqlite_format_version  write_version;
	sqlite_format_version  read_version;

	// Unused bytes at the end of every page. Usually zero, and not pinned:
	// an extension may reserve some.
	u8  reserved_per_page;

	// Three fractions the format fixes outright -- "Must be 64", "Must be
	// 32", "Must be 32" -- so they are constraints rather than fields a
	// reader interprets.
	u8  max_embedded_payload_fraction  [must_eq = 64];
	u8  min_embedded_payload_fraction  [must_eq = 32];
	u8  leaf_payload_fraction          [must_eq = 32];

	u32 change_counter;
	u32 size_in_pages;              // the "in-header database size"
	u32 first_freelist_trunk;
	u32 freelist_page_count;
	u32 schema_cookie;
	u32 schema_format   [min = 1, max = 4];
	u32 default_page_cache_size;
	u32 largest_root_btree_page;    // auto-vacuum modes, else zero

	sqlite_text_encoding  text_encoding;

	u32 user_version;               // PRAGMA user_version
	u32 incremental_vacuum;
	u32 application_id;             // PRAGMA application_id

	// "Reserved for expansion. Must be zero." Twenty bytes, and the one
	// place in this directory where a reserved run is that long -- which is
	// what makes it worth having: `must_be_zero` over a run is a loop, and
	// a run this size is where a backend that got the loop wrong would show
	// it.
	reserved  u8[20]  [must_be_zero];

	u32 version_valid_for;
	u32 sqlite_version_number;
}

require size(sqlite_file_header) == 100;
require absolute_static(sqlite_file_header);
require memory_identical(sqlite_file_header.magic);

// A message here is one page. SQLite reads pages, and the cell offsets are
// measured from the start of one -- so a page is the frame that bounds them.
//
// This is a leaf table page (type 13). The interior types carry a twelfth
// header byte for the rightmost child pointer, which is a `variant` on the
// type byte and not what this example is about.
struct btree_leaf_page {
	u8   page_type       [must_eq = 13];
	u16  first_freeblock;
	u16  cell_count;
	u16  content_start;             // where the cells begin, growing backwards
	u8   fragmented_free;

	// The cell pointer array. `base = page_type` is the honest spelling of
	// "measured from the start of the page": `page_type` is the page's first
	// byte, so its start is the page's start. Section 9.3 wrote this form as
	// `base = table_start` before there was a parser for it.
	//
	// Not `base = region`: the region begins after this eight-byte header, and
	// the offsets do not. Not `base = message` either -- that would say the
	// offsets are bounded by nothing this frame knows, and they are bounded by
	// the page (decision 0024).
	indexed(offset_type = u16, count = cell_count, base = page_type) {
		table_leaf_cell cells[];
	}
}

// One cell of a leaf table page. The payload is the record itself, which has
// its own header of serial types -- a format inside this one, and not what
// this example is about.
//
// Overflow is the honest omission: a payload larger than the page allows is
// truncated here and continued on an overflow page, with a four-byte page
// number after the local part. That is a second frame reached by a pointer,
// and the schema says nothing about it -- so a cell whose payload overflows is
// described here as shorter than it is.
struct table_leaf_cell {
	sqlite_varint  payload_size;
	sqlite_varint  rowid;
	u8             payload[payload_size];
}

// What holds, and is the useful half: the table is where it says it is, the
// count is one read, and reaching cell N is one more read and an addition
// however the cells are arranged.
require absolute_static(btree_leaf_page.cell_count);
require random_access(btree_leaf_page.cells);

// Asserted rather than required, and the report is the point: `FrameStable`,
// not `Stable`. An element is reached through the table, so its address holds
// exactly as long as the table does -- and it is the *frame* that bounds it,
// which is what `base` naming a member of this struct buys over naming the
// message. Pointing at the message would report `Unstable` instead.
assert stable_address(btree_leaf_page.cells);

// ---------------------------------------------------------------------------
// What this example asked for and got, and the bill that said otherwise.
//
// This section used to say the cell was inexpressible -- "situ cannot
// describe it today, for two independent reasons" -- and every sentence of
// it was false by the time anybody read it back. The two reasons were that
// `varint_type` had one encoding and that nothing could be sized by a
// varint; the third claim was that `cells_at` is therefore not emitted and
// that "no backend can read one".
//
// Measured 2026-10-22, against this file and the artifacts beside it:
//
//   - `sqlite_varint` above declares `encoding = be128` with
//     `max_bytes = 9`, and the ninth byte's eight bits fall out of the
//     arithmetic rather than needing a second flag -- `ast.VarintDecl`
//     names SQLite's ninth byte as the worked case.
//   - `struct table_leaf_cell` is twenty-odd lines above this, with
//     `u8 payload[payload_size]` sized by a varint, and the committed
//     `.situ.map` places all three of its members.
//   - `btree_leaf_page.cells` is `table_leaf_cell cells[]`, not
//     `u8 cells[]`.
//   - All four backends read a varint: C emits `_get`, `_value` and
//     `_len`, and the other three their own spellings.
//   - `cells_at` IS emitted.
//
// So the example got what it asked for, in pieces, and the bill was never
// re-derived. That is the hazard worth leaving a note about rather than
// deleting: **a schema's bill is a dated claim about the compiler, and
// nothing in the ordinary course of work brings a reader back to it.**
// `example/json` carried the same shape -- a sentence naming the attribute
// that would fix it while calling itself a gap (26.299) -- and a consumer
// quoted this project's stale sentence back to it as the reason for not
// adopting (26.670, 26.671).
//
// What is still honestly missing is above and not here: overflow pages,
// where a payload larger than the page carries a four-byte page number
// after the local part and continues elsewhere. That is a second frame
// reached by a pointer, and this schema says nothing about it.
