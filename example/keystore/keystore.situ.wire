# situ wire signature v0
# schema: keystore.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.

endian little
target buffer

enum revision : u8 unknown=error
  pbkdf2_sha256=1 argon2id=2

struct argon2_params size=9
  @0x0000   4         u32        memory_kib  little min=8
  @0x0004   4         u32        passes  little min=1
  @0x0008   1         u8         lanes  min=1

struct keystore size=87..4156
  @0x0000   4         u32        magic  big must_eq=0x4b535452
  @0x0004   1         revision   version
  @0x0005   16        u8         salt  little
  @0x0015   12        u8         nonce  little
  @0x0021   4..9      variant    params
  ~         2         u16        length  little max=4064
  ~         32..4096  aes_gcm_256 sealed  codec=aes_gcm_256 nonce=nonce
  ~         16        u8         tag
  tag covers: sealed plaintext secret_key

struct pbkdf2_params size=4
  @0x0000   4         u32        iterations  little min=1
