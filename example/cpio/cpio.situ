// cpio, the `newc` format an initramfs is made of.
//
// Every number in this header is written in ASCII hexadecimal, eight digits
// wide, zero-padded. That is the whole reason this example exists: `hex` is a
// radix the language has offered since 8.6.2 and no schema had ever used, so
// the one path through the text-number machinery that nothing exercised was
// the one a real format actually uses.
//
// SOURCE. The layout and every rule here are from the kernel's own reader, in
// the tree on this machine:
//
//   init/initramfs.c:281   "070701" and "070702", and what the second means
//   init/initramfs.c:198   thirteen fields of eight, `simple_strntoul(s, 16)`
//   init/initramfs.c:73    N_ALIGN: (((len) + 1) & ~3) + 2
//   init/initramfs.c:293   next_header = this_header + N_ALIGN(name_len)
//                          + body_len, rounded up to four
//   init/initramfs.c:374   the archive ends at a name of "TRAILER!!!"
//   init/initramfs.c:296   a name length of zero or over PATH_MAX is refused
//
// The vectors beside this file are an archive GNU cpio wrote, not one laid out
// here: `printf 'greeting.txt\n' | cpio -o -H newc`.

target buffer;
endian big;                  // no multi-byte binary fields at all; see below

// The header is 110 bytes: six of magic and thirteen numbers of eight digits.
// It is `endian big` above and the directive does nothing, which is worth
// saying rather than leaving a reader to wonder: every number here is text, so
// byte order has nothing to decide. `repr = TextConverted` in the map is that
// fact, per field.
const HEADER_BYTES = 110;

// The magic, and the one thing in this header that is not a number.
//
// A reader compares it as six bytes -- `memcmp(collected, "070701", 6)` -- so
// a byte-run enum is what the format actually has (0052). It used to be a
// `decimal u32 magic[6] [min = 70701, max = 70702]`, with a comment saying
// there is no enum of text numbers, and the pair of bounds was standing in
// for a set of two spellings because that was the only construct available.
// The map records what changed: `repr` was TextConverted and is
// MemoryIdentical, which is the difference between parsing six digits and
// comparing six bytes, and the generated check now reads
// `[must_eq = "070701" | "070702"]` rather than a decimal range a reader
// cannot match against a format reference.
//
// No `default`, because a reader refuses a spelling it does not know rather
// than passing it. The two arms are measured rather than recalled, against
// the tool that wrote the vectors beside this file: GNU cpio 2.15 writes
// "070701" for `-H newc` and "070702" for `-H crc`. A boot-time reader may
// take a subset of that -- the kernel's initramfs accepts only the first --
// and the subset is the reader's rather than the format's.
enum format : u8[6] {
	newc     = "070701",
	newc_crc = "070702",
}

struct cpio_header {
	format  magic;

	hex u32  ino[8];
	hex u32  mode[8];
	hex u32  uid[8];
	hex u32  gid[8];
	hex u32  nlink[8];
	hex u32  mtime[8];         // "breaks in y2106", says the kernel
	hex u32  filesize[8];
	hex u32  devmajor[8];
	hex u32  devminor[8];
	hex u32  rdevmajor[8];
	hex u32  rdevminor[8];

	// The length of the name, *including* its terminating NUL. The kernel
	// refuses zero and anything over PATH_MAX (initramfs.c:296); 4096 is that
	// bound, and stating it here is what keeps the name's length a range a
	// caller can size a buffer for rather than four billion.
	hex u32  namesize[8]  [min = 1, max = 4096];

	// Zero for `newc` and a checksum of the file data for `newc_crc`. Not
	// modelled as a `checksum`: it covers the *data*, which is not in this
	// struct, and coverage in situ is over regions of the message the tag is
	// in. `example/tcp` carries the same limitation for the same reason.
	//
	// 0053 does not change that, and it fails a second time for a reason of
	// its own: the algorithm is not one situ can generate. Despite the name,
	// `newc_crc` is no CRC -- it is the unsigned sum of the file's bytes,
	// truncated to 32 bits, so none of the thirteen CRC kernels in
	// `std/kernels.situ` computes it and neither does `internet_checksum`,
	// which is a one's-complement sum of 16-bit words. Measured rather than
	// read off the name: `-H crc` over the six bytes "hello\n" writes
	// 0000021E, and 0x21E is 542, which is 104+101+108+108+111+10.
	hex u32  check[8];
}

require size(cpio_header) == 110;
require absolute_static(cpio_header);

// One entry: the header, the name, and the file data, each padded so the next
// thing starts on a four-byte boundary.
struct cpio_entry {
	cpio_header  header;

	// `namesize` counts the NUL, so this is the whole name field. It is
	// `[nul_terminated]` because the format says so and because a reader who
	// takes these bytes as a string needs to know the terminator is inside
	// the count rather than after it.
	u8  name[header.namesize]  [nul_terminated];

	// initramfs.c:73. `N_ALIGN(len)` is `(((len) + 1) & ~3) + 2`, which is
	// the distance from the start of a 110-byte header to the file data --
	// so the padding after the name is what rounds `110 + namesize` up to a
	// multiple of four. Written that way rather than as the kernel's bit
	// arithmetic, because the schema should say what the padding *is*.
	reserved u8 [align_up(HEADER_BYTES + header.namesize, 4)
	             - (HEADER_BYTES + header.namesize)];

	u8  data[header.filesize];

	// And the same rounding after the data (initramfs.c:294).
	reserved u8 [align_up(header.filesize, 4) - header.filesize];
}

// What the padding costs, and it is the whole of what a cpio reader pays: the
// data is at an offset the *name length* decides, so nothing after the header
// is at a constant offset and an archive is walked rather than indexed.
require absolute_static(cpio_entry.header);
assert absolute_static(cpio_entry.data);

// The name is bytes rather than a text field with a delimiter, and both are
// true of it: it is `namesize` bytes long *and* NUL-terminated. situ takes the
// length, which is what the kernel does -- `namesize` is authoritative and the
// NUL is inside it.
assert in_place(cpio_entry.name);

// THE BOUNDARY, and it is at the archive rather than at the entry.
//
// An archive is a run of entries ending at one whose *name* is "TRAILER!!!"
// (initramfs.c:374). situ can describe the entry completely and cannot express
// that stopping rule: `while (...)` tests an expression over the element just
// read, and the expression language is arithmetic over numbers -- there is no
// comparison against a byte string in it, and adding one would mean an
// operator whose operands are a field and a literal of a different kind.
//
// So an archive is a caller's loop over `cpio_entry`, and the entry is what
// this schema describes. The same shape as `example/dnsname`, where the label
// chain is described and the pointer is not followed: the boundary is the view
// model rather than a gap in the layout.
//
// What the schema *can* say is where the next entry starts, and it does: the
// two `reserved` runs above are exactly the padding a caller adds up.
