// QUIC and HTTP/3: an Initial packet's header, and the frames HTTP/3 puts on
// a stream.
//
// SOURCE. Every field and order here is from the RFCs, cited by section:
//
//   RFC 9000  16      variable-length integers: the two most significant bits
//                     of the first byte say one, two, four or eight bytes
//   RFC 9000  17.2    long header: form, fixed bit, type, version, then the
//                     connection ids, each behind a one-byte length
//   RFC 9000  17.2.2  Initial: token length and token, length, packet number,
//                     payload; the low two bits of byte one are the packet
//                     number's length less one
//   RFC 9000  18      transport parameters: id, length, value, all varints
//   RFC 9114  7.1     an HTTP/3 frame: type, length, payload
//   RFC 9114  7.2.4   SETTINGS: identifier and value, repeated
//
// WHY THIS ONE. Its integer is neither of the two `varint_type` had: no
// continuation bit, so the first byte is the whole of what decides the length.
// And nearly every length in the protocol is one, behind other lengths, so a
// header that looks flat costs what 26.918 is about.
//
// THE HEADER IS READ UNPROTECTED. On the wire the low bits of byte one and the
// packet number are masked (RFC 9001, section 5.4), which is a keyed step and
// not part of the layout.

target buffer;
endian big;
bit_order msb_first;

varint_type quic_varint {
	encoding = quic;
	max_bits = 62;
}

// RFC 9000, 12.4: a frame type is the one place the shortest form is required,
// and RFC 9114 uses this integer for its frame types too.
varint_type quic_type {
	encoding = quic;
	max_bits = 62;
	minimal;
}

struct initial {
	u1 header_form;
	u1 fixed_bit;
	u2 packet_type;
	u2 reserved;
	u2 number_length;
	u32 version;
	u8 destination_length [max = 20];
	u8 destination[destination_length];
	u8 source_length [max = 20];
	u8 source[source_length];
	quic_varint token_length;
	u8 token[token_length];
	// The packet number and the payload, and an authentication tag alone is
	// sixteen bytes, so a length below the longest packet number is no packet.
	quic_varint length [min = 4];
	u8 packet_number[number_length + 1];
	u8 payload[length - (number_length + 1)];
}

struct transport_parameters {
	tlv parameters (
		tag_type     = quic_varint,
		tag_decode   = { id = tag },
		tag_identity = id,
		value_size   = switch (id) { default: prefixed(quic_varint) },
		duplicate_tags = allowed,
	);
}

struct http3_frames {
	tlv frames (
		tag_type     = quic_type,
		tag_decode   = { kind = tag },
		tag_identity = kind,
		value_size   = switch (kind) { default: prefixed(quic_varint) },
		duplicate_tags = allowed,
	);
}

// The payload of a SETTINGS frame: identifiers and values, one after another.
struct http3_settings {
	quic_varint pairs[remaining];
}
