// An HTTP/1.1 request head (RFC 9112 section 3).
//
// Here because it is the shape situ said for a long time it would not
// describe: a request line and a header block framed by CRLF, then a body
// whose length is stated in text. Section 26.21 records why that position was
// wrong -- every capability axis says something about a delimited field, and
// two of them say more about text than about binary.
//
// What this is not is a parser generator. Situ describes where the bytes are
// and what they cost to reach; it does not know that `Host` is mandatory or
// that a `Transfer-Encoding` displaces `Content-Length`. Those are the
// protocol's rules and belong in the code that uses these accessors.

target buffer;
endian big;

// What a character literal here is worth. Two, because a header field's
// bytes are ASCII by RFC 9110 section 5.5 and Latin-1 in practice -- the
// specification says a recipient SHOULD treat other octets as opaque, which
// is a fact about the traffic rather than about the grammar. Both agree
// about every byte this schema switches on, and a literal they disagreed
// about would be refused with the disagreement named.
encoding ascii | latin1;

// One header line. `name` stops at the colon and folds case, because
// `Content-Length` and `content-length` are one field name; `value` stops at
// the CRLF and ignores the optional whitespace around itself.
//
// Both are `canonical = NonCanonical`, and the map says so: two byte
// sequences carry the same meaning, which is exactly what that axis is for.
struct header_field {
	u8  name[]   until ':'              [case_insensitive, encoding = ascii];
	u8  value[]  until "\r\n" | '\n'    [trim];
}

// `until "\r\n" | '\n'` is the second thing a real request made this file
// learn, and it is the same lesson as the colon below: RFC 9112 section 2.2
// says a recipient MAY recognise a bare LF as a line terminator, and one
// that does not loses every message from a sender that sends one -- which is
// most of what a hand-written client emits.
//
// Two alternatives of DIFFERENT lengths, which is the case worth having in
// the corpus: the span includes the delimiter, so which one matched decides
// where the next header starts. The longest match at the earliest offset
// wins, so a proper CRLF ends the field after the newline rather than
// leaving it as the next field's first byte -- and a schema that listed only
// `'\n'` would frame every conforming message one byte short.

// The delimiter is `':'` and not `": "`. RFC 9112 permits `name:value` with no
// space at all, and a tab where a space would do, so demanding one loses
// every header that omits it -- which is what the first draft of this file
// did, and what running it against a realistic request showed in one line.
// The optional whitespace is the *value's* to ignore, which is `[trim]`.

// The methods RFC 9110 defines, in the order sections 9.3.1 to 9.3.8 give
// them.
//
// No `[case_insensitive]`, and the absence is the interesting part. RFC 9110
// section 9.1 says the method token IS case-sensitive, so `get` is not `GET`
// and a reader that folded them would accept a request no server should.
// Compare `smtp.situ`, whose verbs are case-insensitive by RFC 5321 section
// 2.4 and whose set says so: two protocols, two answers, and the flag sits
// on the set because it is a property of each protocol's vocabulary rather
// than of a field.
//
// `default = pass`. Section 9.1 makes the method set extensible and has a
// server answer 501 to one it does not support, so an unknown method is a
// request this reader cannot serve rather than a frame it cannot parse --
// and PATCH (RFC 5789) is a registered method this list does not name, which
// is exactly the case `pass` is for.
tokens request_method {
	get     = "GET",
	head    = "HEAD",
	post    = "POST",
	put     = "PUT",
	delete  = "DELETE",
	connect = "CONNECT",
	options = "OPTIONS",
	trace   = "TRACE",
	default = pass,
}

// The two versions this framing carries (RFC 9112 section 2.3).
//
// One set used by two structs, which is the whole reason it is a declaration
// rather than something spelled twice: a request line and a status line name
// the same vocabulary, and a second copy of the list would be a second thing
// to be wrong.
//
// Both arms are eight bytes, so this looks like a case for `enum : u8[8]` --
// and it is not, because the member is DELIMITED. An enum decides its
// member's extent and would say where the field ends a second time, which
// 8.6.1 refuses; a token set is consulted after the delimiter has already
// said. Equal-length arms are allowed here and simply not required.
//
// `default = pass`, because section 2.3 tells a recipient to process a
// higher minor version as HTTP/1.1 rather than to refuse it.
tokens protocol_version {
	http_1_0 = "HTTP/1.0",
	http_1_1 = "HTTP/1.1",
	default  = pass,
}

// The request line. Each part ends where the next begins.
//
// `method` is capped: a token longer than sixteen bytes is not a method any
// registry lists, and the cap turns an unterminated scan into an error rather
// than a read to the end of the buffer. `target` is capped for the same
// reason at a length real servers accept.
struct request_line {
	request_method    method   until " "     max 16   [encoding = ascii];
	u8                target[] until " "     max 8192;
	protocol_version  version  until "\r\n"  max 16   [encoding = ascii];
}

// The head: a request line, then header lines until a blank one.
//
// The terminator ends the *run* rather than any single field -- a CRLF inside
// a header line belongs to that line. Section 8.6.3 is the construct and the
// distinction, which reads alike in the schema and could not differ more in
// the bytes.
struct request_head {
	request_line  start;
	header_field  fields[] until "\r\n";
}

// A response head, differing only in the first line. Kept separate rather
// than shared through a variant: the two lines have different fields, and a
// discriminant that told them apart would have to come from outside the
// bytes.
// `max 4` for a three-digit code, and the four is the point. A cap bounds
// the whole member, delimiter included (8.6.1), so `max 3` says "the code and
// its space are three bytes between them" -- which is a two-digit code, and
// HTTP has none. Every real response failed here: the scan ran out at the
// third digit, `validate` reported a frame cut short, and `reason` came back
// with the space still on the front of it.
struct status_line {
	protocol_version  version  until " "     max 16  [encoding = ascii];
	decimal  u16              code until " " max 4   [minimal];
	u8       reason[]         until "\r\n"  max 256;
}

struct response_head {
	status_line   start;
	header_field  fields[] until "\r\n";
}

// The bill for describing a text protocol, recorded rather than hidden.
//
// `assert` warns where it fails, and every one of these fails: that is the
// point. A predicate names the strong value, so asserting it over a field
// that does not reach it is how a schema writes down what it gave up --
// the same way `edges.situ` records the cost of a nul-terminated field.
//
// Read the three warnings this produces as the answer to "what does framing
// in text cost", and compare them against `udp.situ`, which asserts the same
// things and satisfies them.
assert random_access(request_head.fields);
assert canonical(header_field.name);
assert canonical(header_field.value);

// And the one thing that is a requirement. The request line starts at offset
// zero in every message, because nothing precedes it -- so the first scan
// begins at a known place even though nothing after it does.
require absolute_static(request_line.method);
