// Matroska, and so WebM: the EBML document ffmpeg writes.
//
// SOURCE. RFC 8794 for EBML, RFC 9559 for Matroska. Everything is an element:
// an ID, a size and that many bytes, which are other elements or a value. Both
// numbers say their own width by the first set bit of their first byte. The
// ID keeps that bit, because IDs are written with it, 0x1A45DFA3, and the size
// drops it.
//
// WHY THIS ONE. A size of all ones is the reserved "unknown", which a writer
// that cannot seek back uses for the Segment. It reads as the number it spells,
// so `document` says what it means: the Segment runs to the end. A file with a
// known Segment reads the same way, with one Segment.
//
// WHICH SUBSET. One Segment. A Cluster's size may be unknown too, as GStreamer's
// `streamable` muxer and a browser's MediaRecorder write it, and then the
// Cluster ends before the next element of the Segment's own level: before one of
// their IDs, which are bytes. Every other element has a known size.

target buffer;
endian big;

varint_type element_id   { encoding = ebml_id; max_bits = 32; }
varint_type element_size { encoding = ebml;    max_bits = 56; }

struct element {
	element_id   id;
	element_size size;
	u8           data[size];
}

// What a master element's data holds.
struct elements {
	element children[remaining];
}

struct ebml_header {
	element_id   id [must_eq = 0x1A45DFA3];
	element_size size;
	u8           fields[size] [holds = elements];
}

// A Cluster of unknown size: eight bytes of all ones, the only width a writer
// that cannot seek back uses. Its children are elements, each of known size,
// up to the ID of something at the Segment's level, which is the next member's
// and not this one's -- or to the end of the file.
struct open_cluster {
	element_size size [must_eq = 0xFFFFFFFFFFFFFF];
	element      children[] before "\x1F\x43\xB6\x75" | "\x1C\x53\xBB\x6B"
	                      | "\x12\x54\xC3\x67" | "\x19\x41\xA4\x69"
	                      | "\x10\x43\xA7\x70" | "\x11\x4D\x9B\x74"
	                      | "\x15\x49\xA9\x66" | "\x16\x54\xAE\x6B"
	                      | "\x1A\x45\xDF\xA3" | end;
}

struct sized_cluster {
	element_size size;
	u8           data[size] [holds = elements];
}

// A size whose first byte is 0x01 is eight bytes long, so all eight are there
// to peek at once the first is.
struct wide_cluster {
	peek u64 written;
	variant body switch (written) {
		case 0x01FFFFFFFFFFFFFF: open_cluster  open;
		default:                 sized_cluster sized;
	}
}

struct cluster {
	element_id id [must_eq = 0x1F43B675];
	peek u8    width;
	variant body switch (width) {
		case 0x01: wide_cluster  eight;
		default:   sized_cluster sized;
	}
}

// Of the Segment's own elements only a Cluster's ID begins 0x1F.
struct segment_child {
	peek u8 lead;
	variant body switch (lead) {
		case 0x1F: cluster cluster;
		default:   element other;
	}
}

struct document {
	ebml_header   header;
	element_id    segment [must_eq = 0x18538067];
	element_size  segment_size;
	segment_child children[remaining];
}

// An element opens with its ID, which is how a reader knows it.
require offset(element.id) == 0;
