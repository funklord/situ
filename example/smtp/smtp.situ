// SMTP (RFC 5321), and the two things about its framing that are not like
// the others.
//
// Chosen because it breaks in an informative place. A command line is an
// ordinary delimited member and situ handles it. The DATA body ends at a
// five-byte delimiter and situ handles that too. The *multiline reply* it
// cannot express at all, and saying exactly why is worth more than an
// example that only demonstrates what already worked.

target buffer;
endian big;

// The commands RFC 5321 defines, in the order section 4.1.1 numbers them.
//
// `[case_insensitive]` on the SET rather than on the member, which is where
// the fact belongs: section 2.4 makes the verb case-insensitive, and that is
// a property of SMTP's vocabulary rather than of this one field. The cost is
// the same either way and is recorded the same way -- `canonical(command
// .verb)` still fails, because `HELO` and `helo` are one verb with two
// spellings.
//
// `default = pass`, and this is the half worth reading. An unknown verb is
// not a malformed frame: RFC 5321 section 4.2.4 has the server answer 500 to
// a command it does not recognise, which is a reply rather than a parse
// failure -- and ESMTP adds verbs this list does not have, STARTTLS
// (RFC 3207), AUTH (RFC 4954) and BDAT (RFC 3030) among them. A schema that
// refused them would be wrong about ordinary traffic. What the set buys is
// the accessor: a reader gets `SITU_COMMAND_VERB_QUIT` instead of comparing
// four bytes itself, and `SITU_COMMAND_VERB_UNKNOWN` where it must decide.
tokens command_verb [case_insensitive] {
	ehlo = "EHLO",
	helo = "HELO",
	mail = "MAIL",
	rcpt = "RCPT",
	data = "DATA",
	rset = "RSET",
	vrfy = "VRFY",
	expn = "EXPN",
	help = "HELP",
	noop = "NOOP",
	quit = "QUIT",
	default = pass,
}

// A command: verb, optional argument, CRLF.
//
// `until " "` rather than a fixed four bytes: `RCPT TO:` and `MAIL FROM:`
// carry an argument and the space is what ends the verb. A command that
// carries none -- `DATA`, `QUIT`, `RSET` -- has no space at all, so this
// schema frames only the commands that take an argument. That was true
// before the vocabulary above existed and the vocabulary makes it visible
// rather than causing it: `which` answers UNKNOWN for a `QUIT` line, because
// the member it is asked about ran past the verb. Fixing it means framing
// the verb on `" " | "\r\n"`, which changes where `argument` starts and is
// its own change rather than a side effect of naming the verbs.
struct command {
	command_verb  verb  until " "     max 16  [encoding = ascii];
	u8  argument[]      until "\r\n"  max 512 [trim];
}

// One line of a reply. The code is three digits with no delimiter, which is
// why `[3]` and not `until`: in a padded field the leading zero is required
// rather than tolerated, so `007` is the only spelling of seven and the field
// is `Canonical` where a delimited number would not be.
//
// The separator after it is the whole of SMTP's multiline framing: `-` means
// another line follows, a space means this was the last. Both bytes are in
// the layout and readable. What situ cannot do is *use* the separator to
// decide how many lines there are -- see the note at the end.
struct reply_line {
	decimal  u16  code[3];
	u8            separator;
	u8            text[]  until "\r\n"  max 512;
}

// Dot-stuffing (RFC 5321 section 4.5.2). A line beginning with a dot is sent
// with two, and the receiver removes one -- which is what makes the
// terminator below unambiguous, because a body line consisting of one dot
// arrives as two.
//
// Declared as a `stuffing` kernel, which is the family COBS and HDLC are in:
// a trigger predicate and an insertion rule. The worst case is a body of
// nothing but `.CRLF` lines, three bytes in and four out.
//
// `unit = stream` and not `byte`, and the difference is real: the trigger is
// "the start of a line", which a decoder cannot evaluate from one byte
// without knowing what preceded it.
codec dot_stuffing {
	kernel = stuffing(worst_case = 4, per = 3, unit = stream, code = smtp_dot);
}
impl dot_stuffing derived;

// The DATA body: bytes ending at a dot on a line of its own, and stuffed.
//
// Both facts at once, and the order matters. The scan runs on the *encoded*
// bytes, because the stuffing is what protects the terminator -- `CRLF . CRLF`
// is unambiguous here and would not be after decoding. So the region is
// delimited and coded, and situ says which of its accessors give you which.
//
// The map records the consequence: `stage = TransformTime` on the interior,
// because nothing in it can be read before the transform has run.
struct data_block {
	coded body(dot_stuffing) until "\r\n.\r\n" {
		u8  content[remaining];
	}
}

// What situ does not describe here, said plainly.
//
// A multiline reply is a run of `reply_line` that ends *after* the line whose
// separator is a space. Situ's run construct (8.6.3) ends a run at a
// terminator standing where an element would start -- a different rule, and
// not this one. The difference is the quantifier: `until` asks about the
// position before each element, and SMTP asks about a field inside the
// element just read.
//
// So a reader of this schema gets the line and has to loop itself. That is
// the honest boundary and it is drawn here rather than in a paragraph
// somebody has to find: everything in this file is what situ describes, and a
// multiline reply is not in it.
//
// The construct that covers it is a run ending on a predicate over the
// element, and it now exists: `while` (8.6.6). It was not invented for this
// file, because a language addition wants a second protocol asking for the
// same thing and one example is not that. IPv6 extension headers asked
// second, and `example/ipv6ext` is where it landed.
//
// Written out, an SMTP reply is:
//
//     reply_line lines[] while (separator == 0x2D);
//
// It is left out here on purpose. This file is the record of a construct
// being asked for and declined, and rewriting it once the answer arrived
// would erase the more useful half of the example.

// The bill, recorded rather than hidden.
assert canonical(command.verb);
assert canonical(reply_line.text);
require absolute_static(command.verb);
require absolute_static(reply_line.code);
