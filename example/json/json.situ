// JSON (RFC 8259), as far as a layout language reaches.
//
// Here for the construct that makes it possible at all. A value contains an
// object, an object contains members, and a member contains a value: that is
// a mutual cycle, and situ refused every one of them until decision 0054 was
// amended. It is also the first schema in this directory whose recursion runs
// through a *variant arm* -- `case 0x7B: object` is how a tagged tree is
// written, and how every format with a "kind" byte reaches its children.
//
// It is here for the boundary as much as for the construct. JSON is a
// GRAMMAR and situ describes LAYOUTS, and the two disagree in exactly two
// places. Both are written down below rather than papered over, because a
// schema that quietly describes a subset is worse than one that says which
// subset it describes.

target buffer;
endian big;

// What a character literal in this file is worth. Three encodings rather
// than one, because JSON's own answer is UTF-8 (RFC 8259 section 8.1) and
// what arrives on a socket is frequently ASCII and occasionally Latin-1 --
// and every structural byte this schema switches on is the same value in
// all three. Declaring the three is what makes that a checked fact rather
// than an assumption: a literal these encodings disagree about is refused
// with the disagreement named.
encoding ascii | utf8 | latin1;

// And what may stand between two tokens. RFC 8259 section 2 says exactly
// these four bytes, which is why the set is written down rather than assumed:
// HTTP's optional whitespace is two of them, XML's is these four plus
// nothing, and a compiler that picked one would be wrong about the others.
//
// Declared once and reached by a bare `skip` on the members that permit it.
// Five of them do, which is the whole of what JSON's whitespace rule comes to
// in a layout: a run of these bytes may precede a token, and it belongs to the
// token it precedes -- because a struct's members partition its bytes exactly,
// and the member before it is finished.
whitespace ' ' | '\t' | '\r' | '\n';

// The first byte says which kind of value this is, and it belongs to the
// value: a variant switches on a *field*, and a field is bytes. So the
// discriminant is the opening brace, the opening bracket, the opening quote,
// the `t` of `true`. Each arm holds what comes after it.
//
// Written as characters and not as numbers, which is the difference between
// a schema that asserts an agreement and one that checks it. `0x7B` says
// that number and stays silent about which encoding made it that; `'{'` says
// the character, and the `encoding` line above turns "these three agree" into
// something the compiler refuses to let drift.
//
// `[depth]` bounds the recursion and every struct in the cycle states the
// same one -- which is the rule rather than a repetition: a walk entering at
// `member` spends `member`'s number, so two numbers for one cycle would be
// an ambiguity (17.0). It counts nested STRUCTS, not turns: one level of
// JSON nesting is value -> object -> member -> value, three structs, so 64
// here is about twenty-one levels of braces.
//
// `default:` is the number, and that is the arm this file waited two
// language changes for. See `number` below.
struct value [depth = 64] {
	u8  kind  skip;
	variant body switch (kind) {
		case '{':  object   as_object;
		case '[':  array    as_array;
		case '"':  text     as_string;
		case 't':  yes      as_true;
		case 'f':  no       as_false;
		case 'n':  nothing  as_null;
		default:   number   as_number;
	}
}

// An object is members until one does not end in a comma.
//
// `while (sep == 0x2C)` rather than `until "}"`, and the difference is the
// whole reason this construct exists: `until` asks whether the terminator
// stands where the NEXT element would start, and JSON separates members with
// a comma while terminating the object with a brace. A `while` asks about the
// element just read, so the member that ends in `}` is the one that ends the
// run -- and it is part of it, which is what makes the brace accounted for.
struct object [depth = 64] {
	member  entries[] while (sep == ',');
}

// One member: `"key":value` and the byte that follows it.
//
// `open` is the key's opening quote and `sep` is the comma or the closing
// brace. Neither is decoration: a member has to account for every byte
// between where it starts and where the next one does, or the run walks into
// the middle of itself.
struct member [depth = 64] {
	u8     open   skip;
	u8     key[]  until "\"";
	u8     colon  skip;
	value  held;
	u8     sep    skip;
}

// Three of the five leads are here, and the two that are not are as
// interesting. `key` has none because nothing may stand between a quote and
// the string it opens -- the whitespace rule is about the space BETWEEN
// tokens, and a string's opening quote and its content are one token. `held`
// has none because it does not need one: a value's own first member is
// `kind`, which skips, so whitespace before a value is already accounted for
// by the value. A lead there as well would be a second answer to one
// question, and the run would walk into the middle of itself.

// An array is the same shape with no keys.
struct array [depth = 64] {
	element  entries[] while (sep == ',');
}

struct element [depth = 64] {
	value  held;
	u8     sep  skip;
}

// A string, from after its opening quote to its closing one.
//
// `[escape = "\\"]` is what makes that true of real JSON. Without it a `\"`
// inside the content ends the scan, and this file said so for a while --
// "the one thing that is a genuine gap rather than a language boundary" --
// while the construct that closes it sat one attribute away, named in the
// same sentence. It was not a gap in situ; it was a gap in this schema.
//
// The measurement, because a short extent with no complaint is the answer
// this repository rates worst and it was being produced here:
//
//     {"a":"say \"hi\""}    18 bytes    extent 13    before
//     {"a":"say \"hi\""}    18 bytes    extent 18    now
//     ["a\"b"]               8 bytes    extent  6    before
//
// The rule is the byte AFTER the escape is content, whatever it is --
// itself included -- so `"back\\slash"` ends at its own closing quote
// rather than at the one a naive reader would find two bytes later. That
// case framed correctly before and still does, which is the half worth
// checking: a fix to the failing case that breaks the passing one is not a
// fix.
//
// `canonical` is weakened here and the map says so, which is right, and the
// escape weakens it a second way: two spellings of one string, since `a`
// and `\u0061` are the same character. Situ frames the span and
// does not decode it -- what an escape MEANS is the reader's, and what this
// says is only where the string ends.
struct text {
	u8  chars[]  until "\"" [escape = "\\"];
}

// The three literals. Each is its first byte -- the discriminant -- plus the
// rest, pinned, because a value that begins with `t` and is not `true` is
// malformed and this is the one place in the file where situ can say so.
// A number, from after its first digit to whatever ends it.
//
// `before` and not `until`, and that distinction is the whole of why this
// arm exists. A JSON number ends at a comma, a bracket or a brace, and the
// byte that ends it belongs to the OBJECT rather than to the number: a
// member that swallowed the comma would leave the byte after it as the
// separator its run reads. `until` is a terminator -- a CRLF belongs to the
// line it ends -- and this is a separator, which belongs to neither side.
//
// The `default` arm rather than eleven cases. A number begins with `-` or a
// digit, and a variant would need one case each; `default` says the same
// thing, and every other kind of value has taken its own byte above. What
// it costs is that a document beginning with a byte no JSON value can begin
// with is read as a number of length zero rather than refused -- which
// `[digits_valid]` would catch if situ had a check for "these bytes are a
// JSON number", and which is a grammar rather than a layout.
// `[trim]` is the trailing half, and it does not quite reach. A number's
// scan runs to whichever delimiter comes first, so the whitespace AFTER the
// digits is inside the member rather than in front of the separator that
// follows -- the scan gets there before the separator's lead does, and one
// of them has to own those bytes. `[trim]` takes them out of the VALUE,
// which is what a caller reads.
//
// It takes out all four of them now. This said `[trim]` was HTTP's optional
// whitespace, space and horizontal tab, and that widening it to a declared
// set was "a change to an attribute five schemas here use, which is not
// this construct's to make" -- and the change was made, so `[trim]` removes
// whatever the file's own `whitespace` declares. For this file that is
// RFC 8259 section 2's four bytes, so `{"a": 1\n}` frames correctly AND its
// number reads back without the newline. The signature says which bytes:
// `trim=20090d0a` on this member, `trim=2009` on HTTP's header value.
//
// AND IT CANNOT BE A `scaled` NUMBER, which is the thing to say plainly
// because 0056 built that construct and this is its only asker.
//
// `rest` is not a number. The variant above switches on `kind`, and a
// discriminant is a FIELD -- it occupies its byte -- so the arm begins
// after it. Measured rather than reasoned:
//
//     {"a":12.5}    the `number` struct sees    2.5
//
// The `1` was spent selecting the arm. A `scaled i64` here would parse
// what it was given and report 25 and -1, confidently, for a document
// whose number is 12.5 -- a wrong value where there is now an honest byte
// run, which is the trade this repository rates worst.
//
// The blocker is not this construct's and is already written down: 26.253
// records "dispatch consumes; a text grammar needs it to keep", from an
// argv evaluation that hit the same wall -- `variant body switch (first)`
// hands the positional arm `ello` where the message said `hello`. There
// is no peek. `before` solved exactly this shape for delimiters, where the
// byte belongs to neither side; a discriminant has the same problem and no
// answer yet.
//
// So this member stays a byte run, and the reason is a language question
// rather than a gap in the schema -- which is what this file is for.
struct number {
	u8  rest[] before ',' | ']' | '}' [trim];
}

struct yes     { u8  rest[3]  [must_eq = "rue"]; }
struct no      { u8  rest[4]  [must_eq = "alse"]; }
struct nothing { u8  rest[3]  [must_eq = "ull"]; }

// ---------------------------------------------------------------------------
// The bill, and what is left of it is one thing that is not a gap.
//
// WHITESPACE IS ACCOUNTED FOR NOW, by the five `skip` clauses above. It used
// to be the last line of this bill, and the entry said skipping it was "a
// grammar's job rather than a layout's" because "a member whose start depends
// on how many spaces preceded it has no offset anybody can compute". The
// first half of that was wrong and the second half was right, which is what
// made it convincing.
//
// The line 8.6 draws is not that every offset is arithmetic -- half this
// schema's offsets are not. It is that every byte belongs to exactly one
// member. Whitespace keeps that: the run in front of a token is the token's
// own, because the member before it is finished and a struct's members
// partition its bytes exactly. What it costs is the offset, which drops to
// Scanned -- and that is a price this schema was already paying for every
// member after the first delimiter.
//
// WHAT IT COSTS HERE, exactly, is the requirement that used to be at the
// foot of this file:
//
//     require absolute_static(value.kind);
//
// It said a document starts at offset zero because nothing precedes it. That
// stopped being true the moment whitespace could: ` {"a":1}` is a JSON
// document, and its first token is at offset one. So the claim is an `assert`
// below, where it reads as the measurement it now is rather than as a demand
// the schema cannot meet. Permitting leading whitespace and knowing where the
// first byte is are the same question asked twice, and JSON's answer is the
// first.
//
// AND ESCAPES ARE FRAMED, which was the other line of this bill and was
// never a language boundary: `[escape = "\\"]` on `text.chars` is the whole
// of it, and the entry above `text` records what the schema measured while
// it went unused. What situ still does not do is DECODE one -- `\\u0061` is
// framed as six bytes and means `a` to a reader, which is the same division
// of labour every other member here follows.
//
// TRAILING whitespace belongs to nobody, and that is the honest remaining
// edge. `{"a":1} ` is eight bytes and this schema measures seven of them: a
// lead belongs to the member that FOLLOWS it, and after the last token there
// is no member to follow. That is not a wrong measurement -- the document is
// seven bytes and the eighth is not part of it -- but a caller framing a
// stream has to know it, because the extent will not step over it.
//
// It used to be three lines. A NUMBER could not be framed at all, for two
// reasons that arrived a commit apart. `until` took one delimiter and a
// number ends at whichever of several comes first; and `until` is a
// TERMINATOR, whose delimiter belongs to the member, where a separator
// belongs to neither side. `until ',' | ']' | '}'` fixed the first and
// `before` the second, and `number` above is what they buy together.
//
// The measurements that recorded each cost are worth keeping, because they
// are what a wrong answer looked like:
//
//     {"a":12}      8 bytes     extent 7    validate ok   (before `before`)
//     {"a":12}      8 bytes     extent 8    validate ok
//     { "a" : 12 }  12 bytes    extent 8    validate ok   (before `skip`)
//     { "a" : 12 }  12 bytes    extent 12   validate ok
//
// The seven came from two rules that were each correct and neither of which
// mentioned the other: a value whose discriminant matched no arm has an
// extent of zero, and `validate` does not descend into the elements of a
// run. A short measurement and no complaint is the answer this repository
// rates worst, and it took a language change rather than a fix.
//
// The eight is the same shape one construct along. Every member measured its
// own bytes correctly and the whitespace between them belonged to no member
// at all, so the sum was short by exactly the bytes nobody had claimed --
// and `validate` was content, because every constraint it knows about held.
//
// AND THE WALKERS FOLLOW LESS OF IT THAN THE GENERATED CODE, on purpose.
// `[depth = 64]` is the format's number; a walker spends its own, because it
// reads a schema it was handed at run time and the stack is the program's.
// Both refuse by name rather than measuring short -- so
// `{"a":["b",{"c":"d"}]}` is nine structs, which a default `situ-walk` build
// declines and `-DWALK_DEPTH_MAX=64` measures at twenty-one bytes. Summing
// the largest frame of every function in that walker's recursion cycle,
// `-Os` on x86-64, one level costs at most 944 bytes, which is why the
// default is small and why it is overridable.
//
// None of this is a gap in the schema. It is what this format asks of situ,
// which is what an example is for.

// What framing in text costs, recorded the way `http.situ` records it: each
// of these fails, and the failure is the measurement.
assert random_access(object.entries);
assert canonical(text.chars);

// And the one that used to be a requirement. A document does start at offset
// zero -- but its first TOKEN need not, because whitespace may precede it,
// and `value.kind` is the token rather than the byte. This is what permitting
// whitespace costs, stated where a reader will see it.
assert absolute_static(value.kind);
