# Documents, written by hand and checked against Python's `json` module for
# what they are: `json.loads` accepts every one of them.
#
# Compact, because that is the subset this schema describes -- see the note
# at the foot of `json.situ`. Every byte is accounted for by some member, so
# the extent of each of these equals its own length, and that is what a run
# over them depends on.

# A string. The value's own byte is the opening quote and `text` holds what
# follows, to the closing one.
value string 22 68 69 22
	kind = 34

# An object with one member. `{` is the discriminant, `}` is the member's
# `sep` -- the byte that ends the run because it is not a comma.
value object 7B 22 61 22 3A 22 62 22 7D
	kind = 123

# Two members, so the comma does its job: the first member ends in one and
# the run continues.
value pair 7B 22 61 22 3A 22 62 22 2C 22 63 22 3A 22 64 22 7D
	kind = 123

# An object inside an object, which is the cycle this example is for:
# value -> object -> member -> value.
value nested 7B 22 61 22 3A 7B 22 62 22 3A 22 63 22 7D 7D
	kind = 123

# An array, and a mixed one: the elements are a string and an object.
value array 5B 22 78 22 2C 22 79 22 5D
	kind = 91

value mixed 7B 22 61 22 3A 5B 22 62 22 2C 7B 22 63 22 3A 22 64 22 7D 5D 7D
	kind = 123

# The three literals. Each is its first byte plus a pinned tail, which is the
# one place this schema can say that a value beginning `t` and not spelling
# `true` is malformed.
value yes 74 72 75 65
	kind = 116

value no 66 61 6C 73 65
	kind = 102

value nothing 6E 75 6C 6C
	kind = 110

# Numbers, which this schema could not frame until `until` took several
# delimiters and `before` stopped consuming them. Each ends at the byte that
# separates it from what follows, and that byte belongs to the object.
value number 31 32
	kind = 49

value in_object 7B 22 61 22 3A 31 32 7D
	kind = 123

value two_numbers 7B 22 61 22 3A 31 32 2C 22 62 22 3A 33 7D
	kind = 123

value number_array 5B 31 2C 32 2C 33 30 5D
	kind = 91

# A number is whatever the bytes between the delimiters are, so the exponent
# and the sign cost nothing extra -- which is the point of framing rather
# than parsing.
value scientific 2D 31 2E 35 65 33
	kind = 45

# Whitespace, which this schema described none of until `skip`. Every one of
# these is the same document as one above with bytes between its tokens, and
# every one measures its own length -- which is what a run over them needs.

# A member with a space around every token: five leads fire, one per
# `skip` in the schema, and the extent is the document's own length.
value spaced 7B 20 22 61 22 20 3A 20 31 32 20 7D
	kind = 123

# Whitespace before the document itself, which is what turned the old
# `require absolute_static(value.kind)` into an assert.
value leading 20 20 7B 22 61 22 3A 20 31 32 7D
	kind = 123

# An array, spaced. The lead on `element.sep` is what accounts for the
# space before each comma, and the one on `value.kind` for the space after.
value array_spaced 5B 20 31 20 2C 20 32 20 2C 20 33 30 20 5D
	kind = 91

# A pretty-printed object, tabs and newlines included, which is what a
# serialiser writes when a person is going to read it.
value indented 7B 0A 09 22 61 22 20 3A 20 22 62 22 2C 0A 09 22 63 22 20 3A 20 33 0A 7D
	kind = 123

# The cycle and the whitespace together: every nesting level is spaced,
# so a lead is read at every turn of value -> object -> member -> value.
value deep_spaced 7B 20 22 61 22 20 3A 20 7B 20 22 62 22 20 3A 20 5B 20 31 20 2C 20 32 20 5D 20 7D 20 7D
	kind = 123

# Escapes, and the string this schema used to measure short.

# A string with an escaped quote, which is most real JSON and which
# this schema mis-framed until `[escape]` was used: the scan stopped at
# the `\\"` and reported 13 bytes of 18.
value escaped_quote 7B 22 61 22 3A 22 73 61 79 20 5C 22 68 69 5C 22 22 7D
	kind = 123

# The same inside an array, where the short extent also took the run
# with it.
value escaped_in_array 5B 22 61 5C 22 62 22 5D
	kind = 91

# An escaped backslash immediately before the closing quote. This one
# framed correctly BEFORE the attribute as well, and is here because a
# fix to the failing case that broke the passing one would not be one:
# the escape applies to the byte after it, itself included.
value escaped_backslash 7B 22 61 22 3A 22 62 61 63 6B 5C 5C 73 6C 61 73 68 22 7D
	kind = 123
