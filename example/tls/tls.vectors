# ClientHellos written by OpenSSL 3.5 through Python's `ssl`, nothing of situ's
# anywhere near them: one offering TLS 1.3 with a server name, one held to 1.2,
# and one to an address, which carries no server name. `record <name> <hex>`.
record tls13_with_name 
record tls12_only 
record tls12_by_address 
