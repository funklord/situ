// NTP packet (RFC 5905), fixed 48-byte portion.
//
// A rare thing: a protocol whose designers kept every field at a fixed offset
// and a natural alignment. The four 64-bit timestamps sit at 16, 24, 32 and 40,
// so all of them are 8-byte aligned relative to the message base.
//
// Also the clearest example of `repr = ValueConverted` mattering. On a
// little-endian host every timestamp is byte-swapped on access, so a caller
// cannot be handed a pointer to one -- only a value. Situ refuses to generate
// the pointer accessor rather than leaving the trap in place.

target buffer;
endian big;
bit_order msb_first;

enum leap_indicator : u2 {
	none              = 0,
	last_minute_61    = 1,
	last_minute_59    = 2,
	unsynchronised    = 3,
}

enum mode : u3 {
	reserved_mode     = 0,
	symmetric_active  = 1,
	symmetric_passive = 2,
	client            = 3,
	server            = 4,
	broadcast         = 5,
	control           = 6,
	private_use       = 7,
}

// NTP timestamps are a 32.32 fixed-point count of seconds since 1900. Situ has
// no fixed-point type yet (project.md section 8.1 defers it), so the two halves
// are named rather than pretending a u64 is a scalar quantity.
struct timestamp {
	u32  seconds;
	u32  fraction;
}

struct ntp_packet {
	leap_indicator  leap;
	u3             version  [must_eq = 4];
	mode           mode;

	u8             stratum;
	i8             poll;
	i8             precision;

	u32            root_delay;
	u32            root_dispersion;
	u32            reference_id;

	timestamp      reference  @ 0x10;
	timestamp      origin;
	timestamp      receive;
	timestamp      transmit;
}

require size(timestamp) == 8;
require size(ntp_packet) == 48;
require absolute_static(ntp_packet);
require canonical(ntp_packet);

// The first byte packs 2 + 3 + 3 bits and closes exactly, so nothing straddles.
require in_place(ntp_packet.mode);

// Every timestamp is 8-byte aligned, which is why NTP is cheap to handle on
// targets that fault on unaligned access.
require aligned(ntp_packet.transmit, 8);
require aligned(ntp_packet.root_delay, 4);

// Big endian on a little-endian host means these are ValueConverted: the value
// is not the memory. Getters return by value, never by pointer.
require in_place(ntp_packet.transmit.seconds);
