# Golden vectors for the CBOR worked example.
#
# RFC 8949, appendix A, each named for the value the RFC gives it.

item zero 00
item ten 0a
item twenty_three 17
item twenty_four 18 18
item hundred 18 64
item thousand 19 03 e8
item million 1a 00 0f 42 40
item trillion 1b 00 00 00 e8 d4 a5 10 00
item largest 1b ff ff ff ff ff ff ff ff
item minus_one 20
item minus_thousand 39 03 e7
item half_zero f9 00 00
item double_1_1 fb 3f f1 99 99 99 99 99 9a
item false_value f4
item null_value f6
item empty_bytes 40
item four_bytes 44 01 02 03 04
item ietf 64 49 45 54 46
item empty_array 80
item nested_array 83 01 82 02 03 82 04 05
item empty_map a0
item integer_map a2 01 02 03 04
item mixed_map a2 61 61 01 61 62 82 02 03
item array_with_map 82 61 61 a1 61 62 61 63
item date_string c0 74 32 30 31 33 2d 30 33 2d 32 31 54 32 30 3a 30 34 3a 30 30 5a
item epoch c1 1a 51 4b 67 b0
item bignum c2 49 01 00 00 00 00 00 00 00 00
