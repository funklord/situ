# Radiotap headers laid out from the specification's alignment and size table
# by a script that knows nothing of situ, each followed by a ten-byte 802.11
# ACK. tshark 4 read each back field by field: mactime, rate, channel, signal,
# antenna, xchannel, MCS, A-MPDU, VHT, timestamp and HE, and the length, with
# no malformed mark. `radiotap <name> <hex>`.
radiotap mac80211_rx 00001a002f4800000807060504030201100c8509a000c4010000d4000000001122334455
radiotap flags_then_channel 00000e000a00000002008509a000d4000000001122334455
radiotap rate_then_lock 00000c008400000016004d00d4000000001122334455
radiotap ext_word_aligns_tsft 00001900030000800000000000000000887766554433221100d4000000001122334455
radiotap two_ext_words 000016000e000080000000800000000000028509a000d4000000001122334455
radiotap modern_rx 000048000200fc0000000000400100003c1424170701050092100000020000004400040491000000000000000000000000ffeeddccbbaa0003002001010002000300040005000600d4000000001122334455
radiotap empty 0000080000000000d4000000001122334455
radiotap tx_status 00000e00008403000f0008000203d4000000001122334455
radiotap every_field 00006800ffffff000100000000000000100c8509a0000506c4a00900080007000f0121050200080002030000400100003c14241707010500921000000200000044000404910000000000000000000000070000000000000003002001010002000300040005000600d4000000001122334455
