// RIFF: the container of WAV, AVI and WebP, here holding a WAV.
//
// SOURCE. Microsoft's Multimedia Programming Interface and Data Specifications
// 1.0. A file is `RIFF`, a size, a form and a run of chunks, and a chunk is an
// id, a size and that many bytes.
//
// WHY THIS ONE. A chunk's data is padded to an even length and its size does not
// say so. So the pad's length is decided by the data, in an element of a run,
// and the next chunk starts past it: `pad_to(2)` measured as nothing here is a
// chunk that ends a byte early, and every chunk after it read from the pad.
//
// `fmt ` and `data` are told apart by four bytes a caller compares. What a chunk
// holds is the form's and not the container's, so `format` is read from `chunk`'s
// bytes where that caller finds one.

target buffer;
endian little;

struct chunk {
	u8  id[4];
	u32 size;
	u8  data[size];
	pad_to(2);
}

struct riff {
	u8    tag[4] [must_eq = "RIFF"];
	u32   size;
	u8    form[4];
	chunk chunks[remaining];
}

// WAVE's `fmt `, as far as PCM needs.
struct format {
	u16 tag;
	u16 channels;
	u32 samples_per_second;
	u32 bytes_per_second;
	u16 block_align;
	u16 bits_per_sample;
}

// The size stands where a reader decides whether it holds the file.
require absolute_static(riff.size);
