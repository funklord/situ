# situ wire signature v1
# schema: tcp.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, the bytes a tag covers --
# states it on `name what: value` lines below the members, one line per
# entry so that a diff names the entry that moved.

bit_order msb_first
endian big
target buffer

struct tcp_header size=20..
  @0x0000   2         u16        source_port  big
  @0x0002   2         u16        destination_port  big
  @0x0004   4         u32        sequence  big
  @0x0008   4         u32        acknowledgement  big
  @0x000c   4bit      u4         data_offset  msb_first min=5
  @0x000c:4 4bit      u4         <reserved0>  msb_first must_be_zero
  @0x000d   1bit      bit        cwr  msb_first
  @0x000d:1 1bit      bit        ece  msb_first
  @0x000d:2 1bit      bit        urgent  msb_first
  @0x000d:3 1bit      bit        ack  msb_first
  @0x000d:4 1bit      bit        push  msb_first
  @0x000d:5 1bit      bit        reset  msb_first
  @0x000d:6 1bit      bit        syn  msb_first
  @0x000d:7 1bit      bit        fin  msb_first
  @0x000e   2         u16        window  big
  @0x0010   2         u8         checksum  self_as=0
  @0x0012   2         u16        urgent_pointer  big
  @0x0014   0..40     u8         options  sized-by=(data_offset-5)*4
  ~         0..       u8         payload  sized-by=remaining
  checksum covers: tcp_pseudo_header(prefix) <reserved0> ack acknowledgement cwr data_offset destination_port ece fin options payload push reset sequence source_port summed syn urgent urgent_pointer window

struct tcp_pseudo_header size=12
  @0x0000   4         u32        source_address  big
  @0x0004   4         u32        destination_address  big
  @0x0008   1         u8         zero  must_eq=0
  @0x0009   1         u8         protocol
  @0x000a   2         u16        tcp_length  big
