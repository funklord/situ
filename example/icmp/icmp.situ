// ICMP (RFC 792), as the kernel reads it.
//
// Eight bytes, and the smallest example of a field whose meaning depends on an
// earlier field: the last four are an identifier and a sequence number for an
// echo, a gateway address for a redirect, and an MTU for a fragmentation
// failure. The kernel writes that as a union and switches on `type`; situ
// writes it as a variant and switches on the same field.
//
// SOURCE. The layout and every constant here are from the tree on this
// machine, and the arms are the ones its own parsers reach for:
//
//   include/uapi/linux/icmp.h:89   struct icmphdr, and the union at :93
//   include/uapi/linux/icmp.h:26   ICMP_ECHOREPLY .. ICMP_PARAMETERPROB
//   net/ipv4/icmp.c:1149           info = ntohs(icmph->un.frag.mtu)
//   net/ipv4/icmp.c:1163           info = ntohl(icmph->un.gateway) >> 24
//   net/ipv4/icmp.c:1294           icmphdr->un.echo.sequence
//
// The union has a fourth member -- `__u8 reserved[4]` -- and it is the arm
// this schema calls `unused`: four bytes nobody reads, which is what an
// unreachable or a time-exceeded message carries before the datagram that
// caused it.

target buffer;
endian big;

enum icmp_type : u8 {
	echo_reply              = 0,
	destination_unreachable = 3,
	redirect                = 5,
	echo_request            = 8,
	time_exceeded           = 11,
	parameter_problem       = 12,
	default                 = error,
}

// The echo arm: `un.echo`, two 16-bit fields a pinger matches replies with.
struct icmp_echo_id {
	u16  identifier;
	u16  sequence;
}

// The fragmentation arm: `un.frag`. Two unused bytes and the MTU the router
// could not exceed, which is the field `icmp.c:1149` reads.
struct icmp_frag {
	reserved  u16;
	u16       mtu;
}

// One message. The variant is four bytes whichever arm is selected, which is
// unusual and worth saying: a variant normally costs the offset axis for
// everything after it, and this one costs nothing because RFC 792 sized every
// arm the same. That is a property of the format, and the map is where it
// shows.
struct icmp_message {
	authenticated message {
		icmp_type  type;
		u8         code;

		// RFC 792, and RFC 1071 for how it is computed: the one's-complement
		// sum of the whole message *including these two bytes*, which are
		// taken as zero while it runs. `[self_as = 0]` is that sentence, and
		// it is what lets a checksum sit inside the region it covers.
		//
		// What it buys is section 14.2's dirty bit: writing any covered byte
		// marks the checksum stale and the generated API says so, where a
		// plain `u16` left the caller to remember.
		checksum u8 checksum[2] covers(message) [self_as = 0];

		variant body switch (type) {
			case icmp_type.echo_request:            icmp_echo_id  echo;
			case icmp_type.echo_reply:              icmp_echo_id  reply;
			case icmp_type.redirect:                u8            gateway[4];
			case icmp_type.destination_unreachable: icmp_frag     frag;
			case icmp_type.time_exceeded:           u8            unused[4];
			case icmp_type.parameter_problem:       u8            pointer[4];
		}
	}
}

require size(icmp_message) == 8;
require absolute_static(icmp_message);

// And the conflict section 14.2 exists to make visible: `sequence` is inside
// the coverage, so writing it is still a store to the same two bytes and it
// leaves the checksum stale. `in_place` reads both axes and fails; the form
// that asks only about the store is `in_place_dirty`, and the difference
// between the two is the whole point.
require in_place_dirty(icmp_message.body.echo.sequence);
assert in_place(icmp_message.body.echo.sequence);

// What the variant costs, which is nothing. Every arm is four bytes, so the
// message has one size and every member of every arm sits at a constant
// offset -- the one case where `variant` weakens neither `offset` nor `size`.
// Compare `example/dnsname`, where the arms differ and everything after the
// variant becomes Dynamic.
assert random_access(icmp_message.body);

// `default = error` on the enum rather than `default:` on the variant: an ICMP
// type situ does not name is a message this schema cannot place, and section
// 14.5 says an unmatched discriminant is refused rather than guessed at. The
// generated `validate` returns the version error for one.

// WHAT THE COMPILER CONTRIBUTES, and what it does not. The algorithm is the
// caller's -- a signature says what a transform does, never how (13.1) -- so
// what is generated is the two things only the compiler knows: the span the
// sum runs over, and where inside that span the checksum's own bytes are.
//
//     situ_icmp_message_checksum_covered(view, &at, &len)
//     situ_icmp_message_checksum_self_span(view, &hole, &n)
//     SITU_ICMP_MESSAGE_CHECKSUM_SELF_AS
//
// A caller sums `len` bytes from `at`, substituting SELF_AS for the `n` bytes
// at `hole`. That is RFC 1071 with nothing left implicit, and it is the same
// shape a GPT header CRC needs, which zeroes its own field, and a tar header
// sum, which uses spaces -- which is why `self_as` carries a value.
