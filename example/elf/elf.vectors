# Golden vectors for the ELF worked example.
#
# Laid out by GNU binutils, never by situ. The program is six instructions
# and a string, assembled and linked as:
#
#   _start: mov $60, %eax ; xor %edi, %edi ; syscall   (exit 0)
#   .section .rodata ; msg: .ascii "situ\n"
#
#   as --64 -o tiny.o tiny.s     (GNU assembler 2.44)
#   ld -s -n -o tiny tiny.o      (stripped, not page-aligned: 416 bytes)
#
# The expected values are readelf's (`readelf -h -l -S -W`), a second tool
# reading the same bytes: an executable with one PT_LOAD and four sections,
# and the relocatable object it came from, which has no program table --
# `phnum` and `phentsize` both 0, the case the `when` rules are written to
# let through.

# The linked executable: one segment, four sections, names in section 3.
elf64 executable 7F 45 4C 46 02 01 01 00 00 00 00 00 00 00 00 00 02 00 3E 00 01 00 00 00 78 00 40 00 00 00 00 00 40 00 00 00 00 00 00 00 A0 00 00 00 00 00 00 00 00 00 00 00 40 00 38 00 01 00 40 00 04 00 03 00 01 00 00 00 05 00 00 00 78 00 00 00 00 00 00 00 78 00 40 00 00 00 00 00 78 00 40 00 00 00 00 00 0E 00 00 00 00 00 00 00 0E 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 B8 3C 00 00 00 31 FF 0F 05 73 69 74 75 0A 00 2E 73 68 73 74 72 74 61 62 00 2E 74 65 78 74 00 2E 72 6F 64 61 74 61 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 0B 00 00 00 01 00 00 00 06 00 00 00 00 00 00 00 78 00 40 00 00 00 00 00 78 00 00 00 00 00 00 00 09 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 11 00 00 00 01 00 00 00 02 00 00 00 00 00 00 00 81 00 40 00 00 00 00 00 81 00 00 00 00 00 00 00 05 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 86 00 00 00 00 00 00 00 19 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
	type      = 2
	machine   = 62
	entry     = 4194424
	phoff     = 64
	shoff     = 160
	phentsize = 56
	phnum     = 1
	shentsize = 64
	shnum     = 4
	shstrndx  = 3

