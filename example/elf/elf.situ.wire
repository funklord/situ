# situ wire signature v4
# schema: elf.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian little
target buffer

struct elf64 size=64
  @0x0000   16        elf_ident  ident  little
  @0x0010   2         u16        type  little
  @0x0012   2         u16        machine  little
  @0x0014   4         u32        version  little must_eq=1
  @0x0018   8         u64        entry  little
  @0x0020   8         u64        phoff  little
  @0x0028   8         u64        shoff  little
  @0x0030   4         u32        flags  little
  @0x0034   2         u16        ehsize  little must_eq=64
  @0x0036   2         u16        phentsize  little
  @0x0038   2         u16        phnum  little
  @0x003a   2         u16        shentsize  little
  @0x003c   2         u16        shnum  little
  @0x003e   2         u16        shstrndx  little
  ~         0..3669960 program_table programs  args count=phnum at=phoff
  ~         0..4194240 section_table sections  args count=shnum at=shoff
  elf64 refuses: program_entry_size when elf64.phnum != 0 && elf64.phentsize != 56
  elf64 refuses: section_entry_size when elf64.shnum != 0 && elf64.shentsize != 64

struct elf_ident size=16
  @0x0000   4         u8         magic  little must_eq="\x7FELF"
  @0x0004   1         u8         class  must_eq=2
  @0x0005   1         u8         data  must_eq=1
  @0x0006   1         u8         version  must_eq=1
  @0x0007   1         u8         osabi
  @0x0008   1         u8         abiversion
  @0x0009   7         u8         pad  little

struct program_header size=56
  @0x0000   4         u32        type  little
  @0x0004   4         u32        flags  little
  @0x0008   8         u64        offset  little
  @0x0010   8         u64        vaddr  little
  @0x0018   8         u64        paddr  little
  @0x0020   8         u64        filesz  little
  @0x0028   8         u64        memsz  little
  @0x0030   8         u64        align  little

struct program_table size=0..3669960
  parameter -         u16        count [stream]
  @0x0000   0..3669960 program_header entries  sized-by=count

struct section_header size=64
  @0x0000   4         u32        name  little
  @0x0004   4         u32        type  little
  @0x0008   8         u64        flags  little
  @0x0010   8         u64        addr  little
  @0x0018   8         u64        offset  little
  @0x0020   8         u64        size  little
  @0x0028   4         u32        link  little
  @0x002c   4         u32        info  little
  @0x0030   8         u64        addralign  little
  @0x0038   8         u64        entsize  little

struct section_table size=0..4194240
  parameter -         u16        count [stream]
  @0x0000   0..4194240 section_header entries  sized-by=count
