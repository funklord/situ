// TIFF header (TIFF 6.0), the byte-order-marker case.
//
// TIFF is the reason `endian_marker` is a first-class construct rather than a
// special case of `endian native` (project.md section 8.3). The first two bytes
// say which byte order the rest of the file uses, so endianness is resolved at
// parse time from a value in the data.
//
// The saving grace, and the reason this is cheap to support: endianness never
// changes extent. `offset` and `size` are untouched, so a byte-order-marked
// format costs nothing on the axes that matter most. What it costs is:
//
//   repr      := ConditionallyConverted(byte_order)  for every field in scope
//   canonical := CanonicalGiven(byte_order)
//
// and getters that return by value only, never by pointer.

target buffer;

endian_marker byte_order : u16 {
	little = 0x4949,        // "II"
	big    = 0x4D4D,        // "MM"
}

struct tiff_header [endian = from(byte_order)] {
	endian_marker  byte_order;
	u16            magic       [must_eq = 42];
	u32            ifd_offset;
}

require size(tiff_header) == 8;
require absolute_static(tiff_header);

// This is the distinction section 11.1 insists on. The format admits two
// encodings of the same value, so it is not canonical; but exactly one encoding
// is valid given the marker, and a writer always emits host order plus the
// matching marker, so the writer is deterministic.
//
// The consequence, stated as a rule: verify over received bytes, never over
// re-encoded bytes.
require deterministic_writer(tiff_header);
assert canonical(tiff_header);           // reports CanonicalGiven(byte_order)
require in_place(tiff_header.ifd_offset);

// The generated header carries, per marker, the two literals, a host-order
// constant resolved at compile time, and the accessors a writer needs:
//
//     #define SITU_TIFFHEADER_BYTE_ORDER_HOST  SITU_TIFFHEADER_BYTE_ORDER_LITTLE
//     static inline int      situ_TiffHeader_byte_order_is_little(situ_view_t);
//     static inline uint16_t situ_TiffHeader_byte_order_host(void);
//     static inline void     situ_TiffHeader_byte_order_set_host(situ_view_t);
//
// The marker itself is compared as a byte sequence rather than decoded as a
// number: it has to be readable before its own byte order is known.

// The first image file directory, where `ifd_offset` puts it (TIFF 6.0
// section 2). Every entry is in the header's byte order, which a directory
// holds no marker of its own to say: it is handed the header's, as an
// argument (26.961, 26.968).
//
// `value` is four bytes whose meaning `type` and `count` decide. A SHORT
// (type 3) sits in the first two, left-justified in either byte order, so
// it is two `u16`s rather than a `u32` -- read as one, a big-endian file's
// width of 3 is 196608. Everything else is read as the `u32` the field is:
// a LONG, or the offset of a value too big for four bytes.
struct ifd_entry [endian = from(order)] {
	parameter byte_order order [stream];
	u16 tag;
	u16 type;
	u32 count;
	variant value switch (type) {
		case 3:  u16 shorts[2];
		default: u32 long;
	}
}

struct ifd [endian = from(order)] {
	parameter byte_order order [stream];
	u16                       count;
	ifd_entry(order = order)  entries[count];
	u32                       next;
}

// The header and the directory it points to. The header alone stays
// `tiff_header`, fixed at eight bytes, which is what a reader meets first.
struct tiff_file [endian = from(byte_order)] {
	endian_marker            byte_order;
	u16                      magic       [must_eq = 42];
	u32                      ifd_offset;
	ifd(order = byte_order)  first       at ifd_offset;
}
