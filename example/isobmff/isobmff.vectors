# Golden vectors for the ISO base media worked example.
#
# Laid out by FFmpeg 7.1 (libavformat's mov muxer, libx264), never by situ:
# one black 16x16 frame, `-movflags +faststart` so `moov` precedes `mdat`.
#
#   ffmpeg -f lavfi -i color=c=black:s=16x16:d=0.04 -frames:v 1 \
#          -c:v libx264 -pix_fmt yuv420p -movflags +faststart one.mp4
#
# Its boxes are ftyp 32, moov 788, free 8, mdat 717. The two escapes are not
# something a 1.5 KB file needs, so they are written here from 14496-12
# section 4.2 and the files holding them were read back by ffprobe, which
# found the stream and the duration in both:
#
#   - a `free` box in the 64-bit form, `size = 1` and `largesize = 24`,
#     appended after `mdat` so no sample offset in `moov` moves;
#   - the same file with `mdat`, its last box, sized 0: "to the end".

# The file's first box: ftyp, 32 bytes, brand isom.
box ftyp 00 00 00 20 66 74 79 70 69 73 6F 6D 00 00 02 00 69 73 6F 6D 69 73 6F 32 61 76 63 31 6D 70 34 31
	size = 32
	kind = 1718909296

# A `free` box with its size in 64 bits.
box large 00 00 00 01 66 72 65 65 00 00 00 00 00 00 00 18 73 69 74 75 00 00 00 00
	size = 1
	kind = 1718773093
	body.large.largesize = 24

