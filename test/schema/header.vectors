# Golden vectors for example 5.1.
#
# Each case is a struct, a name, and the exact bytes. The expectations below a
# case are what the generated getters must return; the generated test also
# round-trips every field back through its setter and requires the buffer
# unchanged.

header  basic  01 02 E8 05 DC DE AD BE EF
	version = 1
	type    = SITU_MSG_TYPE_DATA
	length  = 1500
	seq     = 0xDEADBEEFu

header  minimum  01 01 00 00 00 00 00 00 00
	version = 1
	type    = SITU_MSG_TYPE_HELLO
	length  = 0
	seq     = 0

header  max_length  01 03 F8 05 DC FF FF FF FF
	length  = 1500
	seq     = 0xFFFFFFFFu

flags   flags_all_set  F8
	urgent   = 1
	ack      = 1
	priority = 7
