# situ wire signature v1
# schema: edges.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

bit_order msb_first
endian big
target buffer

varint edge_varint : be128 bits=64 bytes=9

enum signature : u8[2] unknown=error
  bmp="BM" pe="MZ"

enum dialect : u8 unknown=error
  plain=1 extended=2

enum arm_kind : u8 unknown=error
  first=17 second=34

enum arm_shape : u8 unknown=error
  counted=17 fixed=34 bytes=51

struct arithmetic size=14..43
  @0x0000   1         u8         units  min=1 max=4
  @0x0001   1..3      u8         halved  sized-by=units/2+1
  ~         1..3      u8         modulo  sized-by=units%3+1
  ~         2..8      u8         shifted  big sized-by=units<<1
  ~         1..3      u8         dropped  sized-by=units>>1|1
  ~         1..4      u8         masked  sized-by=(units&3)+1
  ~         1..8      u8         flipped  sized-by=(units^1)+1
  ~         1..3      u8         clamped  sized-by=min(units,3)
  ~         2..4      u8         raised  big sized-by=max(units,2)
  ~         1..4      u8         padded  sized-by=align_up(units,4)-units+1
  ~         2         u16        tail  big

struct arm_run size=2..8
  @0x0000   1         arm_shape  which
  @0x0001   1         u8         n  max=3
  @0x0002   0..6      variant    body
  body switch: which
  body case 17: wide u16
  body case 34: pinned i16
  body case 51: raw u8

struct beacon size=3
  @0x0000   2         u16        seq  big
  @0x0002   1         u8         flags

struct beat size=2
  @0x0000   1         u8         kind
  @0x0001   1         u8         payload

struct beats size=4..14
  @0x0000   2..12     beat       pulse  big while=kind==0x33 while-max=6
  ~         2         u16        after  big

struct coded_run size=2..512
  @0x0000   1         u8         n
  @0x0001   0..510    doubling   body  codec=doubling
  ~         1         u8         trailer

struct constrained size=1..5 version=rev
  @0x0000   1         u8         rev
  @0x0001   2         u16        magic  big since=2 must_eq=0x1234
  @0x0003   1         dialect    how  since=3
  @0x0004   1         u8         pad  since=3 must_eq=0

struct covered_tail size=8..12
  @0x0000   1         u8         n  max=4
  @0x0001   0..4      u8         pad  sized-by=n
  ~         3         beacon     head  big
  ~         4         u8         mac
  mac covers: body head flags seq

struct derived size=13
  @0x0000   2         u16        total  big
  @0x0002   1         u8         a
  @0x0003   4         u32        b  big
  @0x0007   2         u16        sequence  big
  @0x0009   4         u8         tag
  tag covers: body sequence

struct edges size=27
  @0x0000   5bit      i5         trim  msb_first
  @0x0000:5 3bit      u3         scale  msb_first
  @0x0001   12bit     i12        offset  big msb_first
  @0x0002:4 4bit      u4         channel  msb_first
  @0x0003   8         u16        samples  big
  @0x000b   8         i32        deltas  big
  @0x0013   4         u8         sig  big must_eq="WOZ2"
  @0x0017   2         u8         <reserved0>  big
  @0x0019   2         signature  kind  big

struct equalized size=11
  @0x0000   1         arm_kind   which
  @0x0001   8         variant    body
  @0x0009   2         u16        tail  big
  body switch: which
  body case 17: tiny u8
  body case 34: big u8

struct escaped_run size=1..
  @0x0000   until:2c  u8         field  escape=0x5c cap=64
  ~         0..       u8         rest  sized-by=remaining

struct framed size=9..
  @0x0000   4         u8         magic  big
  @0x0004   until:0d0a u8         version  big cap=16
  ~         until:00  u8         label
  ~         2         u16        count  big

struct framed_tail size=6..10
  @0x0000   1         u8         n  max=4
  @0x0001   0..4      u8         pad  sized-by=n
  ~         3         beacon     head  big
  ~         2         u16        tail  big

struct hop size=2
  @0x0000   1         u8         kind
  @0x0001   1         u8         value

struct hops size=6..
  @0x0000   2..       hop        step  big while=remaining>4
  ~         2         u16        trail  big
  ~         2         u16        mark  big

struct hp_packet size=6
  @0x0000   1         u8         first
  @0x0001   1         masking    pn  codec=masking
  @0x0002   4         u32        rest  big
  pn covers: pn first

struct hp_split size=10
  @0x0000   1         u8         first
  @0x0001   4         u32        cid  big
  @0x0005   1         masking    pn  codec=masking
  @0x0006   4         u32        rest  big
  pn covers: pn first

struct keywords size=10
  @0x0000   4         u32        int  big
  @0x0004   2         u16        short  big
  @0x0006   1         u8         class
  @0x0007   1         u8         type
  @0x0008   1         u8         match
  @0x0009   1         u8         lambda

struct kv size=4..
  @0x0000   until:3a20 u8         key  big
  ~         until:0d0a u8         value  big

struct kv_block size=2..
  @0x0000   until:0d0a kv         entries  big
  ~         0..       u8         payload  sized-by=remaining

struct labelled size=22
  @0x0000   16        u8         name  big nul_terminated encoding=utf8
  @0x0010   4         u8         code  big encoding=ascii
  @0x0014   2         u16        sequence  big

struct link size=4..1024
  @0x0000   1         u8         kind
  @0x0001   1         u8         units
  @0x0002   2..1022   u8         body  big sized-by=(units+1)*4-2

struct linked size=4..
  @0x0000   4..6144   link       chain  big while=kind==0x11||kind==0x22 while-max=6
  ~         0..       u8         tail  sized-by=remaining

struct marked size=5..17
  @0x0000   2         edge_order edge_order
  @0x0002   1         u8         n  endian-from=edge_order max=4
  @0x0003   0..4      u8         pad  endian-from=edge_order sized-by=n
  ~         2         u16        after  endian-from=edge_order
  ~         0..8      u16        samples  endian-from=edge_order sized-by=n

struct messy size=3..
  @0x0000   until:3a  u8         name  fold-case
  ~         until:0d0a u8         value  big trim

struct packed_driver size=3..63
  @0x0000   4bit      u4         hi  msb_first
  @0x0000:4 4bit      u4         n  msb_first
  @0x0001   0..60     u32        d  sized-by=n
  ~         2         u16        tail  big

struct pinned size=19
  @0x0000   1         u8         used  max=16
  @0x0001   16        u8         body  big sized-by=used
  @0x0011   2         u16        trailer  big

struct placed size=7
  @0x0000   2         u16        first  big
  @0x0002   4         u32        second  big
  @0x0006   1         u8         after

struct placed_run size=9..264
  @0x0000   1         u8         n
  @0x0001   0..255    u8         body  sized-by=n
  ~         2         u8         label  big
  ~         4         u16        marks  big
  ~         2         u16        tag  big

struct quoted_row size=1..
  @0x0000   until:2c  u8         field  quote=0x22
  ~         0..       u8         rest  sized-by=remaining

struct ranged_code size=1..
  @0x0000   until:20  u32        code  radix=10 cap=4 min=200 max=599
  ~         0..       u8         rest  sized-by=remaining

struct scrambled size=7
  @0x0000   1         u8         head
  @0x0001   4         scramble   body  codec=scramble
  @0x0005   2         u16        tail  big

struct sealed_run size=19..27
  @0x0000   1         u8         n  max=4
  @0x0001   2..10     sealing_aead body  codec=sealing_aead
  ~         16        u8         seal_mac
  seal_mac covers: body trailer vals

struct segment size=1..256
  @0x0000   1         u8         length
  @0x0001   0..255    u8         body  sized-by=length

struct segments size=3..65283
  @0x0000   1         u8         count
  @0x0001   0..65280  segment    parts  sized-by=count
  ~         2         u16        after  big

struct shadowing size=20
  @0x0000   4         u32        base  big
  @0x0004   4         u32        limit  big
  @0x0008   4         u32        raw  big
  @0x000c   4         u8         bytes  big
  @0x0010   4         u32        str  big

struct text_driver size=6..14
  @0x0000   4         u32        n  big radix=10 max=4
  @0x0004   0..8      u16        d  sized-by=n
  ~         2         u16        tail  big

struct texty size=2..65543
  @0x0000   until:0d0a u16        count  big radix=10 cap=8
  ~         0..65535  u8         body  sized-by=count

struct two_tags size=23
  @0x0000   1         u8         hop
  @0x0001   1         u8         kind
  @0x0002   4bit      u4         <reserved0>  msb_first must_be_one
  @0x0002:4 4bit      u4         flags  msb_first
  @0x0003   16        u8         tag
  @0x0013   2         u16        sequence  big
  @0x0015   2         u8         checksum
  tag covers: <reserved0> flags inner kind
  checksum covers: outer sequence

struct unknown_reserved size=4
  @0x0000   1         u8         version
  @0x0001   1         u8         <reserved0>
  @0x0002   2         u16        tail  big

struct unverified size=19
  @0x0000   1         u8         hop
  @0x0001   2         sealing_aead body  codec=sealing_aead
  @0x0003   16        u8         mac
  mac covers: body seq

struct varint_driver size=5..36893488147419103243
  @0x0000   1..9      edge_varint n  varint=edge_varint
  ~         2..36893488147419103232 u16        d  big sized-by=n+1
  ~         2         u16        tail  big

struct versioned size=3..9 version=ver
  @0x0000   1         u8         ver
  @0x0001   2         u16        length  big
  @0x0003   4         u32        flags  big since=2
  @0x0007   2         u16        extra  big since=3

struct wide_run size=7..31
  @0x0000   1         u8         n  max=4
  @0x0001   0..8      u16        a  sized-by=n
  ~         4..20     i32        b  big sized-by=n+1
  ~         2         u16        tail  big

struct wire::framed_body size=3
  @0x0000   1         u8         kind
  @0x0001   2         u16        length  big
