// A type library for `importer.situ` to import.
//
// `import` had no schema in this corpus at all, so the compile sweep, the
// differential, the four-way agreement and the walker comparison had never
// read an imported type -- which is how 26.559's link collision reached a
// consumer. This file and its importer are here so those sweeps read the
// construct (26.568).
//
// It carries constraints on purpose: `check` and `validate` are the two
// generated functions with external linkage, so a shared type with nothing
// to check would be a fixture that cannot show that fault.

target buffer;
endian big;

struct str {
	u16  len [max = 255];
	u8   v[len];
}

struct stamp {
	u32  seconds [min = 1];
	u16  millis [max = 999];
}

// A mutually recursive pair, which `importer.situ` names so that every
// sweep reads one ACROSS AN IMPORT.
//
// hull reported the shape from its own frontend protocol: `form`'s `check`
// calls `list`'s `validate` -- a variant arm is a struct, and validating
// the arm is validating that struct -- `list` is emitted after `form`, and
// an importing schema emits the pair in the order that puts the call ahead
// of the declaration. The generated C would not compile: an implicit
// declaration and then a conflicting type (26.679).
//
// The pair ALONE compiled, which is what said it was the emission order
// rather than the pair. This corpus had an import fixture and a recursion
// fixture and never the two together, so no sweep could reach it -- which
// is 26.675's finding in a second place.
struct branch [depth = 8] {
	peek u8  tag;
	variant body switch (tag) {
		case '[':  twig  as_twig;
		default:   u8    as_byte;
	}
}

struct twig [depth = 8] {
	u8      open;
	branch  items[]  until "]";
}
