// Constructs the example protocols happen not to use.
//
// Mutation testing found these by the only symptom they have: a deliberate bug
// in the generator for each one changed nothing that any test compiled, because
// no schema in the tree reached the code path at all. A construct the language
// offers and nothing exercises is a construct whose generated code has never
// run, so this file exists to reach them rather than to describe a protocol.
//
// Each member notes what it is here to keep honest.

target buffer;
endian big;
bit_order msb_first;

struct edges [allow_straddle] {
	// A signed bit-packed field. Every signed field in the examples is a whole
	// number of bytes, so `situ_sign_extend` on the bit-packed path was emitted
	// and never executed: dropping it entirely left the suite green.
	i5   trim;
	u3   scale;

	// A signed field spanning a byte boundary, where the sign bit and the low
	// bits come from different bytes.
	i12  offset;
	u4   channel;

	// Elements wider than a byte, which are ValueConverted and therefore
	// reached by index rather than by pointer. The stride in that accessor was
	// free to drift by any amount.
	u16  samples[4];

	// The same, signed, so element addressing and sign extension are exercised
	// together rather than one masking the other.
	i32  deltas[2];
}

require size(edges) == 19;
require in_place(edges.trim);
require in_place(edges.channel);

// Two tags in one struct, which is what makes a per-struct dirty mask mean
// anything. With one tag the mask equals that tag's own bit, so nothing needs
// it and nothing noticed when a deliberate off-by-one made it wrong.
//
// Also the only `must_be_one` in the tree. `must_be_zero` is the default and
// every example uses it; the other policy shares its code path and had never
// executed.
struct two_tags {
	u8  hop;

	authenticated inner {
		u8        kind;
		reserved  u4  [must_be_one];
		u4        flags;
	}
	tag u8[16] covers(inner);

	authenticated outer {
		u16  sequence;
	}
	checksum u8[2] covers(outer);
}

require size(two_tags) == 23;

// Text with the two attributes section 8.6 offers, which no protocol here uses
// and which were both parsed and dropped on the floor until they were not.
//
// `nul_terminated` reads the declared size as the capacity: the field is
// sixteen bytes whatever it holds, and the content runs to the first zero. So
// the bytes past the terminator are not part of the value, two buffers
// differing only there mean the same thing, and the field is NonCanonical --
// which the capability map says out loud rather than leaving to be discovered.
struct labelled {
	u8  name[16]  [nul_terminated, encoding = utf8];
	u8  code[4]   [encoding = ascii];
	u16 sequence;
}

require size(labelled) == 22;
require in_place(labelled.sequence);

// Recorded rather than required: the trailing bytes are the cost of a
// capacity-sized string, and the remedy would be to zero them on write and
// demand it on parse.
assert canonical(labelled.name);

// A derived field, in a struct that also carries a tag.
//
// Both kinds of obligation share one dirty word (section 16.1), and nothing
// else in the tree carries both, so the two numberings were free to disagree
// and did: the C backend counted invariants after its tags, the Python backend
// numbered from a list of tags alone and fell back to bit 0 for anything else,
// which is the tag's bit.
//
// `a` and `b` are scalars on purpose. The first invariant written derived from
// a nested struct and an array, neither of which gets a setter, so the covered
// setter path -- the one that pastes a `covered_by` entry into an identifier --
// was never reached. It emitted `SITU_S_INVARIANT TOTAL_DIRTY`, a macro name
// with a space in it, and no test compiled it.
struct derived {
	u16  total;
	u8   a;
	u32  b;

	authenticated body {
		u16  sequence;
	}
	tag u8[4] covers(body);
}

require size(derived) == 13;
invariant derived.total == size(derived.a) + size(derived.b);

// Delimiter-framed members, and a frame that mixes them with placed ones.
//
// The construct section 8.6.1 adds. Here rather than in an example protocol
// because the point is the *mixture*: `magic` keeps a static offset, `count`
// is an ordinary big-endian u16 that has lost one, and the map has to say so.
//
// `version` is capped and `label` is not, which is the difference between
// Bounded and Unbounded and between Pure and EffectOnRead on the same
// construct.
struct framed {
	u8   magic[4];
	u8   version[] until "\r\n" max 16;
	u8   label[]   until "\0";
	u16  count;
}

// A delimiter the content may contain, which is the other half of 8.6.1 and
// the only thing in the tree that is NonCanonical for that reason.
struct quoted_row {
	u8  field[] until "," [quoted = "\""];
	u8  rest[remaining];
}

// A text number driving a binary payload: the shape that motivated section
// 8.6.1 in the first place, and the only place in the tree where an array's
// length comes from digits rather than bits. Loading it as an integer read
// the ASCII: "10" came out as 0x3130, which is the kind of wrong that
// produces a plausible number.
struct texty {
	decimal  u16  count until "\r\n" max 8;
	u8            body[count];
}

// A run of records ending where a terminator stands in for one. The only
// construct in the tree where the delimiter is *not* looked for anywhere: a
// CRLF inside a header line belongs to that line, and treating this as a
// delimited byte array found the first one and stopped there.
struct kv {
	u8  key[]   until ": ";
	u8  value[] until "\r\n";
}

struct kv_block {
	kv  entries[] until "\r\n";
	u8  payload[remaining];
}

// Optional whitespace and a case-insensitive token: the two attributes that
// separate what a delimited member *frames* from what it *means*. `value`
// spans its whitespace -- members partition their struct exactly -- and
// carries only what is left of it.
struct messy {
	u8  name[]  until ":"    [case_insensitive];
	u8  value[] until "\r\n" [trim];
}
