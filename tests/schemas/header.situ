// project.md example 5.1: the static header.
//
// The phase 1 acceptance schema. Every construct here is in the static subset,
// and `situc dump-ast` must round-trip it exactly.
//
// DIVERGENCE FROM project.md. The example as printed asserts `seq @ 0x06` and
// `size(Header) == 10`. Both are off by one. The declared fields are
//
//     version  u8       1 byte    at 0
//     type     MsgType  1 byte    at 1   (enum : u8)
//     flags    Flags    1 byte    at 2   (1 + 1 + 3 + 3 = 8 bits)
//     length   u16      2 bytes   at 3
//     seq      u32      4 bytes   at 5
//
// which totals 9 bytes with `seq` at 0x05. Reaching 0x06 and 10 would need a
// padding byte, and section 8.4 is explicit that situ inserts none: layout is
// exactly as declared.
//
// The field list below is verbatim from the document; only the pin and the size
// requirement are corrected, so the layout this describes is unchanged and the
// capability map is the one example 5.1 was always going to produce.

target buffer;
endian big;
bit_order msb_first;

const MAX_PAYLOAD = 1500;

enum MsgType : u8 {
	hello = 0x01,
	data  = 0x02,
	close = 0x03,
}

struct Flags {
	bit  urgent;
	bit  ack;
	u3   priority;
	reserved u3 [must_be_zero];
}

struct Header {
	u8       version  [must_eq = 1];
	MsgType  type;
	Flags    flags;
	u16      length   [max = MAX_PAYLOAD];
	u32      seq      @ 0x05;          // pin: assert solver agrees
}

require size(Header) == 9;
require absolute_static(Header);
require in_place(Header.seq);
