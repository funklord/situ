#!/usr/bin/env python3
"""situ-edit -- read a message against a situ schema or packed image.

The reference frontend of decision 0034, and its test harness. Nothing the
TUI or the GUI can do may be absent here: an interactive frontend is hard to
test and a scriptable one is not, so this is what keeps the other two
testable, and it is what lets CI ask whether a capture still conforms.

Reads, and writes what the schema permits. The write path was deferred in
0034 and built in 26.179: `--set name=value` stores a value where `mutate`
allows one and refuses where it does not, and nothing reaches the file
without `--out`.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

def _package_root() -> Path | None:
	"""Where `import editor` and `import walker` work from, or None.

	Two candidates, and the same two `bin/situc` has checked all along: in
	the tree this script is `<tree>/bin/situ-edit` and the packages are
	`<tree>/editor` and `<tree>/walker`, while `make install` puts the script
	in `<prefix>/bin` and both packages in `<prefix>/lib`. The earlier version
	took `parent.parent` and stopped, so from `/usr/bin/situ-edit` it looked in
	`/usr/editor` and found nothing -- **every installed copy broken by
	construction**, reported by `raidcfgd` on 2026-10-02 after its README had
	documented the command (26.554).

	Symlinks resolve first, so a link in `~/.local/bin` still finds the tree
	it points into. A candidate counts only if the package's `__init__.py` is
	really there, which separates "not installed" from "installed elsewhere".
	"""
	here = Path(__file__).resolve().parent
	for candidate in (here.parent, here.parent / "lib"):
		if (candidate / "editor" / "__init__.py").is_file():
			return candidate
	return None


#: The `situc` binary, which `open_from` runs to pack the schema into an
#: image. Always beside this script -- `<tree>/bin/situc` in the tree and
#: `<prefix>/bin/situc` installed -- which is what the old `HERE / "bin" /
#: "situc"` computed correctly in both layouts and is the one thing it got
#: right. Resolving the symlink first means a link in `~/.local/bin` finds
#: the `situc` of the tree it points into rather than one on PATH.
_SITUC = Path(__file__).resolve().parent / "situc"


_root = _package_root()
if _root is not None and str(_root) not in sys.path:
	sys.path.insert(0, str(_root))

try:
	from editor.document import Document		# noqa: E402
	from editor.text import as_json, open_from, render	# noqa: E402
	from walker.walk import Refused			# noqa: E402
except ImportError as _why:			# pragma: no cover - a layout fault
	sys.stderr.write(
		f"situ-edit: cannot find situ's editor packages ({_why}).\n"
		"       Expected them beside this script as <dir>/../editor and\n"
		"       <dir>/../walker, or installed as <prefix>/lib/editor and\n"
		"       <prefix>/lib/walker. Run it from situ's source tree, or\n"
		"       `make install` and run the installed copy.\n")
	raise SystemExit(1)


def build_parser() -> argparse.ArgumentParser:
	parser = argparse.ArgumentParser(
		prog="situ-edit",
		description="read a message against a situ schema or packed image")
	parser.add_argument("schema", type=Path,
	                    help="a .situ schema, or a packed image")
	parser.add_argument("message", type=Path, help="the bytes to read")
	parser.add_argument("--struct", default=None,
	                    help="which layout to read it as (default: the first)")
	parser.add_argument("--offset", type=int, default=0, metavar="N",
	                    help="where the struct starts in the file. A chunked "
	                         "container -- a PNG, an ID3 tag, a TIFF -- holds "
	                         "its structs at offsets, and a nested member's "
	                         "note gives the one to pass")
	parser.add_argument("--length", type=int, default=None, metavar="N",
	                    help="how long its frame is, defaulting to the rest "
	                         "of the file. It decides what `[remaining]` "
	                         "reaches and where a run that walks to the end "
	                         "of the frame stops, so a self-sizing struct "
	                         "needs no length and one framed by its caller "
	                         "does")
	# A RELATION IS OVER TWO MESSAGES (26.95), so it takes a second file.
	# `walker.report.relate` has existed since 26.95 with no caller outside
	# its own tests, and 0034 names this tool as what a read-only editor is
	# worth shipping with -- *follow a relation between two messages* being
	# one of the five things it lists (26.594).
	parser.add_argument("--relate", metavar="NAME",
	                    help="check a cross-message relation by name; needs "
	                         "--against for the second message, which is the "
	                         "LATER of the two since the order is temporal")
	parser.add_argument("--against", type=Path, metavar="FILE",
	                    help="the second message a --relate check reads, "
	                         "opened as the struct the relation names")
	parser.add_argument("--hex", action="store_true",
	                    help="the message file holds hex rather than bytes")
	parser.add_argument("--format", choices=("text", "json"), default="text",
	                    help="json is for a frontend that is not Python, and "
	                         "is how the Qt window reads a document without "
	                         "a second copy of the model")
	parser.add_argument("--set", action="append", default=[],
	                    metavar="NAME=VALUE", dest="assignments",
	                    help="store a value, where the schema permits one. "
	                         "Decimal, or 0x for hex. Repeatable, applied in "
	                         "order")
	parser.add_argument("--set-bytes", action="append", default=[],
	                    metavar="NAME=HEX", dest="byte_assignments",
	                    help="store a byte run, at the length it already has. "
	                         "A run written shorter or longer moves what "
	                         "follows it, which is a shifting write")
	parser.add_argument("--out", type=Path, default=None,
	                    help="write the edited message here. Without it "
	                         "nothing is written anywhere: an edit is shown "
	                         "and discarded, which is the safe default for a "
	                         "tool that edits files in place")
	return parser


def apply_edits(document: object, assignments: list[str],
		byte_assignments: list[str]) -> list[str]:
	"""Every `--set` then every `--set-bytes`, returning what each one cost.

	In order, and stopping at the first refusal: a half-applied edit written
	to a file is worse than none, and a reader of the output has to be able
	to say which writes happened.
	"""
	notes: list[str] = []

	for assignment in assignments:
		name, sep, text = assignment.partition("=")
		if not sep:
			raise Refused(f"`--set {assignment}` is not `name=value`")
		try:
			value = int(text, 0)
		except ValueError:
			raise Refused(f"`--set {assignment}`: `{text}` is not a number") \
				from None
		notes.extend(document.set(name.strip(), value))	# type: ignore[attr-defined]

	for assignment in byte_assignments:
		name, sep, text = assignment.partition("=")
		if not sep:
			raise Refused(f"`--set-bytes {assignment}` is not `name=hex`")
		try:
			raw = bytes.fromhex(text.strip())
		except ValueError:
			raise Refused(f"`--set-bytes {assignment}`: `{text}` is not "
			              f"hex") from None
		notes.extend(document.set(name.strip(), raw))	# type: ignore[attr-defined]

	return notes


def _response_struct(document: Document, which: str) -> str | None:
	"""Which struct the named relation takes SECOND.

	Opened for the caller rather than asked of them: the relation already
	says what its response is, and making somebody pass `--struct` for the
	second message would be asking them to repeat the schema back.
	"""
	image = document.image
	for index in range(len(image.relations)):
		if image.relation_name(index) == which:
			return image.struct_name(image.relations[index].response)
	return None


def main() -> int:
	args = build_parser().parse_args()
	try:
		document = open_from(args.schema, args.message, _SITUC,
		                     args.struct, args.hex,
		                     args.offset, args.length)
	except Refused as why:
		print(f"situ-edit: {why}", file=sys.stderr)
		return 1

	try:
		notes = apply_edits(document, args.assignments,
		                    args.byte_assignments)
	except Refused as why:
		print(f"situ-edit: {why}", file=sys.stderr)
		return 1

	# THE RELATION, before the listing, because it is the question the
	# caller asked and the tree is context for it (26.594).
	if args.relate is not None:
		if args.against is None:
			print("situ-edit: --relate needs --against FILE, since a "
			      "relation is a predicate over two messages",
			      file=sys.stderr)
			return 1
		try:
			second = open_from(args.schema, args.against, _SITUC,
			                   _response_struct(document, args.relate),
			                   args.hex)
			held, why = document.relate(args.relate, second)
		except Refused as why_not:
			print(f"situ-edit: {why_not}", file=sys.stderr)
			return 1
		print(f"{why}: {'holds' if held else 'does not hold'}")

	print(as_json(document) if args.format == "json"
	      else "\n".join(render(document)))
	for note in notes:
		print(f"situ-edit: {note}", file=sys.stderr)

	if args.out is not None:
		# THE WHOLE BUFFER, not the window. A document opened at an offset
		# holds the file it came from, and writing only the window out
		# would turn an edit of one PNG chunk into a file holding nothing
		# but that chunk. The edit landed in place; what is written is the
		# file with it in.
		args.out.write_bytes(bytes(document.buffer))
	elif args.assignments or args.byte_assignments:
		print("situ-edit: not written; pass --out to keep it",
		      file=sys.stderr)
	return 0


if __name__ == "__main__":
	sys.exit(main())
