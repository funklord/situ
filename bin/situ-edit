#!/usr/bin/env python3
"""situ-edit -- read a message against a situ schema or packed image.

The reference frontend of decision 0034, and its test harness. Nothing the
TUI or the GUI can do may be absent here: an interactive frontend is hard to
test and a scriptable one is not, so this is what keeps the other two
testable, and it is what lets CI ask whether a capture still conforms.

Reads, and writes what the schema permits. The write path was deferred in
0034 and built in 26.179: `--set name=value` stores a value where `mutate`
allows one and refuses where it does not, and nothing reaches the file
without `--out`.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
if str(HERE) not in sys.path:
	sys.path.insert(0, str(HERE))

from editor.text import as_json, open_from, render	# noqa: E402
from walker.walk import Refused			# noqa: E402


def build_parser() -> argparse.ArgumentParser:
	parser = argparse.ArgumentParser(
		prog="situ-edit",
		description="read a message against a situ schema or packed image")
	parser.add_argument("schema", type=Path,
	                    help="a .situ schema, or a packed image")
	parser.add_argument("message", type=Path, help="the bytes to read")
	parser.add_argument("--struct", default=None,
	                    help="which layout to read it as (default: the first)")
	parser.add_argument("--hex", action="store_true",
	                    help="the message file holds hex rather than bytes")
	parser.add_argument("--format", choices=("text", "json"), default="text",
	                    help="json is for a frontend that is not Python, and "
	                         "is how the Qt window reads a document without "
	                         "a second copy of the model")
	parser.add_argument("--set", action="append", default=[],
	                    metavar="NAME=VALUE", dest="assignments",
	                    help="store a value, where the schema permits one. "
	                         "Decimal, or 0x for hex. Repeatable, applied in "
	                         "order")
	parser.add_argument("--set-bytes", action="append", default=[],
	                    metavar="NAME=HEX", dest="byte_assignments",
	                    help="store a byte run, at the length it already has. "
	                         "A run written shorter or longer moves what "
	                         "follows it, which is a shifting write")
	parser.add_argument("--out", type=Path, default=None,
	                    help="write the edited message here. Without it "
	                         "nothing is written anywhere: an edit is shown "
	                         "and discarded, which is the safe default for a "
	                         "tool that edits files in place")
	return parser


def apply_edits(document: object, assignments: list[str],
		byte_assignments: list[str]) -> list[str]:
	"""Every `--set` then every `--set-bytes`, returning what each one cost.

	In order, and stopping at the first refusal: a half-applied edit written
	to a file is worse than none, and a reader of the output has to be able
	to say which writes happened.
	"""
	notes: list[str] = []

	for assignment in assignments:
		name, sep, text = assignment.partition("=")
		if not sep:
			raise Refused(f"`--set {assignment}` is not `name=value`")
		try:
			value = int(text, 0)
		except ValueError:
			raise Refused(f"`--set {assignment}`: `{text}` is not a number") \
				from None
		notes.extend(document.set(name.strip(), value))	# type: ignore[attr-defined]

	for assignment in byte_assignments:
		name, sep, text = assignment.partition("=")
		if not sep:
			raise Refused(f"`--set-bytes {assignment}` is not `name=hex`")
		try:
			raw = bytes.fromhex(text.strip())
		except ValueError:
			raise Refused(f"`--set-bytes {assignment}`: `{text}` is not "
			              f"hex") from None
		notes.extend(document.set(name.strip(), raw))	# type: ignore[attr-defined]

	return notes


def main() -> int:
	args = build_parser().parse_args()
	try:
		document = open_from(args.schema, args.message, HERE / "bin" / "situc",
		                     args.struct, args.hex)
	except Refused as why:
		print(f"situ-edit: {why}", file=sys.stderr)
		return 1

	try:
		notes = apply_edits(document, args.assignments,
		                    args.byte_assignments)
	except Refused as why:
		print(f"situ-edit: {why}", file=sys.stderr)
		return 1

	print(as_json(document) if args.format == "json"
	      else "\n".join(render(document)))
	for note in notes:
		print(f"situ-edit: {note}", file=sys.stderr)

	if args.out is not None:
		args.out.write_bytes(bytes(document.buffer))
	elif args.assignments or args.byte_assignments:
		print("situ-edit: not written; pass --out to keep it",
		      file=sys.stderr)
	return 0


if __name__ == "__main__":
	sys.exit(main())
