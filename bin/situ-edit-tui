#!/usr/bin/env python3
"""situ-edit-tui -- the same document, on a terminal.

A frontend and nothing else: every question it asks is `editor.document`'s,
and it holds no rule about what a field costs or what a write would mean.
The CLI can do everything this can, which is 0034's rule and what keeps this
testable -- the parts worth testing are in the core, and the core is what the
CLI drives.

`curses` is in the standard library, so this keeps the no-dependency
property. Only the GUI takes a third-party dependency, in its own binary.
"""

from __future__ import annotations

import argparse
import curses
import sys
from pathlib import Path

def _package_root() -> Path | None:
	"""Where `import editor` and `import walker` work from, or None.

	Two candidates, and the same two `bin/situc` has checked all along: in
	the tree this script is `<tree>/bin/situ-edit-tui` and the packages are
	`<tree>/editor` and `<tree>/walker`, while `make install` puts the script
	in `<prefix>/bin` and both packages in `<prefix>/lib`. The earlier version
	took `parent.parent` and stopped, so from `/usr/bin/situ-edit-tui` it looked in
	`/usr/editor` and found nothing -- **every installed copy broken by
	construction**, reported by `raidcfgd` on 2026-10-02 after its README had
	documented the command (26.554).

	Symlinks resolve first, so a link in `~/.local/bin` still finds the tree
	it points into. A candidate counts only if the package's `__init__.py` is
	really there, which separates "not installed" from "installed elsewhere".
	"""
	here = Path(__file__).resolve().parent
	for candidate in (here.parent, here.parent / "lib"):
		if (candidate / "editor" / "__init__.py").is_file():
			return candidate
	return None


#: The `situc` binary, which `open_from` runs to pack the schema into an
#: image. Always beside this script -- `<tree>/bin/situc` in the tree and
#: `<prefix>/bin/situc` installed -- which is what the old `HERE / "bin" /
#: "situc"` computed correctly in both layouts and is the one thing it got
#: right. Resolving the symlink first means a link in `~/.local/bin` finds
#: the `situc` of the tree it points into rather than one on PATH.
_SITUC = Path(__file__).resolve().parent / "situc"


_root = _package_root()
if _root is not None and str(_root) not in sys.path:
	sys.path.insert(0, str(_root))

try:
	from editor.document import Document		# noqa: E402
	from editor.text import open_from, render	# noqa: E402
	from walker.walk import Refused, Unsupplied	# noqa: E402
except ImportError as _why:			# pragma: no cover - a layout fault
	sys.stderr.write(
		f"situ-edit-tui: cannot find situ's editor packages ({_why}).\n"
		"       Expected them beside this script as <dir>/../editor and\n"
		"       <dir>/../walker, or installed as <prefix>/lib/editor and\n"
		"       <prefix>/lib/walker. Run it from situ's source tree, or\n"
		"       `make install` and run the installed copy.\n")
	raise SystemExit(1)


def rows(document: Document) -> list[str]:
	"""The same lines the CLI prints, because they are the same document."""
	return render(document)


def _draw(screen: "curses._CursesWindow", document: Document) -> None:
	lines = rows(document)
	top   = 0

	while True:
		screen.erase()
		height, width = screen.getmaxyx()
		for row, line in enumerate(lines[top:top + height - 1]):
			screen.addnstr(row, 0, line, width - 1)
		screen.addnstr(height - 1, 0,
		               "  up/down  q quit  --  read-only (decision 0034)",
		               width - 1, curses.A_REVERSE)
		screen.refresh()

		key = screen.getch()
		if key in (ord("q"), ord("Q"), 27):
			return
		if key in (curses.KEY_DOWN, ord("j")):
			top = min(top + 1, max(0, len(lines) - 1))
		elif key in (curses.KEY_UP, ord("k")):
			top = max(top - 1, 0)


def main() -> int:
	parser = argparse.ArgumentParser(
		prog="situ-edit-tui",
		description="read a message against a situ schema, on a terminal")
	parser.add_argument("schema", type=Path)
	parser.add_argument("message", type=Path)
	parser.add_argument("--struct", default=None)
	# As `situ-edit`, because the interactive frontend is where somebody
	# follows a nested member's note (26.581). Wiring one and not the
	# other would leave the tool that tells you to open a struct at an
	# offset unable to, which is how this gap existed in the first place.
	parser.add_argument("--offset", type=int, default=0, metavar="N",
	                    help="where the struct starts in the file")
	parser.add_argument("--length", type=int, default=None, metavar="N",
	                    help="how long its frame is (default: to the end)")
	# As `situ-edit`, and for the reason the `--offset` comment above
	# already gives. 26.598 wired `--arg` into the CLI alone, so this
	# frontend went on printing a Python traceback for a struct that takes
	# an argument -- `Unsupplied` is not a `Refused` and the handler below
	# caught only the second. The comment twenty lines up was already the
	# argument against wiring one and not the other (26.603).
	parser.add_argument("--arg", action="append", default=[], type=int,
	                    metavar="N", dest="arguments",
	                    help="a value for one of the struct's `parameter` "
	                         "members, in declaration order")
	parser.add_argument("--hex", action="store_true")
	parser.add_argument("--no-ui", action="store_true",
	                    help="print what would be shown and exit, so this "
	                         "frontend is testable without a terminal")
	args = parser.parse_args()

	try:
		document = open_from(args.schema, args.message,
		                     _SITUC, args.struct, args.hex,
		                     args.offset, args.length, args.arguments)
	except Unsupplied as why:
		# Its own branch, as in `situ-edit`: the walker keeps `no-view` and
		# `needs-arguments` apart because reporting a caller who has not
		# chosen a layout as a frame too short is a verdict on bytes nobody
		# read.
		print(f"situ-edit-tui: {why}", file=sys.stderr)
		print("situ-edit-tui: pass --arg once per argument, in that order",
		      file=sys.stderr)
		return 1
	except Refused as why:
		print(f"situ-edit-tui: {why}", file=sys.stderr)
		return 1

	if args.no_ui:
		print("\n".join(rows(document)))
		return 0

	curses.wrapper(_draw, document)
	return 0


if __name__ == "__main__":
	sys.exit(main())
