#!/usr/bin/env python3
"""situ-edit-tui -- the same document, on a terminal.

A frontend and nothing else: every question it asks is `editor.document`'s,
and it holds no rule about what a field costs or what a write would mean.
The CLI can do everything this can, which is 0034's rule and what keeps this
testable -- the parts worth testing are in the core, and the core is what the
CLI drives. It edits: Enter on a field is `--set` (or `--set-bytes` for a
byte run) and `w` is `--out`, through the CLI's own `apply_edits`.

`curses` is in the standard library, so this keeps the no-dependency
property. Only the GUI takes a third-party dependency, in its own binary.
"""

from __future__ import annotations

import argparse
import curses
import sys
from pathlib import Path

def _package_root() -> Path | None:
	"""Where `import editor` and `import walker` work from, or None.

	Two candidates, and the same two `bin/situc` has checked all along: in
	the tree this script is `<tree>/bin/situ-edit-tui` and the packages are
	`<tree>/editor` and `<tree>/walker`, while `make install` puts the script
	in `<prefix>/bin` and both packages in `<prefix>/lib`. The earlier version
	took `parent.parent` and stopped, so from `/usr/bin/situ-edit-tui` it looked in
	`/usr/editor` and found nothing -- **every installed copy broken by
	construction**, reported by `raidcfgd` on 2026-10-02 after its README had
	documented the command (26.554).

	Symlinks resolve first, so a link in `~/.local/bin` still finds the tree
	it points into. A candidate counts only if the package's `__init__.py` is
	really there, which separates "not installed" from "installed elsewhere".
	"""
	here = Path(__file__).resolve().parent
	for candidate in (here.parent, here.parent / "lib"):
		if (candidate / "editor" / "__init__.py").is_file():
			return candidate
	return None


#: The `situc` binary, which `open_from` runs to pack the schema into an
#: image. Always beside this script -- `<tree>/bin/situc` in the tree and
#: `<prefix>/bin/situc` installed -- which is what the old `HERE / "bin" /
#: "situc"` computed correctly in both layouts and is the one thing it got
#: right. Resolving the symlink first means a link in `~/.local/bin` finds
#: the `situc` of the tree it points into rather than one on PATH.
_SITUC = Path(__file__).resolve().parent / "situc"


_root = _package_root()
if _root is not None and str(_root) not in sys.path:
	sys.path.insert(0, str(_root))

try:
	from editor.document import Document		# noqa: E402
	from editor import view	# noqa: E402
	from editor.text import (apply_edits, apply_splices,	# noqa: E402
	                         element_of, open_from, render, render_rows)
	from walker.walk import Refused, Unsupplied	# noqa: E402
except ImportError as _why:			# pragma: no cover - a layout fault
	sys.stderr.write(
		f"situ-edit-tui: cannot find situ's editor packages ({_why}).\n"
		"       Expected them beside this script as <dir>/../editor and\n"
		"       <dir>/../walker, or installed as <prefix>/lib/editor and\n"
		"       <prefix>/lib/walker. Run it from situ's source tree, or\n"
		"       `make install` and run the installed copy.\n")
	raise SystemExit(1)


def rows(document: Document) -> list[str]:
	"""The same lines the CLI prints, because they are the same document."""
	return render(document)


def _prompt(screen: "curses._CursesWindow", label: str) -> str | None:
	"""A line typed on the bottom row, or None for Escape."""
	height, width = screen.getmaxyx()
	typed = ""
	curses.curs_set(1)
	try:
		while True:
			screen.move(height - 1, 0)
			screen.clrtoeol()
			screen.addnstr(height - 1, 0, f"{label}{typed}", width - 1)
			screen.refresh()
			key = screen.get_wch()
			if key in ("\n", "\r", curses.KEY_ENTER):
				return typed
			if key == "\x1b":
				return None
			if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
				typed = typed[:-1]
			elif isinstance(key, str) and key.isprintable():
				typed += key
	finally:
		curses.curs_set(0)


def _draw(screen: "curses._CursesWindow", document: Document,
		out: Path | None) -> None:
	"""The listing, a cursor on one field, and the two acts the CLI has.

	Enter sets the field under the cursor and `w` writes the buffer to
	`--out` -- `--set` and `--out`, interactively. Nothing reaches a file
	without `--out`, as in the CLI: the message opened is never overwritten
	by a frontend deciding on the caller's behalf.

	Enter on a NESTED struct opens it, over the same buffer -- `--struct`
	and `--offset`, without leaving -- and `q` goes back out of it. An
	edit in a nested struct is in the one buffer `w` writes.

	`i` and `x` on a run of structs put an element in or take one out,
	asking where and what -- `--insert` and `--remove` (26.1147).
	"""
	curses.curs_set(0)
	cursor  = 0
	top     = 0
	status  = "read-write where the schema permits; Enter edits or opens"
	unsaved = False
	opened: list[tuple[Document, int]] = []	# where each level was left

	while True:
		lines  = render_rows(document)
		fields = [n for n, (_, owner) in enumerate(lines)
		          if owner is not None and
		          (n == 0 or lines[n - 1][1] != owner)]
		cursor = min(cursor, max(0, len(fields) - 1))
		here   = fields[cursor] if fields else 0

		screen.erase()
		height, width = screen.getmaxyx()
		body = height - 2
		if here < top:
			top = here
		elif here >= top + body:
			top = here - body + 1
		for row, (line, owner) in enumerate(lines[top:top + body]):
			chosen = fields and owner == lines[here][1]
			screen.addnstr(row, 0, line, width - 1,
			               curses.A_REVERSE if chosen else curses.A_NORMAL)
		screen.addnstr(height - 2, 0, status, width - 1, curses.A_BOLD)
		screen.addnstr(height - 1, 0,
		               "  up/down  Enter edit/open  i/x insert/remove  w write"
		               + (f" {out}" if out else " (needs --out)")
		               + "  q back/quit", width - 1, curses.A_REVERSE)
		screen.refresh()

		key = screen.getch()
		if key in (ord("q"), ord("Q"), 27) and opened:
			document, cursor = opened.pop()
			top    = 0
			status = f"back in {document.name}"
			continue
		if key in (ord("q"), ord("Q"), 27):
			if unsaved and status != "unsaved; q again to quit":
				status = "unsaved; q again to quit"
				continue
			return
		if key in (curses.KEY_DOWN, ord("j")):
			cursor = min(cursor + 1, max(0, len(fields) - 1))
		elif key in (curses.KEY_UP, ord("k")):
			cursor = max(cursor - 1, 0)
		elif key in (curses.KEY_ENTER, 10, 13, ord("e")) and fields:
			owner = lines[here][1]
			assert owner is not None
			field = document.fields()[owner]
			if field.nested is not None:
				# A run of several structs asks which element (26.1144):
				# opened whole it reads only the first.
				which = None
				if field.elements is not None and len(field.elements) > 1:
					typed = _prompt(screen, f"which of {field.name}'s "
					                f"{len(field.elements)} elements (0-"
					                f"{len(field.elements) - 1}): ")
					if typed is None or not typed.strip():
						status = "unchanged"
						continue
					try:
						which = int(typed.strip())
					except ValueError:
						status = f"`{typed.strip()}` is not an element number"
						continue
				try:
					inner = (document.open_nested(owner) if which is None
					         else document.open_element(owner, which))
				except (Refused, Unsupplied) as why:
					status = f"cannot open it: {why}"
					continue
				opened.append((document, cursor))
				document, cursor, top = inner, 0, 0
				status = (f"{inner.name} at {inner.at}, over the same "
				          f"bytes; q goes back")
				continue
			name  = field.name
			typed = _prompt(screen, view.prompt(view.rows(document)[owner]))
			if typed is None or not typed.strip():
				status = "unchanged"
				continue
			try:
				notes  = view.put(document, name, typed)
			except Refused as why:
				status = f"refused: {why}"
				continue
			unsaved = True
			status  = "; ".join(notes) if notes else f"{name} set"
		elif key in (ord("i"), ord("x")) and fields:
			owner = lines[here][1]
			assert owner is not None
			field = document.fields()[owner]
			if field.elements is None:
				status = f"`{field.name}` is not a run of structs"
				continue
			count = len(field.elements)
			adding = key == ord("i")
			if not adding and count == 0:
				status = f"`{field.name}` has no element to remove"
				continue
			typed = _prompt(screen, f"{'insert into' if adding else 'remove from'}"
			                f" {field.name} at (0-{count if adding else count - 1}): ")
			if typed is None or not typed.strip():
				status = "unchanged"
				continue
			try:
				name, which = element_of(f"{field.name}:{typed.strip()}",
				                         typed.strip())
				if adding:
					raw = _prompt(screen, "its bytes (hex): ")
					if raw is None or not raw.strip():
						status = "unchanged"
						continue
					notes = apply_splices(document, [f"{name}:{which}={raw}"],
					                      [])
				else:
					notes = apply_splices(document, [], [f"{name}:{which}"])
			except Refused as why:
				status = f"refused: {why}"
				continue
			unsaved = True
			status  = "; ".join(notes) if notes else f"{field.name} changed"
		elif key == ord("w"):
			if out is None:
				status = "not written; pass --out to keep it"
				continue
			out.write_bytes(bytes(document.buffer))
			unsaved = False
			status  = f"written to {out}"


def main() -> int:
	parser = argparse.ArgumentParser(
		prog="situ-edit-tui",
		description="read a message against a situ schema, on a terminal")
	parser.add_argument("schema", type=Path)
	parser.add_argument("message", type=Path)
	parser.add_argument("--struct", default=None)
	# As `situ-edit`, because the interactive frontend is where somebody
	# follows a nested member's note (26.581). Wiring one and not the
	# other would leave the tool that tells you to open a struct at an
	# offset unable to, which is how this gap existed in the first place.
	parser.add_argument("--offset", type=int, default=0, metavar="N",
	                    help="where the struct starts in the file")
	parser.add_argument("--length", type=int, default=None, metavar="N",
	                    help="how long its frame is (default: to the end)")
	# As `situ-edit`, and for the reason the `--offset` comment above
	# already gives. 26.598 wired `--arg` into the CLI alone, so this
	# frontend went on printing a Python traceback for a struct that takes
	# an argument -- `Unsupplied` is not a `Refused` and the handler below
	# caught only the second. The comment twenty lines up was already the
	# argument against wiring one and not the other (26.603).
	parser.add_argument("--arg", action="append", default=[], type=int,
	                    metavar="N", dest="arguments",
	                    help="a value for one of the struct's `parameter` "
	                         "members, in declaration order")
	parser.add_argument("--hex", action="store_true")
	# The CLI's three write flags, so that everything a person does at the
	# prompt can be done here without a terminal and compared with the
	# CLI's bytes -- 0034's rule that this frontend does not exceed the
	# reference, made checkable rather than promised.
	parser.add_argument("--set", action="append", default=[],
	                    metavar="NAME=VALUE", dest="assignments",
	                    help="store a value before the screen opens")
	parser.add_argument("--set-bytes", action="append", default=[],
	                    metavar="NAME=HEX", dest="byte_assignments",
	                    help="store a byte run, at the length it has")
	parser.add_argument("--insert", action="append", default=[],
	                    metavar="NAME:N=HEX", dest="inserts",
	                    help="put an element into a run of structs")
	parser.add_argument("--remove", action="append", default=[],
	                    metavar="NAME:N", dest="removals",
	                    help="take an element out of a run of structs")
	parser.add_argument("--out", type=Path, default=None,
	                    help="where `w` writes the edited bytes; the "
	                         "message opened is never overwritten unless "
	                         "it is named here")
	parser.add_argument("--no-ui", action="store_true",
	                    help="print what would be shown and exit, so this "
	                         "frontend is testable without a terminal")
	args = parser.parse_args()

	try:
		document = open_from(args.schema, args.message,
		                     _SITUC, args.struct, args.hex,
		                     args.offset, args.length, args.arguments)
	except Unsupplied as why:
		# Its own branch, as in `situ-edit`: the walker keeps `no-view` and
		# `needs-arguments` apart because reporting a caller who has not
		# chosen a layout as a frame too short is a verdict on bytes nobody
		# read.
		print(f"situ-edit-tui: {why}", file=sys.stderr)
		print("situ-edit-tui: pass --arg once per argument, in that order",
		      file=sys.stderr)
		return 1
	except Refused as why:
		print(f"situ-edit-tui: {why}", file=sys.stderr)
		return 1

	try:
		notes = apply_edits(document, args.assignments,
		                    args.byte_assignments)
		notes.extend(apply_splices(document, args.inserts, args.removals))
	except Refused as why:
		print(f"situ-edit-tui: {why}", file=sys.stderr)
		return 1

	if args.no_ui:
		print("\n".join(rows(document)))
		for note in notes:
			print(f"situ-edit-tui: {note}", file=sys.stderr)
		if args.out is not None:
			args.out.write_bytes(bytes(document.buffer))
		return 0

	curses.wrapper(_draw, document, args.out)
	return 0


if __name__ == "__main__":
	sys.exit(main())
