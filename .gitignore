build/
__pycache__/
*.py[co]
.mypy_cache/
.pytest_cache/
# A stray link output: a compile check that forgot `-o` once put one here,
# and it was committed before anybody noticed.
/a.out

# debhelper's working state; debian/ holds packaging sources only.
debian/.debhelper/
debian/files
debian/tmp/
debian/situc/
debian/libsitu-dev/
debian/*.substvars
debian/*.debhelper.log
debian/debhelper-build-stamp

# fmake's object cache, and the two artefacts it leaves at the top level:
# libsitu.a and situ-walk-c, which make writes under build/ instead.
.fmake/
/libsitu.a
/situ-walk-c

# Harness state: worktrees, and a session's own working notes. The
# directory is already here untracked, and these trees depend on `git
# status --porcelain` being readable -- a line nobody can explain is the
# whole warning a shared index gets.
/.claude/
