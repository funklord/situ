// The packed layout image that `situc pack` emits (project.md 26.33,
// doc/decision/0026-runtime-image-and-interpreter.md).
//
// WHY THIS FILE IS A SCHEMA. Decision 0026 rejected a hand-rolled image with
// a hand-rolled parser, on the grounds that it would be the only artifact in
// the project nothing checks, in the component whose input is least trusted.
// So the image is described here and read through generated accessors, which
// means `gen-fuzz` fuzzes the image parser, `situc wire` pins the format,
// `map --check` catches a layout change nobody meant, and the differential
// check compares four backends reading one image.
//
// WHAT WALKS IT. Nothing in this repository, at run time. `situc pack` emits
// an image; the interpreter that walks one over live bytes is a separate
// project. That boundary is 0026's and it is load-bearing: it is what keeps
// "an offset is a constant" and "an operation is absent, not refused" true of
// what `situc` generates.
//
// A SECTION DIRECTORY, NOT A FIXED HEADER. The first version named each
// section in the header, which meant every construct the image learned to
// carry moved the format. The directory is a list of (kind, offset, count,
// stride), so a section added later appends an entry and moves nothing, and a
// walker skips a kind it does not know instead of failing to load. That is
// the property that lets this format grow without a version bump per feature.
//
// THE CORE AND THE TAIL. 26.33 recorded that the format's consumers pull
// opposite ways -- an embedded walker in a fixed arena wants a small
// byte-addressable table, a tooling walker wants names and capability
// vectors. The split is the answer, and the line between them is *function
// versus print*: the core carries every string a walk needs to work, which is
// codec and varint encoding names, because a walker cannot dispatch a
// transform it cannot identify. The tail under `--metadata` carries the
// strings a walk needs only to be read by a human -- field names, struct
// names, capability vectors. A device omits the tail and loses nothing it
// executes.

target buffer;
endian little;      // the image is produced and consumed by the same toolchain

// Sentinel for "this record has no such value". The maximum rather than zero
// because zero is a legitimate offset, size and string index.
const none = 0xffffffff;

// -- section kinds -----------------------------------------------------------

// A walker reads the directory, keeps the sections it understands and skips
// the rest. `default = pass` rather than `error`: an image from a later
// `situc` carrying a section this walker predates is readable, not a refusal,
// which is the whole point of a directory.
enum image_section_tag : u32 {
	structs      = 1,
	placements   = 2,
	code         = 3,
	strings      = 4,      // core: the strings a walk needs to function
	arms         = 5,
	delimiters   = 6,
	regions      = 7,
	codecs       = 8,
	varints      = 9,
	tlvs         = 10,
	indexes      = 11,
	markers      = 14,
	constraints  = 15,
	enum_values  = 16,
	versions     = 17,
	relations    = 18,
	relation_musts = 19,
	pinned_runs  = 20,     // the bytes a `[must_eq]` on a byte run pins
	depths       = 21,     // how deep a recursive struct may nest (0054)
	skips        = 22,     // the whitespace a member owns in front of it
	whitespace   = 23,     // what `[trim]` removes, for the whole schema
	tlv_rules    = 24,     // how a `tlv` item's value says where it ends
	names        = 12,     // tail: struct and placement names, for printing
	vectors      = 13,     // tail: capability vectors, for printing
	default      = pass,
}

enum image_kind : u8 {
	field       = 0,
	reserved    = 1,
	marker      = 2,
	region      = 3,
	variant     = 4,
	tlv         = 5,
	indexed     = 6,
	opaque      = 7,
	default     = error,      // an unknown kind is a refusal, not a guess
}

enum image_endian : u8 {
	unset       = 0,
	big         = 1,
	little      = 2,
	native      = 3,
	default     = error,
}

enum image_bit_order : u8 {
	bit_unset   = 0,
	msb_first   = 1,
	lsb_first   = 2,
	default     = error,
}

// Where an `indexed` region's offsets are measured from; decision 0024.
// The member is `measured_from` rather than `base` because a C++ view
// already defines `base()` for its own pointer, and a member of that name
// shadows it -- generating arithmetic on the enum. See 26.79.
enum image_offset_base : u8 {
	base_region  = 0,
	base_message = 1,
	base_field   = 2,
	default      = error,
}

// -- the header and its directory --------------------------------------------

struct image_header {
	// The magic is a bound rather than a comment now (0052). It was written
	// as one because the language had no way to say it: a reader of this
	// header could see what the bytes should be and no generated code
	// checked them, which is 14.5 in the schema that describes situ's own
	// artifact.
	u8   magic[4] [must_eq = "SITU"];
	u16  format_version [must_eq = 4];
	u16  flags;                       // bit 0: the metadata sections are present
	u32  image_bytes;                 // the whole image, header included
	u32  section_count;
	u32  section_offset;              // from the start of the image
}

// One entry per section. `stride` is carried rather than implied so that a
// walker can skip a section whose records grew under it, which is what makes
// a record extensible without a format version.
struct image_section {
	image_section_tag kind;
	u32  offset;                      // from the start of the image
	u32  count;                       // records, not bytes
	u32  stride;                      // bytes per record
}

// -- the core ----------------------------------------------------------------

// One struct in the schema. Its members are a contiguous run of the placement
// table, which is what lets a walker find them without an index.
struct image_struct {
	u32  first_placement;
	u32  placement_count;
	u32  size_bits;                   // `none` when the struct has no one size
	u32  struct_flags;                // bit 0: every check `validate` makes
	                                  //        is one this image carries, so
	                                  //        a walk may answer it. Clear
	                                  //        where it is not, because a
	                                  //        partial `validate` says OK
	                                  //        where the schema says no --
	                                  //        the one probe that cannot be
	                                  //        rendered by halves
	                                  // bit 1: one instance can be measured
	                                  //        from its own bytes, so a
	                                  //        sub-view over it exists.
	                                  //        Clear where the struct ends
	                                  //        in its frame rather than at
	                                  //        a length it carries, which
	                                  //        is why nothing descends into
	                                  //        `publish_body`
}

// Which member carries a struct's version number, where `[version = ...]`
// names one. A `[since]` member is present only in a message whose own
// version reaches it, so a walk cannot ask whether such a field is *wrong*
// until it knows whether the field is *there* -- and that answer is a scalar
// somewhere else in the same struct.
//
// A side table rather than a field on `image_struct`, because most structs
// have no version member and the record is 16 bytes for four u32s with none
// spare. Widening it would move every stride in the format for a fact that
// applies to two structs in the corpus.
//
// The offsets do not move. A `[since]` member is appended, so everything
// after it sits where it would have sat anyway and only its *presence*
// varies -- which is why this needs no expression, only a field to read.
struct image_version {
	u32  shape;                       // index into the struct table
	u32  placement;                   // the member holding the version
}

// How deep a recursive struct may nest, and how deep this reader will follow
// (0054). Two numbers because they answer different questions: `depth` is the
// format's own limit, so a message past it is malformed, and `limit` is what
// the schema told a reader to spend, so a message past that is well formed
// and refused anyway.
//
// A side table for the same reason `image_version` is one: almost no struct
// names itself, and `image_struct` is 16 bytes for four u32s with none spare.
// It also means a walker built before this section existed skips it by tag
// and keeps working -- which is what `stride` on `image_section` is for.
//
// **A walker reading this replaces its own compiled-in ceiling with the
// schema's**, which is the point. Before it, `WALK_DEPTH_MAX` was a number
// chosen for the corpus and compared against nothing the schema declared: a
// schema saying 32 and a walker allowing 8 disagreed silently, and the walk
// simply stopped early.
struct image_depth {
	u32  shape;                       // index into the struct table
	u32  depth;                       // the format's own limit
	u32  limit;                       // what this schema asks a reader to spend
}

// One placement: where the bytes are, how many there are, and how to compute
// either when the answer is not a constant. Anything a walk needs that is not
// geometry lives in a side table keyed by this record's index, so that a
// walker which never meets a variant never reads the arm table.
struct image_placement {
	image_kind      kind;
	image_endian    endian;
	image_bit_order bit_order;
	u8              flags;            // bit 0: offset_bits is known
	                                  // bit 1: frame_relative
	                                  // bit 2: the size is fixed
	                                  // bit 3: the frame base is itself dynamic
	                                  // bit 4: the value is signed, so a
	                                  //        reader sign-extends it
	                                  // bit 5: the byte order is decided by
	                                  //        an endian marker in the
	                                  //        message, not by this record
	u32  offset_bits;                 // valid when flags bit 0, else `none`
	u32  size_bits;                   // the lower bound, exact when fixed
	u32  size_max_bits;               // `none` when unbounded above
	u32  element_bits;                // `none` when not an array
	u32  array_count;                 // `none` when the count is not a constant
	u32  size_code;                   // bytecode offset, or `none`
	u32  type_struct;                 // index into the struct table, or `none`
	u32  located_code;                // `at expr`: bytecode offset, or `none`
	u32  repeat_code;                 // `while (cond)`: bytecode, or `none`
	u8   radix;                       // 0, or 10 or 16 for a text number
	u8   text_flags;                  // bit 0: minimal (no leading zeros)
	                                  // bit 1: trimmed
	                                  // bit 2: case_insensitive
	                                  // bit 3: packed decimal (BCD), whose
	                                  //        digit count is in
	                                  //        `radix_digits`
	u16  radix_digits;                // digits the field holds, or 0 --
	                                  // for a text number and for packed
	                                  // decimal alike, since both are a
	                                  // count of digits
	u16  since;                       // `[since = N]`, or 0 for always
	u16  repeat_cap;                  // `while (...) max N`, or 0 for none
}

// -- the side tables ---------------------------------------------------------

// Every one of these is sorted by `placement`, so a walker binary-searches
// rather than building a reverse map in an arena it may not have.

// A variant's arms. `case_value` is the discriminant value this arm matches;
// the default arm carries `is_default` and no value.
struct image_arm {
	u32  placement;                   // the variant this arm belongs to
	u32  selected;                    // the placement it chooses, or `none`
	i64  case_value;
	u32  discriminant;                // the placement whose value selects
	u8   arm_flags;                   // bit 0: default   bit 1: error
	u8   arm_pad[3];
}

// `until "D"` or `before "D"`: where a member ends when no length says so.
//
// `consumed` is the difference and it is one bit: a TERMINATOR belongs to
// what it ends and a SEPARATOR belongs to neither side, so the scan is
// identical and only the span moves. A byte rather than a bit in `length`,
// which would have fitted -- a flag packed into a number is a flag nobody
// reads, and this record had three spare bytes of padding to spend.
//
// One ROW per alternative, all under the same placement: `until "," | "]"`
// is two rows, and a reader collects the consecutive ones. `quote`,
// `escape`, `cap` and `consumed` belong to the MEMBER and are repeated on
// each, because which row a binary search lands on first is not a property
// anything should depend on.
//
// The bytes are
// inline because every delimiter in the tree is one, two or five bytes, and
// an offset into a pool would cost as much as the bytes for all of them.
// The member is `octets` rather than `bytes` because the generated Python
// annotates with the builtin `bytes`, which a member of that name shadows.
// Same family as `measured_from` above, and 26.79 records both.
struct image_delimiter {
	u32  placement;
	u32  quote;                       // the escaping form, or `none`
	u32  escape;                      // the other escaping form, or `none`
	u32  cap;                         // `until D max N`, or `none`
	u8   length;
	u8   consumed;                    // 1 for `until`, 0 for `before`
	u8   octets[15];
	u8   delim_pad[3];
}

// What `[trim]` removes, one row per byte under the member that asks.
//
// Keyed by PLACEMENT and not by schema, which is `image_skip`'s arrangement
// and for the same reason: `whitespace` is declared per file, `import`
// splices another file's structs in, and a member is written against the
// vocabulary of the file it is written in. A file-level section made
// `[trim]` read the root's set where `skip` in the same imported file read
// its own -- two attributes, one question, two answers.
//
// A member with no row uses HTTP's OWS, space and tab, which is what a
// member with no `[trim]` needs no answer for and what an image written
// before this section carried means.
struct image_whitespace {
	u32  placement;
	u8   octet;
	u8   ws_pad[3];
}

// `skip`: the bytes that may stand in front of a member and belong to it.
//
// One ROW per byte, all under the same placement, which is `image_delimiter`'s
// arrangement for `until "," | "]"` and is here for the same reason: the table
// is sorted by placement and already searched, so consecutive rows cost the
// format nothing and there is no count to carry or bound.
//
// A SET of bytes rather than a sequence, which is the whole difference from a
// delimiter. A lead runs while the next byte is in the set; a scan runs until
// a sequence matches. So a row holds one byte and never a length.
struct image_skip {
	u32  placement;
	u8   octet;
	u8   skip_pad[3];
}

// An `authenticated` or `sealed` region, and the member's membership of one.
struct image_region {
	u32  placement;
	u32  owner;                       // the region this member is inside; a
	                                  // region names itself, which is what
	                                  // lets a walker group an interior
	                                  // under the gate that guards it
	u32  codec;                       // index into the codec table, or `none`
	u8   region_flags;                // bit 0: sealed  bit 1: read allowed
	                                  // unverified
	u8   region_pad[3];
}

// A codec, named because a walker cannot dispatch a transform it cannot
// identify. The name is in the *core* string pool for that reason.
struct image_codec {
	u32  name;                        // offset into the core string pool
}

// A varint's width is decoded rather than declared, so a walk needs the
// decoder's own parameters and not the schema's `max_bits`: `max_bytes` is
// where the encoding stops and `terminal_bits` is what the last permitted
// byte carries. Where that is eight there is no spare bit for a continuation
// flag and the byte is read whole -- SQLite's ninth. Both fall out of
// arithmetic the compiler already does, and rederiving them here would be a
// second implementation of it.
struct image_varint {
	u32  placement;
	u32  encoding;                    // core string pool offset
	u8   max_bytes;
	u8   terminal_bits;
	u8   varint_flags;                // bit 0: minimal encodings demanded
	                                  // bit 1: big-endian groups (be128)
	u8   varint_pad;
}

struct image_tlv {
	u32  placement;
	u32  tag_varint;                  // index into the varint table, or `none`
	u8   tlv_flags;                   // bit 0: ordered
	u8   unknown_policy;
	u8   duplicate_policy;
	u8   tlv_pad;
	// Which rule below applies, as arithmetic over the raw tag: protobuf's
	// selector is `tag & 0x7`. Bytecode rather than a (shift, mask) pair,
	// because a pair is an assumption about the shape of an expression the
	// schema is free to write differently -- and `Op.tag` is the ambient
	// value the way `Op.remaining` already is.
	//
	// This record was twelve bytes and carried the tag varint and the two
	// policies: enough to read an item's TAG and nothing about how far its
	// VALUE reaches, so a walker could not count items at all. A stride
	// wider than a reader expects is how this format grows, so a build that
	// stops at twelve is unaffected.
	u32  selector_code;               // bytecode offset, or `none`
	// The tag varint's decoder parameters, carried rather than referenced.
	// `tag_varint` above is documented as an index into the varint table
	// and is not usable as one: that table is keyed by PLACEMENT, and a
	// `tlv` region's tag varint belongs to no placement -- so the field is
	// `none` for every image this tree produces. The parameters are three
	// bytes and the indirection was zero, which is the trade.
	u8   tag_max_bytes;
	u8   tag_terminal_bits;
	u8   tag_varint_flags;            // bit 1: big-endian groups (be128)
	u8   tag_pad;
}

// How one item's value says where it ends (section 9.5). One row per rule,
// consecutive under the placement -- the delimiter table's arrangement and
// for its reason: the table is sorted by placement and binary-searched, so
// consecutive rows cost nothing and no row has to carry a count.
//
// `label` is the selector value this rule answers for, and `is_default`
// marks the dispatch's `default` -- which cannot be spelled as a label,
// since every 64-bit value is a legal one.
struct image_tlv_rule {
	u32  placement;
	i64  label;                       // the selector value this matches
	u8   rule_kind;                   // 0 fixed, 1 prefixed,
	                                  // 2 self_delimiting, 3 error
	u8   is_default;
	u8   rule_pad[2];
	u32  fixed_size;                  // bytes, for `fixed`
	// A `prefixed` value's length varint, by its parameters rather than by
	// an index, for the reason `image_tlv` gives above.
	u8   length_max_bytes;
	u8   length_terminal_bits;
	u8   length_varint_flags;         // bit 1: big-endian groups (be128)
	u8   length_pad;
}

// One thing `validate` checks. In placement order, because the first failure
// is the answer and the code depends on which came first.
enum image_check : u8 {
	must_eq      = 0,
	minimum      = 1,
	maximum      = 2,
	must_be_zero = 3,
	must_be_one  = 4,
	enum_known   = 5,     // `value` is the enum's id in the value table
	fits_frame   = 6,     // a run whose length the *message* declares has to
	                      // fit the frame it is in. Not `remaining`, which is
	                      // what is left by definition, and not a `while`
	                      // run, which stops at the frame -- only a length a
	                      // sender chose, which is the one an attacker picks
	terminated   = 7,     // a delimited member's delimiter has to be there:
	                      // a frame that does not contain it cut the member
	                      // short, so it ran to the end of the buffer rather
	                      // than to its own end
	arm_selected = 8,     // the discriminant has to name an arm that exists,
	                      // where the variant's default is `error`. Answers
	                      // `VERSION` rather than `CONSTRAINT` -- an unknown
	                      // discriminant is a message this build cannot read
	                      // rather than one that breaks a rule
	digits_valid = 9,     // a text number's bytes have to parse in its radix
	                      // and fit its scalar's domain. `value` carries the
	                      // largest that domain admits: a walk cannot read a
	                      // width off a field whose width is however many
	                      // digits somebody wrote
	digits_minimal = 10,  // `[minimal]`: one spelling per value, so a leading
	                      // zero is a second way to write a number that
	                      // already has one -- and above radix 10, so is an
	                      // upper-case digit
	nul_terminated = 11,  // the terminator has to be inside the field. The
	                      // declared size is the capacity, so a field with no
	                      // zero byte in it is not a short string -- it is one
	                      // whose content runs off the end
	encoded_as   = 12,    // the bytes have to be in the encoding the schema
	                      // names. `value` is which: 0 ascii, 1 utf8
	pinned_run   = 14,    // a byte run equals the literal it is pinned to.
	                      // `value` is the row in the pinned table holding
	                      // those bytes: `image_constraint` carries an `i64`
	                      // and a byte run packed into one would have an
	                      // endianness the literal does not, which is the
	                      // confusion 0024 is about. Indirection for the same
	                      // reason `enum_known` uses it
	zero_run     = 13,    // every byte of a reserved *run* is zero. The
	                      // scalar form is `must_be_zero`; this is the one
	                      // whose length the message computes, which is why
	                      // it cannot be a value comparison
	default      = error,
}

struct image_constraint {
	u32  placement;
	i64  value;
	image_check  check;
	u8   constraint_pad[3];
}

// The bytes a `[must_eq]` on a byte run pins (0052). Inline rather than into
// the string table, on `image_delimiter`'s model: these are bytes rather than
// text, a magic is short, and a walk comparing them wants them contiguous.
//
// 27 octets is the cap, which is not a language limit -- the front end takes
// a literal of any length -- so the packer disowns the check for a longer run
// rather than truncating it. Truncating would validate a prefix and report a
// whole match, which is the failure this construct exists to make impossible.
struct image_pinned {
	u32  placement;
	u8   length;
	u8   octets[27];
}

// The values an enum names, so membership is a question a walk can answer.
struct image_enum_value {
	u32  enum_id;
	i64  value;
	u32  enum_pad;
}

// A byte-order marker: the TIFF `II`/`MM` pattern (section 8.3). A walker
// reads the field big-endian and compares: matching `little_value` means the
// fields this marker governs are little-endian. The value is the schema's, so
// carrying it is what lets a walk answer the question at all.
struct image_marker {
	u32  placement;
	i64  little_value;
	u32  marker_pad;
}

struct image_index {
	u32  placement;
	u32  entry_bits;                  // one offset-table entry
	u32  count_code;                  // bytecode for the entry count, or `none`
	image_offset_base measured_from;
	u8   index_pad[3];
}

// -- cross-message relations (26.95) ------------------------------------------

// A relation is a pure predicate over two views (decision 0030). What the
// image has to carry is which two structs it is stated over, and one bytecode
// program per `must`.
//
// The programs use `arg_field` rather than `field`: both parameters are
// usually the same struct -- `response_to(request: frame, response: frame)`
// is the shape -- so a placement id alone does not say which message to read
// it out of. The opcode carries the parameter as well, and that is the only
// thing the expression language needed to grow.
//
// Nothing here says *which* messages are a pair. That is the caller's, at
// every rung and in every backend: a relation answers whether a pairing is
// well formed and never which pairings exist.
struct image_relation {
	u32  name;                        // string id
	u32  request_struct;              // the message seen first
	u32  response_struct;
	u32  first_must;
	u32  must_count;
	u32  relation_pad;
}

// One constraint. `code` is an offset into the code section, and the program
// there leaves a single value: non-zero holds, zero is `CONSTRAINT`.
struct image_relation_must {
	u32  code;
	u32  must_pad;
}

// -- the whole image ---------------------------------------------------------

// Only the header is a member here. Everything else is reached through the
// directory, which is what makes the format extensible -- and it is why the
// record types above are structs in their own right: a walker acquires one at
// a computed offset through the generated accessors, exactly as this
// repository's own tests do.
struct image {
	image_header  head;
}

require absolute_static(image_header);
require absolute_static(image_section);
require absolute_static(image_struct);
require absolute_static(image_placement);
require absolute_static(image_arm);
require absolute_static(image_delimiter);
require absolute_static(image_whitespace);
require absolute_static(image_skip);
require absolute_static(image_region);
require absolute_static(image_codec);
require absolute_static(image_varint);
require absolute_static(image_tlv);
require absolute_static(image_tlv_rule);
require absolute_static(image_constraint);
require absolute_static(image_pinned);
require absolute_static(image_enum_value);
require absolute_static(image_version);
require absolute_static(image_marker);
require absolute_static(image_index);
require absolute_static(image_relation);
require absolute_static(image_relation_must);

require size(image_header) == 20;
require size(image_section) == 16;
require size(image_struct) == 16;
require size(image_placement) == 48;
require size(image_arm) == 24;
require size(image_delimiter) == 36;
require size(image_whitespace) == 8;
require size(image_skip) == 8;
require size(image_region) == 16;
require size(image_codec) == 4;
require size(image_varint) == 12;
require size(image_tlv) == 20;
require size(image_tlv_rule) == 24;
require size(image_constraint) == 16;
require size(image_pinned) == 32;
require size(image_enum_value) == 16;
require size(image_marker) == 16;
require size(image_index) == 16;
require size(image_relation) == 24;
require size(image_relation_must) == 8;
