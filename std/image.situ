// The packed layout image that `situc pack` emits (project.md 26.33,
// docs/decisions/0026-runtime-image-and-interpreter.md).
//
// WHY THIS FILE IS A SCHEMA. Decision 0026 rejected a hand-rolled image with
// a hand-rolled parser, on the grounds that it would be the only artifact in
// the project nothing checks, in the component whose input is least trusted.
// So the image is described here and read through generated accessors, which
// means `gen-fuzz` fuzzes the image parser, `situc wire` pins the format,
// `map --check` catches a layout change nobody meant, and the differential
// check compares four backends reading one image.
//
// WHAT WALKS IT. Nothing in this repository, at run time. `situc pack` emits
// an image; the interpreter that walks one over live bytes is a separate
// project. That boundary is 0026's and it is load-bearing: it is what keeps
// "an offset is a constant" and "an operation is absent, not refused" true of
// what `situc` generates.
//
// A SECTION DIRECTORY, NOT A FIXED HEADER. The first version named each
// section in the header, which meant every construct the image learned to
// carry moved the format. The directory is a list of (kind, offset, count,
// stride), so a section added later appends an entry and moves nothing, and a
// walker skips a kind it does not know instead of failing to load. That is
// the property that lets this format grow without a version bump per feature.
//
// THE CORE AND THE TAIL. 26.33 recorded that the format's consumers pull
// opposite ways -- an embedded walker in a fixed arena wants a small
// byte-addressable table, a tooling walker wants names and capability
// vectors. The split is the answer, and the line between them is *function
// versus print*: the core carries every string a walk needs to work, which is
// codec and varint encoding names, because a walker cannot dispatch a
// transform it cannot identify. The tail under `--metadata` carries the
// strings a walk needs only to be read by a human -- field names, struct
// names, capability vectors. A device omits the tail and loses nothing it
// executes.

target buffer;
endian little;      // the image is produced and consumed by the same toolchain

// Sentinel for "this record has no such value". The maximum rather than zero
// because zero is a legitimate offset, size and string index.
const none = 0xffffffff;

// -- section kinds -----------------------------------------------------------

// A walker reads the directory, keeps the sections it understands and skips
// the rest. `default = pass` rather than `error`: an image from a later
// `situc` carrying a section this walker predates is readable, not a refusal,
// which is the whole point of a directory.
enum image_section_tag : u32 {
	structs      = 1,
	placements   = 2,
	code         = 3,
	strings      = 4,      // core: the strings a walk needs to function
	arms         = 5,
	delimiters   = 6,
	regions      = 7,
	codecs       = 8,
	varints      = 9,
	tlvs         = 10,
	indexes      = 11,
	markers      = 14,
	constraints  = 15,
	enum_values  = 16,
	names        = 12,     // tail: struct and placement names, for printing
	vectors      = 13,     // tail: capability vectors, for printing
	default      = pass,
}

enum image_kind : u8 {
	field       = 0,
	reserved    = 1,
	marker      = 2,
	region      = 3,
	variant     = 4,
	tlv         = 5,
	indexed     = 6,
	opaque      = 7,
	default     = error,      // an unknown kind is a refusal, not a guess
}

enum image_endian : u8 {
	unset       = 0,
	big         = 1,
	little      = 2,
	native      = 3,
	default     = error,
}

enum image_bit_order : u8 {
	bit_unset   = 0,
	msb_first   = 1,
	lsb_first   = 2,
	default     = error,
}

// Where an `indexed` region's offsets are measured from; decision 0024.
// The member is `measured_from` rather than `base` because a C++ view
// already defines `base()` for its own pointer, and a member of that name
// shadows it -- generating arithmetic on the enum. See 26.79.
enum image_offset_base : u8 {
	base_region  = 0,
	base_message = 1,
	base_field   = 2,
	default      = error,
}

// -- the header and its directory --------------------------------------------

struct image_header {
	u8   magic[4];                    // "SITU"
	u16  format_version [must_eq = 2];
	u16  flags;                       // bit 0: the metadata sections are present
	u32  image_bytes;                 // the whole image, header included
	u32  section_count;
	u32  section_offset;              // from the start of the image
}

// One entry per section. `stride` is carried rather than implied so that a
// walker can skip a section whose records grew under it, which is what makes
// a record extensible without a format version.
struct image_section {
	image_section_tag kind;
	u32  offset;                      // from the start of the image
	u32  count;                       // records, not bytes
	u32  stride;                      // bytes per record
}

// -- the core ----------------------------------------------------------------

// One struct in the schema. Its members are a contiguous run of the placement
// table, which is what lets a walker find them without an index.
struct image_struct {
	u32  first_placement;
	u32  placement_count;
	u32  size_bits;                   // `none` when the struct has no one size
	u32  struct_flags;                // bit 0: every check `validate` makes
	                                  //        is one this image carries, so
	                                  //        a walk may answer it. Clear
	                                  //        where it is not, because a
	                                  //        partial `validate` says OK
	                                  //        where the schema says no --
	                                  //        the one probe that cannot be
	                                  //        rendered by halves
	                                  // bit 1: one instance can be measured
	                                  //        from its own bytes, so a
	                                  //        sub-view over it exists.
	                                  //        Clear where the struct ends
	                                  //        in its frame rather than at
	                                  //        a length it carries, which
	                                  //        is why nothing descends into
	                                  //        `publish_body`
}

// One placement: where the bytes are, how many there are, and how to compute
// either when the answer is not a constant. Anything a walk needs that is not
// geometry lives in a side table keyed by this record's index, so that a
// walker which never meets a variant never reads the arm table.
struct image_placement {
	image_kind      kind;
	image_endian    endian;
	image_bit_order bit_order;
	u8              flags;            // bit 0: offset_bits is known
	                                  // bit 1: frame_relative
	                                  // bit 2: the size is fixed
	                                  // bit 3: the frame base is itself dynamic
	                                  // bit 4: the value is signed, so a
	                                  //        reader sign-extends it
	                                  // bit 5: the byte order is decided by
	                                  //        an endian marker in the
	                                  //        message, not by this record
	u32  offset_bits;                 // valid when flags bit 0, else `none`
	u32  size_bits;                   // the lower bound, exact when fixed
	u32  size_max_bits;               // `none` when unbounded above
	u32  element_bits;                // `none` when not an array
	u32  array_count;                 // `none` when the count is not a constant
	u32  size_code;                   // bytecode offset, or `none`
	u32  type_struct;                 // index into the struct table, or `none`
	u32  located_code;                // `at expr`: bytecode offset, or `none`
	u32  repeat_code;                 // `while (cond)`: bytecode, or `none`
	u8   radix;                       // 0, or 10 or 16 for a text number
	u8   text_flags;                  // bit 0: minimal (no leading zeros)
	                                  // bit 1: trimmed
	                                  // bit 2: case_insensitive
	u16  radix_digits;                // digits the field holds, or 0
	u16  since;                       // `[since = N]`, or 0 for always
	u16  repeat_cap;                  // `while (...) max N`, or 0 for none
}

// -- the side tables ---------------------------------------------------------

// Every one of these is sorted by `placement`, so a walker binary-searches
// rather than building a reverse map in an arena it may not have.

// A variant's arms. `case_value` is the discriminant value this arm matches;
// the default arm carries `is_default` and no value.
struct image_arm {
	u32  placement;                   // the variant this arm belongs to
	u32  selected;                    // the placement it chooses, or `none`
	i64  case_value;
	u32  discriminant;                // the placement whose value selects
	u8   arm_flags;                   // bit 0: default   bit 1: error
	u8   arm_pad[3];
}

// `until "D"`: where a member ends when no length says so. The bytes are
// inline because every delimiter in the tree is one, two or five bytes, and
// an offset into a pool would cost as much as the bytes for all of them.
// The member is `octets` rather than `bytes` because the generated Python
// annotates with the builtin `bytes`, which a member of that name shadows.
// Same family as `measured_from` above, and 26.79 records both.
struct image_delimiter {
	u32  placement;
	u32  quote;                       // the escaping form, or `none`
	u32  escape;                      // the other escaping form, or `none`
	u32  cap;                         // `until D max N`, or `none`
	u8   length;
	u8   octets[15];
}

// An `authenticated` or `sealed` region, and the member's membership of one.
struct image_region {
	u32  placement;
	u32  owner;                       // the region this member is inside; a
	                                  // region names itself, which is what
	                                  // lets a walker group an interior
	                                  // under the gate that guards it
	u32  codec;                       // index into the codec table, or `none`
	u8   region_flags;                // bit 0: sealed  bit 1: read allowed
	                                  // unverified
	u8   region_pad[3];
}

// A codec, named because a walker cannot dispatch a transform it cannot
// identify. The name is in the *core* string pool for that reason.
struct image_codec {
	u32  name;                        // offset into the core string pool
}

// A varint's width is decoded rather than declared, so a walk needs the
// decoder's own parameters and not the schema's `max_bits`: `max_bytes` is
// where the encoding stops and `terminal_bits` is what the last permitted
// byte carries. Where that is eight there is no spare bit for a continuation
// flag and the byte is read whole -- SQLite's ninth. Both fall out of
// arithmetic the compiler already does, and rederiving them here would be a
// second implementation of it.
struct image_varint {
	u32  placement;
	u32  encoding;                    // core string pool offset
	u8   max_bytes;
	u8   terminal_bits;
	u8   varint_flags;                // bit 0: minimal encodings demanded
	                                  // bit 1: big-endian groups (be128)
	u8   varint_pad;
}

struct image_tlv {
	u32  placement;
	u32  tag_varint;                  // index into the varint table, or `none`
	u8   tlv_flags;                   // bit 0: ordered
	u8   unknown_policy;
	u8   duplicate_policy;
	u8   tlv_pad;
}

// One thing `validate` checks. In placement order, because the first failure
// is the answer and the code depends on which came first.
enum image_check : u8 {
	must_eq      = 0,
	minimum      = 1,
	maximum      = 2,
	must_be_zero = 3,
	must_be_one  = 4,
	enum_known   = 5,     // `value` is the enum's id in the value table
	fits_frame   = 6,     // a run whose length the *message* declares has to
	                      // fit the frame it is in. Not `remaining`, which is
	                      // what is left by definition, and not a `while`
	                      // run, which stops at the frame -- only a length a
	                      // sender chose, which is the one an attacker picks
	terminated   = 7,     // a delimited member's delimiter has to be there:
	                      // a frame that does not contain it cut the member
	                      // short, so it ran to the end of the buffer rather
	                      // than to its own end
	arm_selected = 8,     // the discriminant has to name an arm that exists,
	                      // where the variant's default is `error`. Answers
	                      // `VERSION` rather than `CONSTRAINT` -- an unknown
	                      // discriminant is a message this build cannot read
	                      // rather than one that breaks a rule
	default      = error,
}

struct image_constraint {
	u32  placement;
	i64  value;
	image_check  check;
	u8   constraint_pad[3];
}

// The values an enum names, so membership is a question a walk can answer.
struct image_enum_value {
	u32  enum_id;
	i64  value;
	u32  enum_pad;
}

// A byte-order marker: the TIFF `II`/`MM` pattern (section 8.3). A walker
// reads the field big-endian and compares: matching `little_value` means the
// fields this marker governs are little-endian. The value is the schema's, so
// carrying it is what lets a walk answer the question at all.
struct image_marker {
	u32  placement;
	i64  little_value;
	u32  marker_pad;
}

struct image_index {
	u32  placement;
	u32  entry_bits;                  // one offset-table entry
	u32  count_code;                  // bytecode for the entry count, or `none`
	image_offset_base measured_from;
	u8   index_pad[3];
}

// -- the whole image ---------------------------------------------------------

// Only the header is a member here. Everything else is reached through the
// directory, which is what makes the format extensible -- and it is why the
// record types above are structs in their own right: a walker acquires one at
// a computed offset through the generated accessors, exactly as this
// repository's own tests do.
struct image {
	image_header  head;
}

require absolute_static(image_header);
require absolute_static(image_section);
require absolute_static(image_struct);
require absolute_static(image_placement);
require absolute_static(image_arm);
require absolute_static(image_delimiter);
require absolute_static(image_region);
require absolute_static(image_codec);
require absolute_static(image_varint);
require absolute_static(image_tlv);
require absolute_static(image_constraint);
require absolute_static(image_enum_value);
require absolute_static(image_marker);
require absolute_static(image_index);

require size(image_header) == 20;
require size(image_section) == 16;
require size(image_struct) == 16;
require size(image_placement) == 48;
require size(image_arm) == 24;
require size(image_delimiter) == 32;
require size(image_region) == 16;
require size(image_codec) == 4;
require size(image_varint) == 12;
require size(image_tlv) == 12;
require size(image_constraint) == 16;
require size(image_enum_value) == 16;
require size(image_marker) == 16;
require size(image_index) == 16;
