// Standard kernel descriptions (project.md section 13.4).
//
// The tier-2 counterpart of std/codecs.situ. Every signature there is
// hand-written, trusted and unverified; every signature here is *derived* from
// the description beside it, and so is the implementation. The properties in
// the capability map and the code in the object file come from one source, so
// they cannot disagree -- which is the whole difference between the tiers.
//
// A `codec` here needs no property declared at all. Where one is written
// anyway it has to match what the kernel implies, so it is a check rather than
// a claim.

// ---------------------------------------------------------------------------
// Polynomial: every CRC variant
//
// Parameters are the CRC catalogue's, and the table is computed from them.
// A variant nobody has written down works exactly as well as a famous one.
// ---------------------------------------------------------------------------

codec crc32 {
	kernel = polynomial(width = 32, poly = 0x04C11DB7, init = 0xFFFFFFFF,
	                    xorout = 0xFFFFFFFF, reflect);
}
impl crc32 derived;

codec crc32c {
	kernel = polynomial(width = 32, poly = 0x1EDC6F41, init = 0xFFFFFFFF,
	                    xorout = 0xFFFFFFFF, reflect);
}
impl crc32c derived;

codec crc16_ccitt {
	kernel = polynomial(width = 16, poly = 0x1021, init = 0xFFFF);
}
impl crc16_ccitt derived;

codec crc16_modbus {
	kernel = polynomial(width = 16, poly = 0x8005, init = 0xFFFF, reflect);
}
impl crc16_modbus derived;

codec crc8_smbus {
	kernel = polynomial(width = 8, poly = 0x07);
}
impl crc8_smbus derived;

// The same family over an extension field is a Reed-Solomon code rather than a
// CRC, and the derivation says so: the parity is symbols rather than a digest,
// it comes back, and it corrects rather than merely detecting -- so the code is
// invertible where a CRC is not, and a burst past its capacity propagates.
//
// CCSDS's (255, 223): 32 parity symbols correcting any 16 errors in the block.
codec reed_solomon_255_223 {
	kernel = polynomial(field = 256, n = 255, k = 223, primitive = 0x11D);
}
impl reed_solomon_255_223 derived;

// A shortened block, to make the point that the generation is not specific to
// the famous code: the tables and the generator polynomial come from the
// parameters.
codec reed_solomon_64_56 {
	kernel = polynomial(field = 256, n = 64, k = 56);
}
impl reed_solomon_64_56 derived;

// ---------------------------------------------------------------------------
// Table: line codes
//
// The ratio is exact, which is what keeps an interior position a linear
// function of an input position. Not systematic: the input symbols do not
// appear verbatim in the output, so nothing can be read without decoding.
// ---------------------------------------------------------------------------

// The two Manchesters. Both are called Manchester, they are bit-inverses of
// each other, and a receiver built on one reads a sender built on the other as
// the complement of what was sent -- plausible bytes and no error anywhere.
// Naming them apart is the whole point; `code = manchester` is refused.
codec manchester_802_3 {
	kernel = table(input_bits = 1, output_bits = 2, code = manchester_802_3);
}
impl manchester_802_3 derived;

codec manchester_thomas {
	kernel = table(input_bits = 1, output_bits = 2, code = manchester_thomas);
}
impl manchester_thomas derived;

// RFC 4648 base16. A nibble to an ASCII hex digit, which needs no padding at
// any input length -- every byte is exactly two nibbles. That is what makes it
// a table code and nothing more, where base32 and base64 are a table code plus
// a rule about what to do with a partial group.
//
// The ratio is exact and 2:1, so a reader can compute where any byte's two
// digits are without decoding anything before them.
codec base16 {
	kernel = table(input_bits = 4, output_bits = 8, code = base16);
}
impl base16 derived;

codec base16_lower {
	kernel = table(input_bits = 4, output_bits = 8, code = base16_lower);
}
impl base16_lower derived;

// RFC 4648 base32 and base64. Unlike base16 these pad: a group is five bytes
// and three bytes respectively, and an input that does not end on one has its
// last group filled out rather than truncated. `pad = 0x3D` is `=`.
//
// That is what `ratio_padded` says in the capability map, and why granularity
// is a block rather than a symbol -- the unit a reader has to align to is the
// group, not the character.
codec base32 {
	kernel = table(input_bits = 5, output_bits = 8, code = base32, pad = 0x3D);
}
impl base32 derived;

codec base64 {
	kernel = table(input_bits = 6, output_bits = 8, code = base64, pad = 0x3D);
}
impl base64 derived;

// The URL-safe alphabet swaps the last two characters. A different code, not a
// rendering choice: text encoded with one and decoded with the other is wrong
// in exactly the bytes that made somebody reach for it.
codec base64url {
	kernel = table(input_bits = 6, output_bits = 8, code = base64url, pad = 0x3D);
}
impl base64url derived;

codec code_4b5b {
	kernel = table(input_bits = 4, output_bits = 5, code = fddi_4b5b);
}
impl code_4b5b derived;

// ---------------------------------------------------------------------------
// The remaining four families.
//
// The pair of scramblers is the point: the same family and the same taps, and
// opposite properties, worked out from one word of the description.
// ---------------------------------------------------------------------------

// Feedback from the output, so neither seekable nor self-synchronising --
// which the derivation works out rather than being told.
codec scrambler_multiplicative {
	kernel = shift_register(taps = 0x8810, width = 16, seed = 0xFFFF,
	                        feedback = output);
}
impl scrambler_multiplicative derived;

// Feedback from the input: startable anywhere, and a corrupt bit spoils only
// itself. The same family, and the opposite properties.
codec scrambler_additive {
	kernel = shift_register(taps = 0xB400, width = 16, seed = 0xACE1,
	                        feedback = input);
}
impl scrambler_additive derived;

codec hamming_7_4 {
	kernel = linear_block(n = 7, k = 4, standard_form, code = hamming_7_4);
}
impl hamming_7_4 derived;

codec interleave_16 {
	kernel = permutation(rows = 4, columns = 4);
}
impl interleave_16 derived;

codec cobs {
	kernel = stuffing(worst_case = 255, per = 254, code = cobs);
}
impl cobs derived;

codec hdlc_bit_stuffing {
	kernel = stuffing(worst_case = 6, per = 5, unit = bit, code = hdlc);
}
impl hdlc_bit_stuffing derived;

// SMTP dot-stuffing, RFC 5321 section 4.5.2. A line beginning with a period is
// sent with two and the receiver removes one, which is what leaves `CRLF . CRLF`
// unambiguous as the end of a DATA body.
//
// `unit = stream` and not `byte`: the trigger is "the start of a line", which
// cannot be evaluated from one byte without knowing what preceded it. The worst
// case is a body of nothing but `.CRLF` lines -- three bytes in, four out.
codec smtp_dot_stuffing {
	kernel = stuffing(worst_case = 4, per = 3, unit = stream, code = smtp_dot);
}
impl smtp_dot_stuffing derived;

// ---------------------------------------------------------------------------
// A pipeline, composing pointwise and conservatively.
//
// Seekable only if every stage is, systematic only if every stage is, and the
// expansion is the product -- so this one is 2:1 with 32 bytes of parity
// doubled to 64, and permuted rather than linear because the interleaver is.
// ---------------------------------------------------------------------------

codec framed = crc32 |> interleave_16 |> manchester_802_3;
