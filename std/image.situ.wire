# situ wire signature v1
# schema: image.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian little
target buffer

enum image_section_tag : u32 unknown=pass
  structs=1 placements=2 code=3 strings=4 arms=5 delimiters=6 regions=7 codecs=8 varints=9 tlvs=10 indexes=11 markers=14 constraints=15 enum_values=16 versions=17 relations=18 relation_musts=19 pinned_runs=20 names=12 vectors=13

enum image_kind : u8 unknown=error
  field=0 reserved=1 marker=2 region=3 variant=4 tlv=5 indexed=6 opaque=7

enum image_endian : u8 unknown=error
  unset=0 big=1 little=2 native=3

enum image_bit_order : u8 unknown=error
  bit_unset=0 msb_first=1 lsb_first=2

enum image_offset_base : u8 unknown=error
  base_region=0 base_message=1 base_field=2

enum image_check : u8 unknown=error
  must_eq=0 minimum=1 maximum=2 must_be_zero=3 must_be_one=4 enum_known=5 fits_frame=6 terminated=7 arm_selected=8 digits_valid=9 digits_minimal=10 nul_terminated=11 encoded_as=12 pinned_run=14 zero_run=13

struct image size=20
  @0x0000   20        image_header head  little

struct image_arm size=24
  @0x0000   4         u32        placement  little
  @0x0004   4         u32        selected  little
  @0x0008   8         i64        case_value  little
  @0x0010   4         u32        discriminant  little
  @0x0014   1         u8         arm_flags
  @0x0015   3         u8         arm_pad  little

struct image_codec size=4
  @0x0000   4         u32        name  little

struct image_constraint size=16
  @0x0000   4         u32        placement  little
  @0x0004   8         i64        value  little
  @0x000c   1         image_check check
  @0x000d   3         u8         constraint_pad  little

struct image_delimiter size=32
  @0x0000   4         u32        placement  little
  @0x0004   4         u32        quote  little
  @0x0008   4         u32        escape  little
  @0x000c   4         u32        cap  little
  @0x0010   1         u8         length
  @0x0011   15        u8         octets  little

struct image_enum_value size=16
  @0x0000   4         u32        enum_id  little
  @0x0004   8         i64        value  little
  @0x000c   4         u32        enum_pad  little

struct image_header size=20
  @0x0000   4         u8         magic  little
  @0x0004   2         u16        format_version  little must_eq=4
  @0x0006   2         u16        flags  little
  @0x0008   4         u32        image_bytes  little
  @0x000c   4         u32        section_count  little
  @0x0010   4         u32        section_offset  little

struct image_index size=16
  @0x0000   4         u32        placement  little
  @0x0004   4         u32        entry_bits  little
  @0x0008   4         u32        count_code  little
  @0x000c   1         image_offset_base measured_from
  @0x000d   3         u8         index_pad  little

struct image_marker size=16
  @0x0000   4         u32        placement  little
  @0x0004   8         i64        little_value  little
  @0x000c   4         u32        marker_pad  little

struct image_pinned size=32
  @0x0000   4         u32        placement  little
  @0x0004   1         u8         length
  @0x0005   27        u8         octets  little

struct image_placement size=48
  @0x0000   1         image_kind kind
  @0x0001   1         image_endian endian
  @0x0002   1         image_bit_order bit_order
  @0x0003   1         u8         flags
  @0x0004   4         u32        offset_bits  little
  @0x0008   4         u32        size_bits  little
  @0x000c   4         u32        size_max_bits  little
  @0x0010   4         u32        element_bits  little
  @0x0014   4         u32        array_count  little
  @0x0018   4         u32        size_code  little
  @0x001c   4         u32        type_struct  little
  @0x0020   4         u32        located_code  little
  @0x0024   4         u32        repeat_code  little
  @0x0028   1         u8         radix
  @0x0029   1         u8         text_flags
  @0x002a   2         u16        radix_digits  little
  @0x002c   2         u16        since  little
  @0x002e   2         u16        repeat_cap  little

struct image_region size=16
  @0x0000   4         u32        placement  little
  @0x0004   4         u32        owner  little
  @0x0008   4         u32        codec  little
  @0x000c   1         u8         region_flags
  @0x000d   3         u8         region_pad  little

struct image_relation size=24
  @0x0000   4         u32        name  little
  @0x0004   4         u32        request_struct  little
  @0x0008   4         u32        response_struct  little
  @0x000c   4         u32        first_must  little
  @0x0010   4         u32        must_count  little
  @0x0014   4         u32        relation_pad  little

struct image_relation_must size=8
  @0x0000   4         u32        code  little
  @0x0004   4         u32        must_pad  little

struct image_section size=16
  @0x0000   4         image_section_tag kind  little
  @0x0004   4         u32        offset  little
  @0x0008   4         u32        count  little
  @0x000c   4         u32        stride  little

struct image_struct size=16
  @0x0000   4         u32        first_placement  little
  @0x0004   4         u32        placement_count  little
  @0x0008   4         u32        size_bits  little
  @0x000c   4         u32        struct_flags  little

struct image_tlv size=12
  @0x0000   4         u32        placement  little
  @0x0004   4         u32        tag_varint  little
  @0x0008   1         u8         tlv_flags
  @0x0009   1         u8         unknown_policy
  @0x000a   1         u8         duplicate_policy
  @0x000b   1         u8         tlv_pad

struct image_varint size=12
  @0x0000   4         u32        placement  little
  @0x0004   4         u32        encoding  little
  @0x0008   1         u8         max_bytes
  @0x0009   1         u8         terminal_bits
  @0x000a   1         u8         varint_flags
  @0x000b   1         u8         varint_pad

struct image_version size=8
  @0x0000   4         u32        shape  little
  @0x0004   4         u32        placement  little
