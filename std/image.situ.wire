# situ wire signature v0
# schema: image.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.

endian little
target buffer

enum image_kind : u8 unknown=error
  field=0 reserved=1 marker=2 region=3 variant=4 tlv=5 indexed=6 opaque=7

enum image_endian : u8 unknown=error
  unset=0 big=1 little=2 native=3

enum image_bit_order : u8 unknown=error
  bit_unset=0 msb_first=1 lsb_first=2

struct image size=40
  @0x0000   40        image_header head  little
  ~         0..51539607540 image_struct structs  sized-by=head.struct_count
  ~         0..137438953440 image_placement placements  sized-by=head.placement_count
  ~         0..4294967295 u8         code  sized-by=head.code_bytes

struct image_header size=40
  @0x0000   4         u8         magic  little
  @0x0004   2         u16        format_version  little must_eq=1
  @0x0006   2         u16        flags  little
  @0x0008   4         u32        struct_count  little
  @0x000c   4         u32        placement_count  little
  @0x0010   4         u32        code_bytes  little
  @0x0014   4         u32        struct_offset  little
  @0x0018   4         u32        placement_offset  little
  @0x001c   4         u32        code_offset  little
  @0x0020   4         u32        metadata_offset  little
  @0x0024   4         u32        image_bytes  little

struct image_placement size=32
  @0x0000   1         image_kind kind
  @0x0001   1         image_endian endian
  @0x0002   1         image_bit_order bit_order
  @0x0003   1         u8         flags
  @0x0004   4         u32        offset_bits  little
  @0x0008   4         u32        size_bits  little
  @0x000c   4         u32        size_max_bits  little
  @0x0010   4         u32        element_bits  little
  @0x0014   4         u32        array_count  little
  @0x0018   4         u32        size_code  little
  @0x001c   4         u32        type_struct  little

struct image_struct size=12
  @0x0000   4         u32        first_placement  little
  @0x0004   4         u32        placement_count  little
  @0x0008   4         u32        size_bits  little
